0718+  165F CB 7F       BTASC1  BIT   7,A            ;a 1 or a 0?
0719+  1661 20 05               JR    NZ,BTASC3
0720+  1663 0E 30               LD    C,30H          ;it's a zero
0721+  1665 71          BTASC2  LD    (HL),C
0722+  1666 18 03               JR    BTASC4
0723+  1668 0E 31       BTASC3  LD    C,31H          ;it's a one
0724+  166A 71                  LD    (HL),C
0725+  166B 23          BTASC4  INC   HL
0726+  166C 17                  RLA
0727+  166D 10 F0               DJNZ  BTASC1         ;next bit
0728+  166F C1                  POP   BC
0729+  1670 C9                  RET
0730+  1671             ;-----------------------------------------
0731+  1671             ; print an-inline, zero terminated string
0732+  1671             ;-----------------------------------------
0733+  1671             ; put the string in the code like the example below
0734+  1671             ; the routine sends the string from the subroutine return address,to the zero terminator,
0735+  1671             ; then jumps to the next instruction address to resume the program. 
0736+  1671             ;
0737+  1671             ;      CALL ILPSZ
0738+  1671             ;      .DB  "STRING TO PRINT",0
0739+  1671             ;      NEXT INSTRUCTION
0740+  1671             ;
0741+  1671 E1          ILPSZ   POP   HL             ;return address is start of string
0742+  1672 7E          ILPSZ1  LD    A,(HL)         ;get character
0743+  1673 23                  INC   HL             ;point to next character
0744+  1674 B7                  OR    A
0745+  1675 CA 7D 16            JP    Z,ILPSZ2       ;return if char = 0
0746+  1678 CD 21 08            CALL  TXDATA         ;send it
0747+  167B 18 F5               JR    ILPSZ1         ;and do it again
0748+  167D E9          ILPSZ2  JP    (HL)           ;return to address after zero terminator
0749+  167E             ;
0750+  167E             ;DISASSEMBLER
0751+  167E             ;
0752+  167E             #include "DIS-Z80.asm"
0001++ 167E             ; ====================
0002++ 167E             ; DIS-Z80 was published in the SUBSET column of Personal Computer World 1987.
0003++ 167E             ; The routine disassembles a single Z80 instruction at address DE. 
0004++ 167E             ; It is required to be followed by a routine called CHROP that outputs a 
0005++ 167E             ; single ASCII character.
0006++ 167E             ; It was originally developed for CP/M on an Amstrad CPC128.
0007++ 167E             
0008++ 167E             ; The original ORG was $0100. I have added $5000 to all addresses.
0009++ 167E             ; The stated aim was to write a Z80 disassembly routine in as short a space
0010++ 167E             ; as possible and, at just over 1K (1090 bytes), it is a rather incredible 
0011++ 167E             ; program. 
0012++ 167E             
0013++ 167E             ; The SUBSET editor David Barrow was able to trim only one byte from John 
0014++ 167E             ; Kerr's compact code. I've forgotten where so there's a challenge.
0015++ 167E             ; ====================
0016++ 167E             
0017++ 167E             ; STRUCTURAL CONCEPTS
0018++ 167E             ; DATA
0019++ 167E             ;
0020++ 167E             ; Disassembled line:
0021++ 167E             ;		field 1: instruction 1st byte location (5 cols).
0022++ 167E             ;		field 2: instruction bytes (12 cols).
0023++ 167E             ;		field 3: mnemonic (5 cols).
0024++ 167E             ;		field 4: operand(s) (13 cols).
0025++ 167E             ;
0026++ 167E             ; Location address	: ASCII hex (4 digits).
0027++ 167E             ; Instruction bytes	: ASCII hex (2 digits sequence).
0028++ 167E             ; Operand data &	: ASCII hex with appended "H" if >9,
0029++ 167E             ;	addresses		:	and preceeding "0" if 1st digit >9.
0030++ 167E             ; Operand offsets	: signed decimal, linked "+" or "-".
0031++ 167E             
0032++ 167E             ; PROGRAM DETAILS
0033++ 167E             ;
0034++ 167E             ; INPUT				DE addresses 1st byte of instruction to disassemble.
0035++ 167E             ; OUTPUT			35 character disassembled line to output device.
0036++ 167E             ; STATE CHANGES		DE updated to address 1st byte of next instruction.
0037++ 167E             ;					AF BC HL changed.
0038++ 167E             ; I/O ERRORS		None.
0039++ 167E             ; OPTIMISATION		Not given.
0040++ 167E             ; INTERRUPT EFFECT	May be interrupted and re-entered.
0041++ 167E             ; LOCATION NEEDS	Not specific. Not relocatable. PROMable.
0042++ 167E             ;					(Listing in this datasheet is assembled at 0100H)
0043++ 167E             ; PROGRAM BYTES		695: code 206 + referenced tables:-
0044++ 167E             ;						GROUP2 (27), GROUP1 (168), GROUP3 (86),
0045++ 167E             ;						MONICS (208).
0046++ 167E             ; STACK BYTES		46 maximum.
0047++ 167E             ; CLOCK CYCLES		Not given.
0048++ 167E             
0049++ 167E             
0050++ 167E CD A5 1A    DISASM	CALL 	ADRSP		; Output the source pointer.
0051++ 1681             
0052++ 1681 01 00 09           	LD 	BC,$0900		; Create an 18-byte output
0053++ 1684 21 20 20           	LD 	HL,$2020	; buffer in the stack area.
0054++ 1687             FILBUF
0055++ 1687 E5                  PUSH    HL			; Buffer initially contains
0056++ 1688 10 FD               DJNZ    FILBUF		; 18 ASCII spaces (20H).
0057++ 168A             
0058++ 168A 60                 	LD 	H,B				; Copy SP into HL, so the
0059++ 168B 69                 	LD 	L,C				; first byte of the output
0060++ 168C 39                 	ADD 	HL,SP		; buffer is addressed by HL.
0061++ 168D             
0062++ 168D C5                 	PUSH 	BC			; Save original IX and
0063++ 168E DD E3              	EX 	(SP),IX			; initialize to zero.
0064++ 1690 C5                 	PUSH 	BC			; Initialize temp storage
0065++ 1691 C5                 	PUSH 	BC			; (workspace) to all zeros.
0066++ 1692 DD 39              	ADD 	IX,SP		; Point IX to workspace.
0067++ 1694             
0068++ 1694 E5                 	PUSH 	HL			; Save buffer pointer; point
0069++ 1695 21 0F 18           	LD 	HL,GROUP3		; to "ED" instruction group.
0070++ 1698             
0071++ 1698 CD 9A 1A    TRYNDX	CALL 	FETCH		; Fetch a byte of code.
0072++ 169B             
0073++ 169B 41                 	LD 	B,C				; First check whether this
0074++ 169C FE ED              	CP 	$ED				; is an "ED" instruction.
0075++ 169E 28 0A              	JR 	Z,CONFLG		; Yes; clear the index flag.
0076++ 16A0             
0077++ 16A0 04                 	INC 	B			; Ready to set flag to "1"
0078++ 16A1 FE DD              	CP 	$DD				; if the byte is 0DDH (an
0079++ 16A3 28 05              	JR 	Z,CONFLG		; instruction using IX).
0080++ 16A5             
0081++ 16A5 04                 	INC 	B			; Ready to set flag to "2"
0082++ 16A6 FE FD              	CP 	$FD				; if the byte is 0FDH (an
0083++ 16A8 20 08              	JR 	NZ,NOTNDX		; instruction using IY).
0084++ 16AA             
0085++ 16AA DD 70 01    CONFLG	LD 	(IX+1),B		; Condition the index flag.
0086++ 16AD 04                 	INC 	B			; Repeat index tests if the
0087++ 16AE 10 E8              	DJNZ 	TRYNDX		; pre-byte was 0DDH or 0FDH.
0088++ 16B0 18 2A              	JR 	NXBYTE			; Otherwise continue.
0089++ 16B2             
0090++ 16B2 4F          NOTNDX	LD 	C,A				; Save byte; check if index
0091++ 16B3 DD 7E 01           	LD 	A,(IX+1)		; flag was set (Allows any
0092++ 16B6 B7                 	OR 	A				; series of 0DDH and/or OFDH
0093++ 16B7 28 18              	JR 	Z,NODISP		; bytes, as per Zilog spec).
0094++ 16B9             
0095++ 16B9 79                 	LD 	A,C				; If so, check for presence
0096++ 16BA FE CB              	CP 	$CB				; of any displacement.
0097++ 16BC 28 0D              	JR 	Z,GETDIS		; 0CBH needs a displacement.
0098++ 16BE             
0099++ 16BE E6 44              	AND 	$44			; A displacement is required
0100++ 16C0 FE 04              	CP 	4				; if opcode has bit 2 set
0101++ 16C2 28 07              	JR 	Z,GETDIS		; and bit 6 reset.
0102++ 16C4             
0103++ 16C4 79                 	LD 	A,C				; A displacemnet is required
0104++ 16C5 E6 C0              	AND 	$C0			; if opcode has bit 6 set
0105++ 16C7 FE 40              	CP 	$40				; and bit 7 reset.
0106++ 16C9 20 06              	JR 	NZ,NODISP
0107++ 16CB             
0108++ 16CB CD 9A 1A    GETDIS	CALL 	FETCH		; Get displacement if needed
0109++ 16CE DD 77 02           	LD 	(IX+2),A		; and save it in workspace.
0110++ 16D1             
0111++ 16D1 21 67 17    NODISP	LD 	HL,GROUP1		; "Main" instruction gorup.
0112++ 16D4 79                 	LD 	A,C				; Recover opcode & check
0113++ 16D5 FE CB              	CP 	$CB				; for OCBH ("bit" group).
0114++ 16D7 20 07              	JR 	NZ,NEWMSK		; No; start the search.
0115++ 16D9             
0116++ 16D9 21 4C 17           	LD 	HL,GROUP2		; Yes; point to "CB" group.
0117++ 16DC             
0118++ 16DC CD 9A 1A    NXBYTE	CALL 	FETCH		; Fetch the last non-data
0119++ 16DF 4F                 	LD 	C,A				; byte and store it in C.
0120++ 16E0             
0121++ 16E0 7E          NEWMSK	LD 	A,(HL)			; Fetch a mask from table.
0122++ 16E1 B7                 	OR 	A				; Mask value of 0 indicates
0123++ 16E2 28 16              	JR 	Z,TABEND		; end of table; quit search.
0124++ 16E4             
0125++ 16E4 A1                 	AND 	C			; Otherwise mask the opcode
0126++ 16E5 23                 	INC 	HL			; and address the mode byte.
0127++ 16E6             
0128++ 16E6 46          NEWMOD	LD 	B,(HL)			; Fetch the mode byte in B.
0129++ 16E7 23                 	INC 	HL			; Point to the match byte.
0130++ 16E8 04                 	INC 	B			; Test if the mode is 0FFH
0131++ 16E9 28 F5              	JR 	Z,NEWMSK		; and if so, get a new mak.
0132++ 16EB             
0133++ 16EB BE          TRYMAT	CP 	(HL)			; Is the masked opcode
0134++ 16EC 23                 	INC 	HL			; equal to the match byte?
0135++ 16ED 28 07              	JR 	Z,GETNDX		; Stop searching if it is.
0136++ 16EF             
0137++ 16EF CB 7E              	BIT 	7,(HL)		; index byte bit 7 is set if
0138++ 16F1 23                 	INC 	HL			; address mode changes.
0139++ 16F2 28 F7              	JR 	Z,TRYMAT		; No change; try next match.
0140++ 16F4             
0141++ 16F4 18 F0              	JR 	NEWMOD			; Change; get a new mode.
0142++ 16F6             
0143++ 16F6 7E          GETNDX	LD 	A,(HL)			; Matched: fetch mnemonic
0144++ 16F7 E6 7F              	AND 	$7F			; index, mask bit 7, and
0145++ 16F9 05                 	DEC 	B			; restore the mode byte.
0146++ 16FA             
0147++ 16FA E1          TABEND	POP 	HL			; Save the source pointer
0148++ 16FB D5                 	PUSH 	DE			; below the output buffer
0149++ 16FC E5                 	PUSH 	HL			; pointer on stack.
0150++ 16FD             
0151++ 16FD EB                 	EX 	DE,HL			; Point HL to start of the
0152++ 16FE 21 65 18           	LD 	HL,MONICS		; mnemonics table.
0153++ 1701 CD 85 1A           	CALL 	XTRACT		; Copy mnemonic to buffer.
0154++ 1704             
0155++ 1704 E1                 	POP 	HL			; Restore output pointer
0156++ 1705 11 05 00           	LD 	DE,5			; and adjust to align
0157++ 1708 19                 	ADD 	HL,DE		; any operands present.
0158++ 1709 D1                 	POP 	DE			; Restore source pointer.
0159++ 170A             
0160++ 170A 78                 	LD 	A,B				; Test high-order B to see
0161++ 170B E6 F0              	AND 	$F0			; if any "first" operand
0162++ 170D 28 13              	JR 	Z,SECOND		; is present.
0163++ 170F             
0164++ 170F 1F                 	RRA					; Yes; move the operand
0165++ 1710 1F                 	RRA					; index into the lower
0166++ 1711 1F                 	RRA					; half of A.
0167++ 1712 1F                 	RRA					; Then save
0168++ 1713 C5                 	PUSH 	BC			; operand and opcode.
0169++ 1714             
0170++ 1714 47                 	LD 	B,A				; Operand index in B.
0171++ 1715 79                 	LD 	A,C				; Restore opcode to A.
0172++ 1716 CD 35 19           	CALL 	OPRND1		; Process the operand.
0173++ 1719             
0174++ 1719 C1                 	POP 	BC			; Restore the operand byte
0175++ 171A 78                 	LD 	A,B				; and opcode; test
0176++ 171B E6 0F              	AND 	$0F			; low-order B for any
0177++ 171D 28 0B              	JR 	Z,OPDONE		; "second" operand.
0178++ 171F             
0179++ 171F 36 2C              	LD 	(HL),44  		; Opearnd index in B.
0180++ 1721 23                 	INC 	HL			; Restore opcode to A.
0181++ 1722             
0182++ 1722 78          SECOND	LD 	A,B				; Check for the presence
0183++ 1723 E6 0F              	AND 	$0F			; of a "second" operand.
0184++ 1725             
0185++ 1725 47                 	LD 	B,A				; Operand index in B.
0186++ 1726 79                 	LD 	A,C				; Restore opcode to A.
0187++ 1727 C4 3B 19           	CALL 	NZ,OPRND2	; Process any operand.
0188++ 172A             
0189++ 172A 3E 03       OPDONE	LD 	A,3				; Check how many bytes
0190++ 172C DD 96 00           	SUB 	(IX+0)		; have been fetched.
0191++ 172F             
0192++ 172F E1                 	POP 	HL			; Discard workspace.
0193++ 1730 E1                 	POP 	HL
0194++ 1731 DD E1              	POP 	IX			; Restore index register.
0195++ 1733             
0196++ 1733 38 0C              	JR 	C,OUTEXT		; 4 or more bytes fetched.
0197++ 1735             
0198++ 1735 3C                 	INC 	A			; Less than four bytes
0199++ 1736 47                 	LD 	B,A				; fetched; so output
0200++ 1737 80                 	ADD 	A,B			; enough spaces to
0201++ 1738 80                 	ADD 	A,B			; align the mnemonics.
0202++ 1739 47                 	LD 	B,A
0203++ 173A             
0204++ 173A 3E 20       SPACES	LD 	A,$20			; Output spaces
0205++ 173C CD C1 1A           	CALL 	CHROP		; to start of
0206++ 173F 10 F9              	DJNZ 	SPACES		; mnemonic field.
0207++ 1741                    	
0208++ 1741 06 12       OUTEXT	LD 	B,18			; Set buffer byte count.
