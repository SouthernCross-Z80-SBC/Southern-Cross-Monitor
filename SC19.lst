0362   0200             ;------------------------------
0363   0200             ; POWER UP RESET / MANUAL RESET
0364   0200             ;------------------------------
0365   0200                     .ORG    0200H
0366   0200             ;
0367   0200             ; wait for smart socket
0368   0200             ; to recover from power down
0369   0200             ;
0370   0200 3E 55       RESET   LD    A,55H
0371   0202 32 60 3F            LD    (SWATCH),A     ;write to RAM
0372   0205 AF                  XOR   A
0373   0206 D3 84               OUT   (DISPLY),A     ;write nothing to
0374   0208 D3 85               OUT   (SCAN),A       ;on board IO
0375   020A DB 86               IN    A,(KEYBUF)     ;to help debugging
0376   020C 3A 60 3F            LD    A,(SWATCH)     ;read from RAM
0377   020F FE 55               CP    55H            ;is it ready?
0378   0211 C2 00 02            JP    NZ,RESET       ;keep trying
0379   0214             ;
0380   0214             ; load stack pointer
0381   0214             ;
0382   0214 31 00 3E    RESET1  LD    SP,ISTACK      ;initialise monitor stack pointer
0383   0217 ED 56               IM    1              ;set interrupt mode 1 - use the automated interrupt
0384   0219             ;
0385   0219             ; set up restart vectors
0386   0219             ;
0387   0219 21 21 08            LD    HL,TXDATA      ;bit-banged serial transmit
0388   021C 22 51 3F            LD    (RST08),HL
0389   021F 21 4C 08            LD    HL,RXDATA      ;bit-banged serial receive (blocking)
0390   0222 22 53 3F            LD    (RST10),HL
0391   0225 21 74 00            LD    HL,RETURN
0392   0228 22 55 3F            LD    (RST18),HL
0393   022B 22 57 3F            LD    (RST20),HL
0394   022E 22 59 3F            LD    (RST28),HL
0395   0231 21 6B 00            LD    HL,NMIRET
0396   0234 22 5D 3F            LD    (RST66),HL     ;NMI vector
0397   0237 21 09 06            LD    HL,SSTEP       ;single stepper interrupt
0398   023A 22 5B 3F            LD    (RST38),HL     ;INT vector
0399   023D 21 F3 00            LD    HL,STOP
0400   0240 22 61 3F            LD    (SYSERR),HL    ;invalid system call error
0401   0243             ;
0402   0243             ; perform checksum on user RAM
0403   0243             ;
0404   0243 21 00 20            LD    HL,RAMSRT      ;start of user RAM
0405   0246 11 00 3D            LD    DE,RAMEND      ;end of user RAM
0406   0249 CD F1 04            CALL  CHKSUM
0407   024C 32 5F 3F            LD    (RAMSUM),A     ;RAM checksum
0408   024F             ;
0409   024F             ; set up default variables
0410   024F             ;
0411   024F 21 5A 07            LD    HL,FUNLST
0412   0252 22 15 3F            LD    (FUNTBL),HL    ;function key table
0413   0255 2A A0 00            LD    HL,(FN2VEC)    ;Fn Fn default vector
0414   0258 22 2F 3F            LD    (FUNJMP),HL    ;fn fn jump
0415   025B AF                  XOR   A
0416   025C 32 3F 3F            LD    (REGPNT),A     ;init single stepper
0417   025F 32 39 3F            LD    (MODE),A       ;start with speaker on
0418   0262             ;
0419   0262 21 0B 00            LD    HL,B9600       ;default baud rate
0420   0265 CD 07 08            CALL  SERINI         ;initialise the serial port
0421   0268             ;
0422   0268             ; initialise display scan variables
0423   0268             ;
0424   0268 21 00 01            LD    HL,0100H
0425   026B 22 3D 3F            LD    (KEYDEL),HL    ;auto-inc/dec delay
0426   026E 21 00 10            LD    HL,1000H
0427   0271 22 23 3F            LD    (KEYTIM),HL    ;delay time instead of a beep
0428   0274             #IFDEF 74C923
0429   0274 3E 20               LD    A,20H
0430   0276~            #ELSE
0431   0276~                    LD    A,08H
0432   0276             #ENDIF
0433   0276 32 38 3F            LD    (OFTIM),A      ;display off time
0434   0279             
0435   0279 CD DF 05            CALL  BEEP
0436   027C CD DF 05            CALL  BEEP
0437   027F             
0438   027F             ; initialise the 'display on' time
0439   027F             #IFDEF 74C923
0440   027F 3E 08               LD    A,08H
0441   0281~            #ELSE
0442   0281~                    LD    A,10H
0443   0281             #ENDIF
0444   0281 32 37 3F            LD    (ONTIM),A      ;display on time
0445   0284                 
0446   0284 FB                  EI                   ;enable interrupts
0447   0285             ;-----------------
0448   0285             ; SET UP MAIN LOOP
0449   0285             ;-----------------
0450   0285 31 00 3E    MAIN    LD    SP,ISTACK      ;initialise/reset stack
0451   0288 21 00 20            LD    HL,RAMSRT
0452   028B 22 3B 3F            LD    (ADRESS),HL    ;default start address
0453   028E 3A 39 3F            LD    A,(MODE)
0454   0291 F6 80               OR    80H            ;start off in data mode
0455   0293 32 39 3F            LD    (MODE),A
0456   0296             ;
0457   0296             ; scan the displays until a key is pressed
0458   0296             ;
0459   0296 CD A3 03    MAIN1   CALL  UPDATE
0460   0299 CD A0 04    MAIN2   CALL  SKEYIN         ;wait for a key
0461   029C 21 AB 02            LD    HL,MENLST      ;use the menu handler
0462   029F CD CE 04            CALL  MENU           ;routine for each key
0463   02A2 CD A3 03            CALL  UPDATE         ;update buffer and
0464   02A5 CD AD 04            CALL  SKEYRL         ;wait for key release
0465   02A8 C3 99 02            JP    MAIN2
0466   02AB             ;
0467   02AB             ; main menu key table
0468   02AB             ;
0469   02AB 14          MENLST  .DB 20
0470   02AC 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
0470   02B0 04 05 06 07 
0471   02B4 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
0471   02B8 0C 0D 0E 0F 
0472   02BC 10 11 12 13         .DB 10H,11H,12H,13H
0473   02C0 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0473   02C4 E8 02 E8 02 
0474   02C8 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0474   02CC E8 02 E8 02 
0475   02D0 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0475   02D4 E8 02 E8 02 
0476   02D8 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0476   02DC E8 02 E8 02 
0477   02E0 32 07 2D 03         .DW FUNKEY,ADDKEY,INCKEY,DECKEY
0477   02E4 45 03 74 03 
0478   02E8             ;---------------------------------------------------
0479   02E8             ; ENTER HEX KEY AS LEAST SIGNIFICANT ADDRESS OR DATA
0480   02E8             ;---------------------------------------------------
0481   02E8 CD DF 05    HEXKEY  CALL  BEEP
0482   02EB 21 39 3F            LD    HL,MODE
0483   02EE CB 7E               BIT   7,(HL)         ;addr or data mode?
0484   02F0 CA 14 03            JP    Z,HEXKY2       ;in addr mode
0485   02F3             ;
0486   02F3             ; in data mode
0487   02F3             ;
0488   02F3 CB 6E       HEXKY1  BIT   5,(HL)
0489   02F5 28 0D               JR    Z,DATENT
0490   02F7             ;
0491   02F7             ; auto increment the address in data entry mode
0492   02F7             ;
0493   02F7 CB AE               RES   5,(HL)         ;clear the auto increment flag
0494   02F9 CD 06 03            CALL  DATENT1
0495   02FC 2A 3B 3F            LD    HL,(ADRESS)
0496   02FF 23                  INC   HL             ;auto increment the address
0497   0300 22 3B 3F            LD    (ADRESS),HL
0498   0303 C9                  RET
0499   0304             
0500   0304 CB EE       DATENT  SET   5,(HL)         ;set auto increment flag
0501   0306             
0502   0306 2A 3B 3F    DATENT1 LD    HL,(ADRESS)
0503   0309 CB 26               SLA   (HL)           ;from the current
0504   030B CB 26               SLA   (HL)           ;address,move the
0505   030D CB 26               SLA   (HL)           ;lsn to the msn.
0506   030F CB 26               SLA   (HL)           ;put the key in
0507   0311 B6                  OR    (HL)           ;the new data back at
0508   0312 77                  LD    (HL),A         ;the current address
0509   0313 C9                  RET
0510   0314             ;
0511   0314             ; in address mode
0512   0314             ;
0513   0314 2A 3B 3F    HEXKY2  LD    HL,(ADRESS)
0514   0317 CB 25               SLA   L              ;current address
0515   0319 CB 14               RL    H              ;and do a 16 bit
0516   031B CB 25               SLA   L              ;left shift 4 times
0517   031D CB 14               RL    H              ;to make room
0518   031F CB 25               SLA   L              ;for the new key
0519   0321 CB 14               RL    H
0520   0323 CB 25               SLA   L
0521   0325 CB 14               RL    H
0522   0327 B5                  OR    L              ;it in the least
0523   0328 6F                  LD    L,A            ;significant nibble
0524   0329 22 3B 3F            LD    (ADRESS),HL    ;save current address
0525   032C C9                  RET
0526   032D             ;-------------
0527   032D             ; CHANGE MODES
0528   032D             ;-------------
0529   032D CD DF 05    ADDKEY  CALL  BEEP
0530   0330 3A 39 3F            LD    A,(MODE)
0531   0333 EE 80               XOR   80H            ;toggle mode
0532   0335 32 39 3F            LD    (MODE),A
0533   0338 CD 3C 03            CALL  AUTRST         ;reset auto increment mode
0534   033B C9                  RET
0535   033C             ;--------------------------
0536   033C             ; RESET AUTO-INCREMENT MODE
0537   033C             ;--------------------------
0538   033C 3A 39 3F    AUTRST  LD    A,(MODE)
0539   033F CB AF               RES   5,A            ;reset auto-increment mode
0540   0341 32 39 3F            LD    (MODE),A
0541   0344 C9                  RET
0542   0345             ;------------------
0543   0345             ; INCREMENT ADDRESS
0544   0345             ;------------------
0545   0345 CD 3C 03    INCKEY  CALL  AUTRST         ;reset auto-increment mode
0546   0348 CD DF 05            CALL  BEEP
0547   034B 2A 3B 3F    INCKY1  LD    HL,(ADRESS)
0548   034E 23                  INC   HL             ;inc address
0549   034F 22 3B 3F            LD    (ADRESS),HL
0550   0352 CD A3 03            CALL  UPDATE
0551   0355 2A 3D 3F            LD    HL,(KEYDEL)    ;auto repeat delay
0552   0358 CD 55 04    INCKY2  CALL  SCAND
0553   035B CD 95 04            CALL  SCANKEY
0554   035E CB 6F               BIT   5,A            ;return if
0555   0360 28 11               JR    Z,INCKY3       ;key released
0556   0362 E6 1F               AND   1FH            ;strip unused bits
0557   0364 FE 12               CP    KEYINC         ; '+'
0558   0366 20 0B               JR    NZ,INCKY3      ;not '+' key
0559   0368 11 01 00            LD    DE,0001H
0560   036B ED 52               SBC   HL,DE
0561   036D D2 58 03            JP    NC,INCKY2      ;scan display for keydel
0562   0370 C3 4B 03            JP    INCKY1         ;inc address
0563   0373 C9          INCKY3  RET
0564   0374             ;------------------
0565   0374             ; DECREMENT ADDRESS
0566   0374             ;------------------
0567   0374 CD 3C 03    DECKEY  CALL  AUTRST         ;reset auto-increment mode
0568   0377 CD DF 05            CALL  BEEP
0569   037A 2A 3B 3F    DECKY1  LD    HL,(ADRESS)
0570   037D 2B                  DEC   HL             ;dec address
0571   037E 22 3B 3F            LD    (ADRESS),HL
0572   0381 CD A3 03            CALL  UPDATE
0573   0384 2A 3D 3F            LD    HL,(KEYDEL)    ;auto repeat delay
0574   0387 CD 55 04    DECKY2  CALL  SCAND
0575   038A CD 95 04            CALL  SCANKEY
0576   038D CB 6F               BIT   5,A            ;return if
0577   038F 28 11               JR    Z,DECKY3       ;key released
0578   0391 E6 1F               AND   1FH
0579   0393 FE 13               CP    KEYDEC         ; '-'
0580   0395 20 0B               JR    NZ,DECKY3      ;not '-' key
0581   0397 11 01 00            LD    DE,0001H
0582   039A ED 52               SBC   HL,DE
0583   039C D2 87 03            JP    NC,DECKY2      ;scan display for keydel
0584   039F C3 7A 03            JP    DECKY1         ;inc address 
0585   03A2 C9          DECKY3  RET
0586   03A3             ;-----------------------------------------
0587   03A3             ; UPDATE DISPLAY BUFFER TO CURRENT ADDRESS
0588   03A3             ;-----------------------------------------
0589   03A3             ;
0590   03A3             ; update the display buffer with the 
0591   03A3             ; current address, the data at the current address
0592   03A3             ; and set the decimal points to
0593   03A3             ; address or data mode
0594   03A3             ;
0595   03A3             ;   entry : none
0596   03A3             ;   exit :  modifies a
0597   03A3             ;
0598   03A3 E5          UPDATE  PUSH  HL
0599   03A4 C5                  PUSH  BC
0600   03A5 2A 3B 3F            LD    HL,(ADRESS)    ;get address
0601   03A8 CD 07 04            CALL  DISADD         ;and data, put in
0602   03AB 7E                  LD    A,(HL)
0603   03AC CD 1C 04            CALL  DISBYT         ;display buffer
0604   03AF             ;
0605   03AF             ; in address or data mode?
0606   03AF             ;
0607   03AF 21 39 3F            LD    HL,MODE
0608   03B2 CB 7E               BIT   7,(HL)         ;data or addr mode?
0609   03B4 CA CC 03            JP    Z,ADMODE       ;address mode
0610   03B7             ;
0611   03B7             ; show data mode
0612   03B7             ;
0613   03B7 CB 6E               BIT   5,(HL)         ;auto-inc mode?
0614   03B9 CA C4 03            JP    Z,UPDATE1
0615   03BC 21 31 3F            LD    HL,DISBUF
0616   03BF 06 01               LD    B,1            ;turn on one DP for auto-inc
0617   03C1 C3 D1 03            JP    SETDP
0618   03C4             ;
0619   03C4 21 31 3F    UPDATE1 LD    HL,DISBUF      ;set the dp's
0620   03C7 06 02               LD    B,2            ;in the data
0621   03C9 C3 D1 03            JP    SETDP          ;display
0622   03CC             ;
0623   03CC             ; show address mode
0624   03CC             ;
0625   03CC 21 33 3F    ADMODE  LD    HL,DISBUF+2
0626   03CF 06 04               LD    B,4            ;set the dp's in the address display
0627   03D1             ;
0628   03D1             ; set decimal point
0629   03D1             ;
0630   03D1             ; set dp in the byte pointed to by hl
0631   03D1             ;
0632   03D1 CB FE       SETDP   SET   7,(HL)         ;set bit 7 for dp
0633   03D3 23                  INC   HL             ;point to next byte
0634   03D4 10 FB               DJNZ  SETDP          ;more bits to set
0635   03D6 C1                  POP   BC
0636   03D7 E1                  POP   HL
0637   03D8 C9                  RET
0638   03D9             ;-----------------------------------------
0639   03D9             ; RETURN THE BASE ADDRESS OF RAM VARIABLES
0640   03D9             ;-----------------------------------------
0641   03D9             ;
0642   03D9             ;   entry: none
0643   03D9             ;   exit: HL = base address of variables
0644   03D9             ;
0645   03D9 21 00 3F    VARRAM  LD    HL,VARBLS
0646   03DC C9                        RET
0647   03DD             ;-----------
0648   03DD             ; BOARD TYPE
0649   03DD             ;-----------
0650   03DD             ; returns the type of board the monitor is built for
0651   03DD             ; entry = none
0652   03DD             ; exit: hl -> 'SC-1'  acc = 01h
0653   03DD             ;
