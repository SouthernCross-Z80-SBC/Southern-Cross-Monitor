2077   0B51 DD 77 0A            LD    (IX+10),A
2078   0B54 23          CHKKY3  INC   HL             ;point to next
2079   0B55 EB                  EX    DE,HL          ;digit position
2080   0B56 23                  INC   HL             ;and go
2081   0B57 10 EE               DJNZ  CHKKY2         ;check other positions
2082   0B59 C3 78 0B            JP    CHKKY8
2083   0B5C             ;
2084   0B5C             ; check if number is there
2085   0B5C             ;
2086   0B5C C5          CHKKY4  PUSH  BC
2087   0B5D E5                  PUSH  HL
2088   0B5E 06 04               LD    B,4            ;check each digit
2089   0B60 21 00 3F            LD    HL,VARIDX      ;to see if this
2090   0B63 BE          CHKKY5  CP    (HL)           ;number is in
2091   0B64 23                  INC   HL             ;the wrong
2092   0B65 20 0A               JR    NZ,CHKKY6      ;position
2093   0B67 DD 7E 0A            LD    A,(IX+10)      ;and update
2094   0B6A 3C                  INC   A              ;the result
2095   0B6B DD 77 0A            LD    (IX+10),A
2096   0B6E C3 73 0B            JP    CHKKY7
2097   0B71 10 F0       CHKKY6  DJNZ  CHKKY5
2098   0B73 E1          CHKKY7  POP   HL
2099   0B74 C1                  POP   BC
2100   0B75 C3 54 0B            JP    CHKKY3         ;check next digit
2101   0B78             ;
2102   0B78             ; check if correct
2103   0B78             ;
2104   0B78 DD 7E 0A    CHKKY8  LD    A,(IX+10)
2105   0B7B FE 40               CP    40H            ;is it correct?
2106   0B7D CA 9D 0B            JP    Z,CHKKY9       ;yes!
2107   0B80 DD 7E 0A            LD    A,(IX+10)      ;not correct
