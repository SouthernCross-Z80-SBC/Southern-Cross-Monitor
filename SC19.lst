2546   0DF4 ED 6F               RLD                  ;move the new key
2547   0DF6 2B                  DEC HL               ;into the cal buffer
2548   0DF7 ED 6F               RLD
2549   0DF9 2B                  DEC HL
2550   0DFA ED 6F               RLD
2551   0DFC 18 BD               JR  SETCK1
2552   0DFE             ;
2553   0DFE             ; set calendar as mm/dd/yy
2554   0DFE             ;
