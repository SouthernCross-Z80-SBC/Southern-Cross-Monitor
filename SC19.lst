2522   0DD7             ; is it set clock or set calendar?
2523   0DD7             ;
2524   0DD7 DD CB 01 7E         BIT   7,(IX+1)
2525   0DDB 20 0D               JR    NZ,SETCK2
2526   0DDD             ;
2527   0DDD             ; set clock display
2528   0DDD             ;
