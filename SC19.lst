2290   0C6B CA 70 0C            JP    Z,SCOPE6       ;corresponding
2291   0C6E CB F6               SET   6,(HL)         ;mirror image
2292   0C70 CB 56       SCOPE6  BIT   2,(HL)         ;bit in the MSN
2293   0C72 CA 77 0C            JP    Z,SCOPE7       ;if they are.
