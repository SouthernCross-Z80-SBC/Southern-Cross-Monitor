2352   0CC4             ; SCAN 8X8 DISPLAY
2353   0CC4             ;-----------------
2354   0CC4             ; put the 8 RAM locations pointed to
2355   0CC4             ; by HL on the 8x8 display,
2356   0CC4             ; low byte on top row.
2357   0CC4             ; routine period is 500us
2358   0CC4             ; pulse width 15us  gives 3% duty
2359   0CC4             ;
2360   0CC4             ;  entry : HL = address of 8x8 buffer
2361   0CC4             ;   exit : no registers modified
2362   0CC4             ;
2363   0CC4 F5          SKATE   PUSH  AF
2364   0CC5 C5                  PUSH  BC
2365   0CC6 E5                  PUSH  HL             ;save registers
2366   0CC7 0E 80               LD    C,80H
2367   0CC9 7E          SKATE1  LD    A,(HL)
2368   0CCA D3 80               OUT   (IO0),A        ;output X
2369   0CCC 79                  LD    A,C
2370   0CCD D3 82               OUT   (IO2),A        ;output Y
2371   0CCF 06 02               LD    B,02H
