2299   0C81             ;
2300   0C81             ; display the pattern
2301   0C81             ;
2302   0C81 11 01 00            LD    DE,0001H       ;show the pattern
2303   0C84 21 00 02            LD    HL,0200H       ;for a period of time
2304   0C87 E5          SCOPE9  PUSH  HL
