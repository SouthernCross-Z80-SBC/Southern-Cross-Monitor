2477   0D8C CD 25 04            CALL  CONBYT
2478   0D8F 22 35 3F            LD    (DISBUF+4),HL  ;show month (1-12)
2479   0D92 3A 1E 3F            LD    A,(SWREG5)
2480   0D95 CD 25 04            CALL  CONBYT
