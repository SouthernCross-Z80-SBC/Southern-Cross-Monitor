2442   0D4E 3A 1B 3F            LD    A,(SWREG2)
2443   0D51 CD 25 04            CALL  CONBYT
2444   0D54 CB FD               SET   7,L            ;set decimal point
2445   0D56 22 33 3F            LD    (DISBUF+2),HL  ;show minutes (0-59)
2446   0D59 3A 1C 3F            LD    A,(SWREG3)
2447   0D5C CD 25 04            CALL  CONBYT
2448   0D5F CB FD               SET   7,L            ;set decimal point
2449   0D61 22 35 3F            LD    (DISBUF+4),HL  ;show hours (0-23)
2450   0D64 C9                  RET
2451   0D65             ;
2452   0D65             ; calendar display
