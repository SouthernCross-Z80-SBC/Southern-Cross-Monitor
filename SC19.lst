2467   0D78 CD 25 04            CALL  CONBYT
2468   0D7B 22 33 3F            LD    (DISBUF+2),HL  ;show month (1-12)
2469   0D7E 3A 1E 3F            LD    A,(SWREG5)
2470   0D81 CD 25 04            CALL  CONBYT
2471   0D84 22 35 3F            LD    (DISBUF+4),HL  ;show date (1-31)
2472   0D87 18 12               JR    UPDBF4
2473   0D89             ;
2474   0D89             ; mm/dd/yy mode
