2744   0F3C             ;-----------------
2745   0F3C             ; ONE SECOND DELAY
2746   0F3C             ;-----------------
2747   0F3C             ; uses smartwatch to delay for 1 second
2748   0F3C             ; by waiting for seconds register to rollover
2749   0F3C             ;
2750   0F3C             ; first read gets a reference, subsequent reads
2751   0F3C             ; wait until the seconds counter no longer
2752   0F3C             ; reads the same as the reference value,
2753   0F3C             ; then the routine returns
2754   0F3C             ;
2755   0F3C             ; entry : none
2756   0F3C             ; exit : none modified
2757   0F3C             ;
2758   0F3C F5          ONESEC  PUSH  AF
2759   0F3D C5                  PUSH  BC
2760   0F3E CD 52 0E            CALL  RWATCH         ;read watch
2761   0F41 3A 1A 3F            LD    A,(SWREG1)
2762   0F44 47                  LD    B,A            ;save ref count
2763   0F45 CD 52 0E    ONESC1  CALL  RWATCH
2764   0F48 3A 1A 3F            LD    A,(SWREG1)
2765   0F4B B8                  CP    B              ;same as ref?
2766   0F4C CA 45 0F            JP    Z,ONESC1       ;yes, so wait again
2767   0F4F C1                  POP   BC
2768   0F50 F1                  POP   AF
2769   0F51 C9                  RET
