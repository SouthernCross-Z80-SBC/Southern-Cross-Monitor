2351   0CC4             ; SCAN 8X8 DISPLAY
2352   0CC4             ;-----------------
2353   0CC4             ; put the 8 RAM locations pointed to
2354   0CC4             ; by HL on the 8x8 display,
2355   0CC4             ; low byte on top row.
2356   0CC4             ; routine period is 500us
2357   0CC4             ; pulse width 15us  gives 3% duty
2358   0CC4             ;
2359   0CC4             ;  entry : HL = address of 8x8 buffer
2360   0CC4             ;   exit : no registers modified
2361   0CC4             ;
2362   0CC4 F5          SKATE   PUSH  AF
