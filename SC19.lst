2468   0D78 CD 25 04            CALL  CONBYT
2469   0D7B 22 33 3F            LD    (DISBUF+2),HL  ;show month (1-12)
2470   0D7E 3A 1E 3F            LD    A,(SWREG5)
2471   0D81 CD 25 04            CALL  CONBYT
2472   0D84 22 35 3F            LD    (DISBUF+4),HL  ;show date (1-31)
2473   0D87 18 12               JR    UPDBF4
2474   0D89             ;
2475   0D89             ; mm/dd/yy mode
2476   0D89             ;
2477   0D89 3A 1F 3F    UPDBF3  LD    A,(SWREG6)
2478   0D8C CD 25 04            CALL  CONBYT
2479   0D8F 22 35 3F            LD    (DISBUF+4),HL  ;show month (1-12)
2480   0D92 3A 1E 3F            LD    A,(SWREG5)
2481   0D95 CD 25 04            CALL  CONBYT
