2437   0D43             ; time display
2438   0D43             ;
2439   0D43 3A 1A 3F    UPDBF1  LD    A,(SWREG1)
2440   0D46 CD 25 04            CALL  CONBYT
2441   0D49 CB FD               SET   7,L            ;set decimal point
2442   0D4B 22 31 3F            LD    (DISBUF),HL    ;show seconds (0-59)
2443   0D4E 3A 1B 3F            LD    A,(SWREG2)
2444   0D51 CD 25 04            CALL  CONBYT
2445   0D54 CB FD               SET   7,L            ;set decimal point
2446   0D56 22 33 3F            LD    (DISBUF+2),HL  ;show minutes (0-59)
2447   0D59 3A 1C 3F            LD    A,(SWREG3)
2448   0D5C CD 25 04            CALL  CONBYT
2449   0D5F CB FD               SET   7,L            ;set decimal point
2450   0D61 22 35 3F            LD    (DISBUF+4),HL  ;show hours (0-23)
2451   0D64 C9                  RET
2452   0D65             ;
2453   0D65             ; calendar display
2454   0D65             ;
2455   0D65 3A 20 3F    UPDBF2  LD    A,(SWREG7)
2456   0D68 CD 25 04            CALL  CONBYT
2457   0D6B 22 31 3F            LD    (DISBUF),HL    ;show year (0-99)
2458   0D6E             ;
2459   0D6E             ; check mode for dd/mm/yy or mm/dd/yy
2460   0D6E             ;
2461   0D6E 21 17 3F            LD    HL,CALMDE
2462   0D71 CB 7E               BIT   7,(HL)
2463   0D73 20 14               JR    NZ,UPDBF3      ;mm/dd/yy mode
2464   0D75             ;
2465   0D75             ; dd/mm/yy mode
2466   0D75             ;
