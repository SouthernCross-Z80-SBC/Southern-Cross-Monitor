0449   0285             ; SET UP MAIN LOOP
0450   0285             ;-----------------
0451   0285 31 00 3E    MAIN    LD    SP,ISTACK      ;initialise/reset stack
0452   0288 21 00 20            LD    HL,RAMSRT
0453   028B 22 3B 3F            LD    (ADRESS),HL    ;default start address
0454   028E 3A 39 3F            LD    A,(MODE)
0455   0291 F6 80               OR    80H            ;start off in data mode
0456   0293 32 39 3F            LD    (MODE),A
0457   0296             ;
0458   0296             ; scan the displays until a key is pressed
0459   0296             ;
0460   0296 CD A3 03    MAIN1   CALL  UPDATE
0461   0299 CD A0 04    MAIN2   CALL  SKEYIN         ;wait for a key
0462   029C 21 AB 02            LD    HL,MENLST      ;use the menu handler
0463   029F CD CE 04            CALL  MENU           ;routine for each key
0464   02A2 CD A3 03            CALL  UPDATE         ;update buffer and
0465   02A5 CD AD 04            CALL  SKEYRL         ;wait for key release
0466   02A8 C3 99 02            JP    MAIN2
0467   02AB             ;
0468   02AB             ; main menu key table
0469   02AB             ;
0470   02AB 14          MENLST  .DB 20
0471   02AC 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
0471   02B0 04 05 06 07 
0472   02B4 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
0472   02B8 0C 0D 0E 0F 
0473   02BC 10 11 12 13         .DB 10H,11H,12H,13H
0474   02C0 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0474   02C4 E8 02 E8 02 
0475   02C8 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0475   02CC E8 02 E8 02 
0476   02D0 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0476   02D4 E8 02 E8 02 
0477   02D8 E8 02 E8 02         .DW HEXKEY,HEXKEY,HEXKEY,HEXKEY
0477   02DC E8 02 E8 02 
0478   02E0 32 07 2D 03         .DW FUNKEY,ADDKEY,INCKEY,DECKEY
0478   02E4 45 03 74 03 
0479   02E8             ;---------------------------------------------------
0480   02E8             ; ENTER HEX KEY AS LEAST SIGNIFICANT ADDRESS OR DATA
0481   02E8             ;---------------------------------------------------
0482   02E8 CD DF 05    HEXKEY  CALL  BEEP
0483   02EB 21 39 3F            LD    HL,MODE
0484   02EE CB 7E               BIT   7,(HL)         ;addr or data mode?
0485   02F0 CA 14 03            JP    Z,HEXKY2       ;in addr mode
0486   02F3             ;
0487   02F3             ; in data mode
0488   02F3             ;
0489   02F3 CB 6E       HEXKY1  BIT   5,(HL)
0490   02F5 28 0D               JR    Z,DATENT
0491   02F7             ;
0492   02F7             ; auto increment the address in data entry mode
0493   02F7             ;
0494   02F7 CB AE               RES   5,(HL)         ;clear the auto increment flag
0495   02F9 CD 06 03            CALL  DATENT1
0496   02FC 2A 3B 3F            LD    HL,(ADRESS)
0497   02FF 23                  INC   HL             ;auto increment the address
0498   0300 22 3B 3F            LD    (ADRESS),HL
0499   0303 C9                  RET
0500   0304             
0501   0304 CB EE       DATENT  SET   5,(HL)         ;set auto increment flag
0502   0306             
0503   0306 2A 3B 3F    DATENT1 LD    HL,(ADRESS)
0504   0309 CB 26               SLA   (HL)           ;from the current
0505   030B CB 26               SLA   (HL)           ;address,move the
0506   030D CB 26               SLA   (HL)           ;lsn to the msn.
0507   030F CB 26               SLA   (HL)           ;put the key in
0508   0311 B6                  OR    (HL)           ;the new data back at
0509   0312 77                  LD    (HL),A         ;the current address
0510   0313 C9                  RET
0511   0314             ;
0512   0314             ; in address mode
0513   0314             ;
0514   0314 2A 3B 3F    HEXKY2  LD    HL,(ADRESS)
0515   0317 CB 25               SLA   L              ;current address
0516   0319 CB 14               RL    H              ;and do a 16 bit
0517   031B CB 25               SLA   L              ;left shift 4 times
0518   031D CB 14               RL    H              ;to make room
0519   031F CB 25               SLA   L              ;for the new key
0520   0321 CB 14               RL    H
0521   0323 CB 25               SLA   L
0522   0325 CB 14               RL    H
0523   0327 B5                  OR    L              ;it in the least
0524   0328 6F                  LD    L,A            ;significant nibble
0525   0329 22 3B 3F            LD    (ADRESS),HL    ;save current address
0526   032C C9                  RET
0527   032D             ;-------------
0528   032D             ; CHANGE MODES
0529   032D             ;-------------
0530   032D CD DF 05    ADDKEY  CALL  BEEP
0531   0330 3A 39 3F            LD    A,(MODE)
0532   0333 EE 80               XOR   80H            ;toggle mode
0533   0335 32 39 3F            LD    (MODE),A
0534   0338 CD 3C 03            CALL  AUTRST         ;reset auto increment mode
0535   033B C9                  RET
0536   033C             ;--------------------------
0537   033C             ; RESET AUTO-INCREMENT MODE
0538   033C             ;--------------------------
0539   033C 3A 39 3F    AUTRST  LD    A,(MODE)
0540   033F CB AF               RES   5,A            ;reset auto-increment mode
0541   0341 32 39 3F            LD    (MODE),A
0542   0344 C9                  RET
0543   0345             ;------------------
0544   0345             ; INCREMENT ADDRESS
0545   0345             ;------------------
0546   0345 CD 3C 03    INCKEY  CALL  AUTRST         ;reset auto-increment mode
0547   0348 CD DF 05            CALL  BEEP
0548   034B 2A 3B 3F    INCKY1  LD    HL,(ADRESS)
0549   034E 23                  INC   HL             ;inc address
0550   034F 22 3B 3F            LD    (ADRESS),HL
0551   0352 CD A3 03            CALL  UPDATE
0552   0355 2A 3D 3F            LD    HL,(KEYDEL)    ;auto repeat delay
0553   0358 CD 55 04    INCKY2  CALL  SCAND
0554   035B CD 95 04            CALL  SCANKEY
0555   035E CB 6F               BIT   5,A            ;return if
0556   0360 28 11               JR    Z,INCKY3       ;key released
0557   0362 E6 1F               AND   1FH            ;strip unused bits
0558   0364 FE 12               CP    KEYINC         ; '+'
0559   0366 20 0B               JR    NZ,INCKY3      ;not '+' key
0560   0368 11 01 00            LD    DE,0001H
0561   036B ED 52               SBC   HL,DE
0562   036D D2 58 03            JP    NC,INCKY2      ;scan display for keydel
0563   0370 C3 4B 03            JP    INCKY1         ;inc address
0564   0373 C9          INCKY3  RET
0565   0374             ;------------------
0566   0374             ; DECREMENT ADDRESS
0567   0374             ;------------------
0568   0374 CD 3C 03    DECKEY  CALL  AUTRST         ;reset auto-increment mode
0569   0377 CD DF 05            CALL  BEEP
0570   037A 2A 3B 3F    DECKY1  LD    HL,(ADRESS)
0571   037D 2B                  DEC   HL             ;dec address
0572   037E 22 3B 3F            LD    (ADRESS),HL
0573   0381 CD A3 03            CALL  UPDATE
0574   0384 2A 3D 3F            LD    HL,(KEYDEL)    ;auto repeat delay
0575   0387 CD 55 04    DECKY2  CALL  SCAND
0576   038A CD 95 04            CALL  SCANKEY
0577   038D CB 6F               BIT   5,A            ;return if
0578   038F 28 11               JR    Z,DECKY3       ;key released
0579   0391 E6 1F               AND   1FH
0580   0393 FE 13               CP    KEYDEC         ; '-'
0581   0395 20 0B               JR    NZ,DECKY3      ;not '-' key
0582   0397 11 01 00            LD    DE,0001H
0583   039A ED 52               SBC   HL,DE
0584   039C D2 87 03            JP    NC,DECKY2      ;scan display for keydel
0585   039F C3 7A 03            JP    DECKY1         ;inc address 
0586   03A2 C9          DECKY3  RET
0587   03A3             ;-----------------------------------------
0588   03A3             ; UPDATE DISPLAY BUFFER TO CURRENT ADDRESS
0589   03A3             ;-----------------------------------------
0590   03A3             ;
0591   03A3             ; update the display buffer with the 
0592   03A3             ; current address, the data at the current address
0593   03A3             ; and set the decimal points to
0594   03A3             ; address or data mode
0595   03A3             ;
0596   03A3             ;   entry : none
0597   03A3             ;   exit :  modifies a
0598   03A3             ;
0599   03A3 E5          UPDATE  PUSH  HL
0600   03A4 C5                  PUSH  BC
0601   03A5 2A 3B 3F            LD    HL,(ADRESS)    ;get address
0602   03A8 CD 07 04            CALL  DISADD         ;and data, put in
0603   03AB 7E                  LD    A,(HL)
0604   03AC CD 1C 04            CALL  DISBYT         ;display buffer
0605   03AF             ;
0606   03AF             ; in address or data mode?
0607   03AF             ;
0608   03AF 21 39 3F            LD    HL,MODE
0609   03B2 CB 7E               BIT   7,(HL)         ;data or addr mode?
0610   03B4 CA CC 03            JP    Z,ADMODE       ;address mode
0611   03B7             ;
0612   03B7             ; show data mode
0613   03B7             ;
0614   03B7 CB 6E               BIT   5,(HL)         ;auto-inc mode?
0615   03B9 CA C4 03            JP    Z,UPDATE1
0616   03BC 21 31 3F            LD    HL,DISBUF
0617   03BF 06 01               LD    B,1            ;turn on one DP for auto-inc
0618   03C1 C3 D1 03            JP    SETDP
0619   03C4             ;
0620   03C4 21 31 3F    UPDATE1 LD    HL,DISBUF      ;set the dp's
0621   03C7 06 02               LD    B,2            ;in the data
0622   03C9 C3 D1 03            JP    SETDP          ;display
0623   03CC             ;
0624   03CC             ; show address mode
0625   03CC             ;
0626   03CC 21 33 3F    ADMODE  LD    HL,DISBUF+2
0627   03CF 06 04               LD    B,4            ;set the dp's in the address display
0628   03D1             ;
0629   03D1             ; set decimal point
0630   03D1             ;
0631   03D1             ; set dp in the byte pointed to by hl
0632   03D1             ;
0633   03D1 CB FE       SETDP   SET   7,(HL)         ;set bit 7 for dp
0634   03D3 23                  INC   HL             ;point to next byte
0635   03D4 10 FB               DJNZ  SETDP          ;more bits to set
0636   03D6 C1                  POP   BC
0637   03D7 E1                  POP   HL
0638   03D8 C9                  RET
0639   03D9             ;-----------------------------------------
0640   03D9             ; RETURN THE BASE ADDRESS OF RAM VARIABLES
0641   03D9             ;-----------------------------------------
0642   03D9             ;
0643   03D9             ;   entry: none
0644   03D9             ;   exit: HL = base address of variables
0645   03D9             ;
0646   03D9 21 00 3F    VARRAM  LD    HL,VARBLS
0647   03DC C9                        RET
0648   03DD             ;-----------
0649   03DD             ; BOARD TYPE
0650   03DD             ;-----------
0651   03DD             ; returns the type of board the monitor is built for
0652   03DD             ; entry = none
0653   03DD             ; exit: hl -> 'SC-1'  acc = 01h
0654   03DD             ;
0655   03DD 21 F2 03    PCBTYP  LD    HL,TYPESZ
0656   03E0 3A F7 03            LD    A,(TYPEBF)
0657   03E3 C9                  RET
0658   03E4             ;---------------
0659   03E4             ; VERSION NUMBER
0660   03E4             ;---------------
0661   03E4             ;returns the software version number
0662   03E4             ;
0663   03E4             ;   entry : none
0664   03E4             ; exit : hl -> version number string
0665   03E4             ;        acc = bcd version number d7-d4 = major, d3-d0 minor
0666   03E4             ;
0667   03E4 21 F8 03    VERS    LD    HL,VERSZ
0668   03E7 3A FC 03            LD    A,(VERBCD)
0669   03EA C9                  RET
0670   03EB             ;--------------
0671   03EB             ; KEYBOARD TYPE
0672   03EB             ;--------------
0673   03EB             ; returns the type of keyboard used
0674   03EB             ; entry = none
0675   03EB             ; exit: hl -> keyboard type string
0676   03EB             ;       acc = 01h mm74c923 hardware encoder
0677   03EB             ;       acc = 02h software scanned
0678   03EB             ;
0679   03EB 21 FD 03    KBDTYP  LD    HL,KYBSZ
0680   03EE 3A 06 04            LD    A,(KYBDBF)
0681   03F1 C9                  RET
0682   03F2             
0683   03F2 53 43 2D 31 TYPESZ  .DB   "SC-1",0
0683   03F6 00 
0684   03F7 01          TYPEBF  .DB   01H
0685   03F8             
0686   03F8 31 2E 39 00 VERSZ   .DB   "1.9",0
0687   03FC 19          VERBCD  .DB   19H
0688   03FD             
0689   03FD             #IFDEF 74C923
0690   03FD 48 61 72 64 KYBSZ   .DB   "Hardware",0
0690   0401 77 61 72 65 
0690   0405 00 
0691   0406 01          KYBDBF  .DB   01H 
0692   0407~            #ELSE
0693   0407~            KYBSZ   .DB   "Software",0
0694   0407~            KYBDBF  .DB   02H 
0695   0407             #ENDIF
0696   0407             
0697   0407             ;-------------------------
0698   0407             ; ADDRESS > DISPLAY BUFFER
0699   0407             ;-------------------------
0700   0407             ; convert HL to seven segment code
0701   0407             ; and put in address display buffer.
0702   0407             ;
0703   0407             ; entry : HL = address to be displayed
0704   0407             ;
0705   0407             ; exit  : no registers modified
0706   0407             ;
0707   0407 F5          DISADD  PUSH  AF
0708   0408 E5                  PUSH  HL
0709   0409 E5                  PUSH  HL
0710   040A 7C                  LD    A,H
0711   040B CD 25 04            CALL  CONBYT
0712   040E 22 35 3F            LD    (DISBUF+4),HL
0713   0411 E1                  POP   HL
0714   0412 7D                  LD    A,L
0715   0413 CD 25 04            CALL  CONBYT
0716   0416 22 33 3F            LD    (DISBUF+2),HL
0717   0419 E1                  POP   HL
0718   041A F1                  POP   AF
0719   041B C9                  RET
0720   041C             ;---------------------------
0721   041C             ; DATA BYTE > DISPLAY BUFFER
0722   041C             ;---------------------------
0723   041C             ; convert the acc to seven segment code
0724   041C             ; and put in data display buffer.
0725   041C             ;
0726   041C             ; entry :  a = data display byte
0727   041C             ;
0728   041C             ; exit  : no registers modified
0729   041C             ;
0730   041C E5          DISBYT  PUSH  HL
0731   041D CD 25 04            CALL  CONBYT
0732   0420 22 31 3F            LD    (DISBUF),HL
0733   0423 E1                  POP   HL
0734   0424 C9                  RET
0735   0425             ;---------------------------------------
0736   0425             ; CONVERT BYTE TO 7 SEGMENT DISPLAY CODE
0737   0425             ;---------------------------------------
0738   0425             ; converts byte in acc to seven segment code
0739   0425             ; for display
0740   0425             ; entry : a = byte to be converted
0741   0425             ; exit  : h = hi nibble seven segment code
0742   0425             ;         l = lo nibble seven segment code
0743   0425             ;         a = not modified
0744   0425 F5          CONBYT  PUSH  AF
0745   0426 F5                  PUSH  AF
0746   0427 CD 32 04            CALL  CONVHI         ;convert hi nibble
0747   042A 67                  LD    H,A
0748   042B F1                  POP   AF
0749   042C CD 36 04            CALL  CONVLO         ;convert lo nibble
0750   042F 6F                  LD    L,A
0751   0430 F1                  POP   AF
0752   0431 C9                  RET
0753   0432             ;---------------------------------------------
0754   0432             ; HEXADECIMAL TO SEVEN SEGMENT CODE CONVERSION
0755   0432             ;---------------------------------------------
0756   0432             ; converts nibble in acc to seven segment code
0757   0432             ; for seven segment displays
0758   0432             ; convhi = converts high nibble
0759   0432             ; convlo = converts lo nibble
0760   0432             ;
0761   0432             ; entry : a = nibble to be converted
0762   0432             ; exit  : a = seven segment code
0763   0432             ;
0764   0432 07          CONVHI  RLCA
0765   0433 07                  RLCA
0766   0434 07                  RLCA                 ;move to lo nibble
0767   0435 07                  RLCA                 ;for conversion
0768   0436 C5          CONVLO  PUSH  BC
0769   0437 E5                  PUSH  HL
0770   0438 21 45 04            LD    HL,SEGMNT      ;use the hex value
0771   043B E6 0F               AND   0FH            ;to index to the
0772   043D 4F                  LD    C,A            ;the seven segment
0773   043E 06 00               LD    B,00H          ;code for that value
0774   0440 09                  ADD   HL,BC          ;and return with
0775   0441 7E                  LD    A,(HL)         ;code in a
0776   0442 E1                  POP   HL
0777   0443 C1                  POP   BC
0778   0444 C9                  RET
0779   0445             ;
0780   0445             ; hexadecimal to 7 segment display code table
0781   0445             ;
0782   0445 3F 06 5B 4F SEGMNT  .DB 3FH,06H,5BH,4FH ;0,1,2,3
0783   0449 66 6D 7D 07         .DB 66H,6DH,7DH,07H ;4,5,6,7
0784   044D 7F 6F 77 7C         .DB 7FH,6FH,77H,7CH ;8,9,A,B
0785   0451 39 5E 79 71         .DB 39H,5EH,79H,71H ;C,D,E,F
0786   0455             ;-------------
0787   0455             ; SCAN DISPLAY
0788   0455             ;-------------
0789   0455             ; as the displays are multiplexed, the data for each
0790   0455             ; display must be latched into the display segment
0791   0455             ; latch in turn and the corresponding bit in the display
0792   0455             ; scan latch turned on to display the data.
0793   0455             ; two short delays are used to adjust the duty
0794   0455             ; cycle and hence display brightness.
0795   0455             ;
0796   0455             ; the serial output is on D6 so it must be kept high! 
0797   0455             ;
0798   0455             ; entry : none
0799   0455             ; exit  : no registers modified
0800   0455             ;
0801   0455 F5          SCAND   PUSH  AF
0802   0456 C5                  PUSH  BC
0803   0457 E5                  PUSH  HL             ;save registers
0804   0458 21 36 3F            LD    HL,DISBUF+5
0805   045B 0E 20               LD    C,20H
0806   045D 7E          SCAND1  LD    A,(HL)
0807   045E D3 84               OUT   (DISPLY),A     ;output character
0808   0460 79                  LD    A,C
0809   0461 F6 40               OR    40H            ;keep D6 high
0810   0463 D3 85               OUT   (SCAN),A       ;turn on display
0811   0465 3A 37 3F            LD    A,(ONTIM)      ;do a short delay
0812   0468 47                  LD    B,A            ;to adjust on time
0813   0469 10 FE       SCAND2  DJNZ  SCAND2         ;of display
0814   046B 78                  LD    A,B            ;b is now clear,
0815   046C F6 40               OR    40H            ;keep D6 high
0816   046E D3 85               OUT   (SCAN),A       ;use it to turn off scan.
0817   0470 3A 38 3F            LD    A,(OFTIM)      ;do a short delay
0818   0473 47                  LD    B,A            ;to adjust off time
0819   0474 10 FE       SCAND3  DJNZ  SCAND3         ;of display
0820   0476 2B                  DEC   HL             ;point to next
0821   0477 CB 09               RRC   C              ;element in buffer
0822   0479 30 E2               JR    NC,SCAND1      ;display next element
0823   047B 78                  LD    A,B            ;b is now clear,
0824   047C D3 84               OUT   (DISPLY),A     ;and clear display latch
0825   047E F6 40               OR    40H            ;keep D6 high
0826   0480 D3 85               OUT   (SCAN),A       ;use it to turn off scan
0827   0482 E1                  POP   HL
0828   0483 C1                  POP   BC
0829   0484 F1                  POP   AF             ;restore registers
0830   0485 C9                  RET
0831   0486             ;---------------------
0832   0486             ; CLEAR DISPLAY BUFFER
0833   0486             ;---------------------
0834   0486 E5          CLRBUF  PUSH  HL
0835   0487 C5                  PUSH  BC
0836   0488 21 31 3F            LD    HL,DISBUF
0837   048B 06 06               LD    B,6
0838   048D 36 00       CLRBF1  LD    (HL),00H       ;put zero in 6
0839   048F 23                  INC   HL             ;locations pointed
0840   0490 10 FB               DJNZ  CLRBF1         ;to by HL
0841   0492 C1                  POP   BC
0842   0493 E1                  POP   HL
0843   0494 C9                  RET
0844   0495             ;--------------
0845   0495             ; SCAN KEYBOARD
0846   0495             ;--------------
0847   0495             ; use the hardware or software scanned keyboard
0848   0495             ;
0849   0495             ; software scanned keyboard
0850   0495             ; uses display scan drivers for columns
0851   0495             ; and keyboard buffer as rows.
0852   0495             ; make each data line high in turn and check
0853   0495             ; if each individual pushbutton is pressed.
0854   0495             ;
0855   0495             ; entry : none
0856   0495             ; exit  : a = 00h if no key detected
0857   0495             ;         a = detected key bits 0-4
0858   0495             ;             bit 5 = HIGH key available
0859   0495             ; 
0860   0495             ; Bit 6 of the keyboard buffer is the serial input
0861   0495             ;
0862   0495 C5          SCANKEY PUSH  BC
0863   0496 D5                  PUSH  DE             ;save registers
0864   0497 E5                  PUSH  HL
0865   0498             ;
0866   0498             #IFDEF 74C923
0867   0498             ;
0868   0498             ;74c923 keyboard encoder
0869   0498             ;
0870   0498 DB 86              IN  A,(KEYBUF)        ;read hardware encoder
0871   049A E6 3F              AND 3FH               ;strip unused bits
0872   049C E1                 POP HL
0873   049D D1                 POP DE
0874   049E C1                 POP BC
0875   049F C9                 RET
0876   04A0~            #ELSE
0877   04A0~            ;
0878   04A0~            ; software scan keyboard 
0879   04A0~            ;
0880   04A0~            SCANKY1 XOR   A
0881   04A0~                    OUT   (DISPLY),A     ;clear display latch
0882   04A0~                    LD    B,A            ;key
0883   04A0~                    LD    D,A            ;count
0884   04A0~                    LD    E,01H          ;mask
0885   04A0~            SCANKY2 LD    C,08H          ;scan
0886   04A0~            SCANKY3 LD    A,C
0887   04A0~                    OR    40H            ;keep serial output bit high
0888   04A0~                    OUT   (SCAN),A       ;output scan
0889   04A0~                    NOP
0890   04A0~                    NOP
0891   04A0~                    NOP
0892   04A0~                    IN    A,(KEYBUF)     ;read key buffer
0893   04A0~                    AND   E              ;mask 
0894   04A0~                    JR    Z,SCANKY4      ;key not detected
0895   04A0~                    INC   D
0896   04A0~                    LD    L,B            ;save key
0897   04A0~            ;
0898   04A0~            ; end of rows?
0899   04A0~            ;
0900   04A0~            SCANKY4 INC   B              ;next key
0901   04A0~                    SRA   C              ;shift scan right
0902   04A0~                    JR    NC,SCANKY3     ;next row
0903   04A0~            ;
0904   04A0~            ; end of columns?
0905   04A0~            ;
0906   04A0~                    SLA   E              ;shift mask left
0907   04A0~                    BIT   5,E            ;end of keyscan?
0908   04A0~                    JR    Z,SCANKY2      ;next column
0909   04A0~            ;
0910   04A0~            ; end of scan
0911   04A0~            ;
0912   04A0~                    LD    A,D
0913   04A0~                    CP    00H
0914   04A0~                    JR    Z,SCANKY6      ;no key pressed
0915   04A0~                    CP    01H
0916   04A0~                    JR    NZ,SCANKY1     ;more than one key pressed
0917   04A0~            ;
0918   04A0~            ; one key detected
0919   04A0~            ;
0920   04A0~                    LD    A,40H          ;keep serial data out bit high
0921   04A0~                    OUT   (SCAN),A       ;clear scan reg
0922   04A0~                    LD    A,L            ;return key in ACC
0923   04A0~                    SET   5,A            ;set data available flag
0924   04A0~                    JR    SCANKY7
0925   04A0~            ;
0926   04A0~            ; no key
0927   04A0~            ;
0928   04A0~            SCANKY6 LD    A,40H          ;keep serial data out bit high
0929   04A0~                    OUT   (SCAN),A       ;clear scan reg
0930   04A0~                    XOR   A              ;clear ACC
0931   04A0~            SCANKY7 POP   HL
0932   04A0~                    POP   DE
0933   04A0~                    POP   BC
0934   04A0~                    RET
0935   04A0             #ENDIF
0936   04A0             ;-----------------------------
0937   04A0             ; SCAN DISPLAY UNTIL KEY PRESS
0938   04A0             ;-----------------------------
0939   04A0             ; entry : none
0940   04A0             ; exit  : a = key value 00h to 1fh
0941   04A0             ;         flag register modified
0942   04A0             ;
0943   04A0 CD 55 04    SKEYIN  CALL  SCAND          ;scan display
0944   04A3 CD 95 04            CALL  SCANKEY
0945   04A6 CB 6F               BIT   5,A
0946   04A8 28 F6               JR    Z,SKEYIN       ;no key press
0947   04AA E6 1F               AND   1FH            ;strip unused bits
0948   04AC C9                  RET
0949   04AD             ;-------------------------------
0950   04AD             ; SCAN DISPLAY UNTIL KEY RELEASE
0951   04AD             ;-------------------------------
0952   04AD             ; entry : none
0953   04AD             ; exit  : none
0954   04AD             ;
0955   04AD F5          SKEYRL  PUSH  AF
0956   04AE CD 55 04    SKEYL1  CALL  SCAND          ;scan display
0957   04B1 CD 95 04            CALL  SCANKEY
0958   04B4 CB 6F               BIT   5,A
0959   04B6 20 F6               JR    NZ,SKEYL1      ;key not released
0960   04B8 F1                  POP   AF
0961   04B9 C9                  RET
0962   04BA             ;-------------------
0963   04BA             ; WAIT FOR KEY PRESS
0964   04BA             ;-------------------
0965   04BA             ; entry : none
0966   04BA             ; exit  : a = key value 00h to 1fh
0967   04BA             ;         flag register modified
0968   04BA             ;
0969   04BA CD 95 04    KEYIN   CALL  SCANKEY
0970   04BD CB 6F               BIT   5,A
0971   04BF 28 F9               JR    Z,KEYIN        ;no key press
0972   04C1 E6 1F               AND   1FH            ;strip unused bits
0973   04C3 C9                  RET
0974   04C4             ;---------------------
0975   04C4             ; WAIT FOR KEY RELEASE
0976   04C4             ;---------------------
0977   04C4             ; entry : none
0978   04C4             ; exit  : none
0979   04C4             ;
0980   04C4 F5          KEYREL  PUSH  AF
0981   04C5 CD 95 04    KEYRL1  CALL  SCANKEY
0982   04C8 CB 6F               BIT   5,A
0983   04CA 20 F9               JR    NZ,KEYRL1
0984   04CC F1                  POP   AF
0985   04CD C9                  RET
0986   04CE             ;-----------------
0987   04CE             ; KEY MENU HANDLER
0988   04CE             ;-----------------
0989   04CE             ; compares acc against table of elements,
0990   04CE             ; if found jump to address corresponding to
0991   04CE             ; that element, returns if element not found.
0992   04CE             ; entry :  ACC = element to look for
0993   04CE             ;           HL = points to table
0994   04CE             ; exit  : element not found
0995   04CE             ;           HL holds address of last element
0996   04CE             ;         element found
0997   04CE             ;           control passes to jump address with
0998   04CE             ;           return address of menu call on stack
0999   04CE             ;
1000   04CE F5          MENU    PUSH  AF
1001   04CF C5                  PUSH  BC
1002   04D0 D5                  PUSH  DE             ;save registers
1003   04D1 E5                  PUSH  HL             ;calculate address
1004   04D2 16 00               LD    D,00H          ;of the jump table by
1005   04D4 5E                  LD    E,(HL)         ;adding the index to
1006   04D5 23                  INC   HL             ;the elements
1007   04D6 19                  ADD   HL,DE          ;to the addr of the
1008   04D7 54                  LD    D,H            ;table
1009   04D8 5D                  LD    E,L
1010   04D9 E1                  POP   HL
1011   04DA 46                  LD    B,(HL)         ;get number of entries
1012   04DB 23                  INC   HL             ;point to list of entries
1013   04DC BE          MENU1   CP    (HL)           ;compare with entry
1014   04DD 28 09               JR    Z,MENU2        ;found value in table
1015   04DF 23                  INC   HL             ;next entry in list
1016   04E0 13                  INC   DE             ;next entry in
1017   04E1 13                  INC   DE             ;jump table
1018   04E2 10 F8               DJNZ  MENU1          ;check more entries
1019   04E4 D1                  POP   DE
1020   04E5 C1                  POP   BC
1021   04E6 F1                  POP   AF
1022   04E7 C9                  RET                  ;not in table
1023   04E8             ;
1024   04E8             ; found element in the table
1025   04E8             ; pass control to the jump handler
1026   04E8             ;
1027   04E8 1A          MENU2   LD    A,(DE)         ;get the jump addr
1028   04E9 6F                  LD    L,A            ;from the table
1029   04EA 13                  inc   de             ;and jump to
1030   04EB 1A                  LD    A,(DE)         ;the jump address
1031   04EC 67                  LD    H,A            ;for that entry
1032   04ED D1                  POP   DE
1033   04EE C1                  POP   BC
1034   04EF F1                  POP   AF             ;restore registers
1035   04F0 E9                  JP    (HL)
1036   04F1             ;-------------------
1037   04F1             ; CALCULATE CHECKSUM
1038   04F1             ;-------------------
1039   04F1             ; calculates checksum between start and end (inclusive)
1040   04F1             ;
1041   04F1             ; entry : HL = start of block to sum
1042   04F1             ;         DE = end of block to sum
1043   04F1             ; exit  : ACC =  checksum
1044   04F1             ;         flag register modified
1045   04F1             ;
1046   04F1 E5          CHKSUM  PUSH  HL
1047   04F2 D5                  PUSH  DE
1048   04F3 13                  INC   DE             ;end of block+1
1049   04F4 AF                  XOR   A              ;clear checksum
1050   04F5 86          CHKSM1  ADD   A,(HL)         ;compute checksum
1051   04F6 23                  INC   HL             ;point to next element
1052   04F7 A7                  AND   A              ;set carry
1053   04F8 E5                  PUSH  HL
1054   04F9 ED 52               SBC   HL,DE          ;subtract
1055   04FB E1                  POP   HL
1056   04FC 38 F7               JR    C,CHKSM1       ;more elements
1057   04FE D1                  POP   DE
1058   04FF E1                  POP   HL
1059   0500 C9                  RET
1060   0501             ;--------------------------
1061   0501             ; ACCESS BYTE LOOK UP TABLE
1062   0501             ;--------------------------
1063   0501             ; use 8 bit index to access byte look
1064   0501             ; up table
1065   0501             ; entry :  ACC = number of element in table
1066   0501             ;           HL = address of look up table
1067   0501             ; exit :    HL = address of element number in ACC
1068   0501             ;
1069   0501 D5          INDEXB  PUSH  DE
1070   0502 5F                  LD    E,A            ;use de as index
1071   0503 16 00               LD    D,0            ;to element in table
1072   0505 19                  ADD   HL,DE          ;by adding to hl
1073   0506 D1                  POP   DE
1074   0507 C9                  RET
1075   0508             ;--------------------------
1076   0508             ; ACCESS WORD LOOK UP TABLE
1077   0508             ;--------------------------
1078   0508             ; use 8 bit index to access word look
1079   0508             ; up table
1080   0508             ; entry :  ACC = number of element in table
1081   0508             ;           HL = address of look up table
1082   0508             ; exit :    HL = address of 2 byte element number in ACC
1083   0508             ;
1084   0508 D5          INDEXW  PUSH  DE
1085   0509 5F                  LD    E,A
1086   050A CB 23               SLA   E              ;multiply by two
1087   050C 16 00               ld    d,0
1088   050E 19                  ADD   HL,DE
1089   050F D1                  POP   DE
1090   0510 C9                  RET
1091   0511             ;-------------------------------
1092   0511             ; GENERATE A QUASI-RANDOM NUMBER
1093   0511             ;-------------------------------
1094   0511             ; generate an 16 bit random number
1095   0511             ; using linear congruential method.
1096   0511             ;
1097   0511             ;     Rn+1 = (aRn+c) MOD m
1098   0511             ;
1099   0511             ; refresh register used for Rn and c
1100   0511             ;   entry : none
1101   0511             ;   exit  : HL = random word
1102   0511             ;   no registers modified
1103   0511             ;
1104   0511 F5          RAND    PUSH  AF
1105   0512 C5                  PUSH  BC
1106   0513 D5                  PUSH  DE             ;save registers
1107   0514             ;
1108   0514             ; calculate aRn
1109   0514             ;
1110   0514 ED 5F               LD    A,R            ;get a random seed from the refresh register
1111   0516 5F                  LD    E,A            ;multiply random number
1112   0517 16 00               LD    D,0            ;(rn) by
1113   0519 21 48 05            LD    HL,0548H       ;constant (a)
1114   051C CD 29 05            CALL  MUL16
1115   051F             ;
1116   051F             ; calculate aRn+c
1117   051F             ;
1118   051F ED 5F               LD    A,R            ;add it to another
1119   0521 06 00               LD    B,0            ;read of the
1120   0523 4F                  LD    C,A            ;the refresh
1121   0524 09                  ADD   HL,BC          ;register (c)
1122   0525 D1                  POP   DE
1123   0526 C1                  POP   BC
1124   0527 F1                  POP   AF             ;restore registers
1125   0528 C9                  RET
1126   0529             ;----------------------
1127   0529             ; 16 BIT MULTIPLICATION
1128   0529             ;----------------------
1129   0529             ; 16 bit multiply
1130   0529             ;  entry : HL = multiplicand (mpd)
1131   0529             ;          DE = multiplier (mpr)
1132   0529             ;  exit  : HL = result
1133   0529             ; from Zaks 'Programming the Z80'
1134   0529             ;
1135   0529 F5          MUL16   PUSH  AF
1136   052A C5                  PUSH  BC
1137   052B 4C                  LD    C,H            ;mpr(H)
1138   052C 7D                  LD    A,L            ;mpr(L)
1139   052D 06 10               LD    B,16           ;bit counter
1140   052F 21 00 00            LD    HL,0           ;clear result
1141   0532 CB 39       MULT    SRL   C              ;mpr (H)
1142   0534 1F                  RRA                  ;mpr (L)
1143   0535 30 01               JR    NC,MULT1       ;test carry
1144   0537 19                  ADD   HL,DE          ;add mpd to result
1145   0538 EB          MULT1   EX    DE,HL
1146   0539 29                  ADD   HL,HL          ;double -shift mpd left
1147   053A EB                  EX    DE,HL
1148   053B 10 F5               DJNZ  MULT           ;done?
1149   053D C1                  POP   BC
1150   053E F1                  POP   AF
1151   053F C9                  RET
1152   0540             ; music routine
1153   0540             ; adapted from talking electronics TEC-1
1154   0540             ; monitor MON-1
1155   0540             ; by John Hardy and Ken Stone
1156   0540             ;
1157   0540             ;----------------
1158   0540             ; MUSIC SEQUENCER
1159   0540             ;----------------
1160   0540             ; sequences through a table of notes
1161   0540             ; 1EH = repeat tune until reset
1162   0540             ; 1FH = play once and return
1163   0540             ;  entry : HL = address of note table
1164   0540             ;  exit : no registers modified
1165   0540 F5          MUSIC   PUSH  AF
1166   0541 C5                  PUSH  BC
1167   0542 D5                  PUSH  DE
1168   0543 E5                  PUSH  HL             ;save registers
1169   0544 E5                  PUSH  HL
1170   0545 EB                  EX    DE,HL          ;get address of music
1171   0546             ;
1172   0546             ; play each note in turn
1173   0546             ;
1174   0546 1A          STEP    LD    A,(DE)         ;get element from table
1175   0547 E6 1F               AND   1FH            ;strip unused bits
1176   0549             ;
1177   0549             ; if element is 00h pause for a while
1178   0549             ;
1179   0549 FE 00               CP    00H
1180   054B C2 5B 05            JP    NZ,STEP1
1181   054E 01 00 10            LD    BC,1000H
1182   0551 0B          PAUSE   DEC   BC
1183   0552 78                  LD    A,B
1184   0553 B1                  OR    C
1185   0554 C2 51 05            JP    NZ,PAUSE       ;loop until DE = 0
1186   0557 13                  INC   DE             ;point to next element
1187   0558 C3 46 05            JP    STEP
1188   055B             ;
1189   055B             ; if element is 1EH repeat tune
1190   055B             ;
1191   055B FE 1E       STEP1   CP    1EH
1192   055D C2 65 05            JP    NZ,STEP2
1193   0560 D1                  POP   DE             ;get table address back
1194   0561 D5                  PUSH  DE             ;save it for later
1195   0562 C3 46 05            JP    STEP
1196   0565             ;
1197   0565             ; if element is 1FH return
1198   0565             ;
1199   0565 FE 1F       STEP2   CP    1FH            ;end of tune table?
1200   0567 C2 70 05            JP    NZ,STEP3
1201   056A E1                  POP   HL
1202   056B E1                  POP   HL
1203   056C D1                  POP   DE
1204   056D C1                  POP   BC
1205   056E F1                  POP   AF
1206   056F C9                  RET
1207   0570             ;
1208   0570             ; now play the note
1209   0570             ;
1210   0570 47          STEP3   LD    B,A            ;save element in B
1211   0571 21 8C 05            LD    HL,PERIOD      ;point to period/2 table
1212   0574 CD 01 05            CALL  INDEXB         ;get period/2
1213   0577 7E                  LD    A,(HL)         ;get element
1214   0578 F5                  PUSH  AF             ;save for later
1215   0579 78                  LD    A,B            ;get element back in a
1216   057A 21 A4 05            LD    HL,LENGTH      ;point to duration/2 table
1217   057D CD 01 05            CALL  INDEXB         ;get duration/2
1218   0580 7E                  LD    A,(HL)         ;get element
1219   0581 6F                  LD    L,A
1220   0582 26 00               LD    H,0            ;hl = duration/2
1221   0584 F1                  POP   AF
1222   0585 CD BD 05            CALL  TONE           ;do note routine
1223   0588 13                  INC   DE
1224   0589 C3 46 05            JP    STEP           ;step to next element
1225   058C             ;
1226   058C             ; period/2 of note
1227   058C             ;
1228   058C 8C 83 7C 75 PERIOD  .DB 8CH,83H,7CH,75H,70H,67H,62H,5CH
1228   0590 70 67 62 5C 
1229   0594 57 52 4E 48         .DB 57H,52H,4EH,48H,45H,41H,3CH,39H
1229   0598 45 41 3C 39 
1230   059C 36 32 2F 2C         .DB 36H,32H,2FH,2CH,2AH,27H,25H,23H
1230   05A0 2A 27 25 23 
1231   05A4             ;
1232   05A4             ; note duration/2
1233   05A4             ;
1234   05A4 19 1A 1C 1D LENGTH  .DB 19H,1AH,1CH,1DH,1EH,20H,23H,25H
1234   05A8 1E 20 23 25 
1235   05AC 27 29 2C 2E         .DB 27H,29H,2CH,2EH,31H,33H,37H,3AH
1235   05B0 31 33 37 3A 
1236   05B4 3D 41 45 49         .DB 3DH,41H,45H,49H,4DH,52H,57H,5CH
1236   05B8 4D 52 57 5C 
1237   05BC 10                  .DB 10H
1238   05BD             ;
1239   05BD             ; tone routine
1240   05BD             ; adapted from Talking Electronics TEC-1
1241   05BD             ; monitor MON-1
1242   05BD             ; by John Hardy and Ken Stone
1243   05BD             ;
1244   05BD             ;--------------
1245   05BD             ; OUTPUT A TONE
1246   05BD             ;--------------
1247   05BD             ;
1248   05BD             ; entry : ACC = period/2 of note
1249   05BD             ;         HL  = duration/2 of note
1250   05BD             ; exit  : no registers modified
1251   05BD F5          TONE    PUSH  AF
1252   05BE C5                  PUSH  BC
1253   05BF D5                  PUSH  DE
1254   05C0 E5                  PUSH  HL
1255   05C1 11 01 00            LD    DE,0001H
1256   05C4 4F                  LD    C,A
1257   05C5 29                  ADD   HL,HL          ;double duration
1258   05C6 AF                  XOR   A
1259   05C7 EE 80       TONE1   XOR   80H            ;toggle speaker bit
1260   05C9 F6 40               OR    40H            ;keep D6 high
1261   05CB D3 85               OUT   (SCAN),A       ;output speaker bit
1262   05CD 41                  LD    B,C
1263   05CE C5          TONE2   PUSH  BC
1264   05CF 06 02               LD    B,02H
1265   05D1 10 FE       TONE3   DJNZ  TONE3          ;delay for period/2
1266   05D3 C1                  POP   BC
1267   05D4 10 F8               DJNZ  TONE2          ;delay for period/2
1268   05D6 ED 52               SBC   HL,DE          ;end of note?
1269   05D8 20 ED               JR    NZ,TONE1       ;do again
1270   05DA E1                  POP   HL
1271   05DB D1                  POP   DE
1272   05DC C1                  POP   BC
1273   05DD F1                  POP   AF
1274   05DE C9                  RET
1275   05DF             ;---------------
1276   05DF             ; KEY ENTRY BEEP
1277   05DF             ;---------------
1278   05DF E5          BEEP    PUSH  HL
1279   05E0 F5                  PUSH  AF
1280   05E1 21 39 3F            LD    HL,MODE
1281   05E4 CB 76               BIT   6,(HL)         ;beep enabled?
1282   05E6 28 0E               JR    Z,BEEP2        ;beep is enabled
1283   05E8             ;
1284   05E8             ; do keypress delay
1285   05E8             ;
1286   05E8 D5                  PUSH  DE            ;do a short
1287   05E9 11 01 00            LD    DE,0001H      ;delay to prevent
1288   05EC 2A 23 3F            LD    HL,(KEYTIM)   ;recognition
1289   05EF ED 52       BEEP1   SBC   HL,DE         ;of double
1290   05F1 30 FC               JR    NC,BEEP1      ;key strokes
1291   05F3 D1                  POP   DE
1292   05F4 18 10               JR    BEEP3
1293   05F6             ;
1294   05F6             ; output keypress tones
1295   05F6             ;
1296   05F6 3E 24       BEEP2   LD    A,24H
1297   05F8 21 30 00            LD    HL,0030H
1298   05FB CD BD 05            CALL  TONE           ;do first tone
1299   05FE 3E 0E               LD    A,0EH
1300   0600 21 50 00            LD    HL,0050H
1301   0603 CD BD 05            CALL  TONE           ;do second tone
1302   0606 F1          BEEP3   POP   AF
1303   0607 E1                  POP   HL
1304   0608 C9                  RET
1305   0609             ;----------------------------------------
1306   0609             ; BREAKPOINT AND SINGLE STEPPING ROUTINES
1307   0609             ;----------------------------------------
1308   0609             ; displays and modifies registers after breakpoint
1309   0609             ; (RST 38H) or single step interrupt (if hardware
1310   0609             ; attached).
1311   0609             ; insert RST 38H (FFH) in program to examine
1312   0609             ; and modify registers.
1313   0609             ;
1314   0609 E1          SSTEP   POP   HL             ;get hl back
1315   060A F5                  PUSH  AF             ;save af for later
1316   060B 22 49 3F            LD    (TMPHL),HL
1317   060E ED 53 47 3F         LD    (TMPDE),DE
1318   0612 ED 43 45 3F         LD    (TMPBC),BC
1319   0616 DD 22 4B 3F         LD    (TMPIX),IX
1320   061A FD 22 4D 3F         LD    (TMPIY),IY     ;save registers
1321   061E E1                  POP   HL             ;get af back
1322   061F 22 43 3F            LD    (TMPAF),HL     ;save AF
1323   0622 E1                  POP   HL             ;get pc return address
1324   0623 22 41 3F            LD    (TMPPC),HL     ;save PC
1325   0626 ED 73 4F 3F         LD    (TMPSP),SP     ;save stack pointer
1326   062A             ;
1327   062A             ; step through,display and edit registers
1328   062A             ;
1329   062A CD DF 05            CALL  BEEP
1330   062D 3A 3F 3F            LD    A,(REGPNT)     ;get current reg
1331   0630 E6 07               AND   7              ;make sure in limits
1332   0632 32 3F 3F            LD    (REGPNT),A     ;save it
1333   0635 CD 12 07    SSTEP1  CALL  SETREG         ;set up display buffer
1334   0638 CD AD 04            CALL  SKEYRL         ;wait for a key
1335   063B CD A0 04            CALL  SKEYIN         ;wait for key release
1336   063E 21 47 06            LD    HL,REGTBL      ;handle the key
1337   0641 CD CE 04            CALL  MENU           ;and update display
1338   0644 C3 35 06            JP    SSTEP1         ;before returning to loop
1339   0647             ;
1340   0647             ; register display key table
1341   0647             ;
1342   0647 14          REGTBL  .DB 14H
1343   0648 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
1343   064C 04 05 06 07 
1344   0650 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
1344   0654 0C 0D 0E 0F 
1345   0658 10 11 12 13         .DB 10H,11H,12H,13H
1346   065C 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1346   0660 94 06 94 06 
1347   0664 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1347   0668 94 06 94 06 
1348   066C 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1348   0670 94 06 94 06 
1349   0674 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1349   0678 94 06 94 06 
1350   067C BB 06 C5 06         .DW RETMON,RETPGM,INCSTP,DECSTP
1350   0680 E7 06 FC 06 
1351   0684             ;
1352   0684             ; register name characters
1353   0684             ;
1354   0684 39 73       REGNAM  .DW 7339H
1355   0686 71 77 39 7C         .DW 7771H,7C39H,5E79H
1355   068A 79 5E 
1356   068C 38 74 76 06         .DW 7438H,0676H,066EH
1356   0690 6E 06 
1357   0692 73 6D               .DW 6D73H
1358   0694             ;--------------
1359   0694             ; EDIT REGISTER
1360   0694             ;--------------
1361   0694 CD DF 05    REGKEY  CALL  BEEP
1362   0697 F5                  PUSH  AF             ;save key for later
1363   0698 3A 3F 3F            LD    A,(REGPNT)
1364   069B             ;
1365   069B             ; edit register
1366   069B             ;
1367   069B 21 41 3F            LD    HL,TMPPC
1368   069E CD 08 05            CALL  INDEXW
1369   06A1 4E                  LD    C,(HL)
1370   06A2 23                  INC   HL
1371   06A3 46                  LD    B,(HL)         ;get reg contents
1372   06A4 CB 21               SLA   C
1373   06A6 CB 10               RL    B
1374   06A8 CB 21               SLA   C
1375   06AA CB 10               RL    B
1376   06AC CB 21               SLA   C
1377   06AE CB 10               RL    B              ;shift register
1378   06B0 CB 21               SLA   C              ;four bits
1379   06B2 CB 10               RL    B              ;left and
1380   06B4 F1                  POP   AF             ;put the key
1381   06B5 B1                  OR    C              ;into the lsn
1382   06B6 4F                  LD    C,A            ;and put the
1383   06B7 70                  LD    (HL),B         ;register back
1384   06B8 2B                  DEC   HL             ;where it belongs
1385   06B9 71                  LD   (HL),C
1386   06BA C9                  RET
1387   06BB             ;------------------
1388   06BB             ; RETURN TO MONITOR
1389   06BB             ;------------------
1390   06BB CD DF 05    RETMON  CALL  BEEP
1391   06BE CD AD 04            CALL  SKEYRL
1392   06C1 FB                  EI                   ;enable interrupts again
1393   06C2 C3 85 02            JP    MAIN
1394   06C5             ;------------------
1395   06C5             ; RETURN TO PROGRAM
1396   06C5             ;------------------
1397   06C5 ED 7B 4F 3F RETPGM  LD    SP,(TMPSP)     ;put stack pointer back
1398   06C9 2A 41 3F            LD    HL,(TMPPC)     ;put return
1399   06CC E5                  PUSH  HL             ;address back on stack
1400   06CD 2A 43 3F            LD    HL,(TMPAF)
1401   06D0 E5                  PUSH  HL             ;save af reg for later
1402   06D1 FD 2A 4D 3F         LD    IY,(TMPIY)
1403   06D5 DD 2A 4B 3F         LD    IX,(TMPIX)
1404   06D9 ED 4B 45 3F         LD    BC,(TMPBC)
1405   06DD ED 5B 47 3F         LD    DE,(TMPDE)     ;restore registers
1406   06E1 F1                  POP   AF             ;restore AF
1407   06E2 2A 49 3F            LD    HL,(TMPHL)     ;restore HL
1408   06E5 FB                  EI                   ;enable interrupts
1409   06E6 C9                  RET                  ;and return to program
1410   06E7             ;----------------------
1411   06E7             ; display next register
1412   06E7             ;----------------------
1413   06E7 CD DF 05    INCSTP  CALL  BEEP
1414   06EA 3A 3F 3F            LD    A,(REGPNT)
1415   06ED FE 07               CP    7              ;end of reg table?
1416   06EF CA F7 06            jp    z,INCSP1
1417   06F2 3C                  INC   A
1418   06F3 32 3F 3F            LD    (REGPNT),A
1419   06F6 C9                  RET
1420   06F7 AF          INCSP1  XOR   A
1421   06F8 32 3F 3F            LD   (REGPNT),A
1422   06FB C9                  RET
1423   06FC             ;--------------------------
1424   06FC             ; display previous register
1425   06FC             ;--------------------------
1426   06FC CD DF 05    DECSTP  CALL  BEEP
1427   06FF 3A 3F 3F            LD    A,(REGPNT)
1428   0702 FE 00               CP    0              ;start of reg table?
1429   0704 CA 0C 07            JP    Z,DECSP1
1430   0707 3D                  DEC   A
1431   0708 32 3F 3F            LD    (REGPNT),A
1432   070B C9                  RET
1433   070C 3E 07       DECSP1  LD    A,7
1434   070E 32 3F 3F            LD    (REGPNT),A
1435   0711 C9                  RET
1436   0712             ;-----------------
1437   0712             ; display register
1438   0712             ;-----------------
1439   0712 3A 3F 3F    SETREG  LD    A,(REGPNT)
1440   0715 21 41 3F            LD    HL,TMPPC       ;start of table
1441   0718 CD 08 05            CALL  INDEXW         ;get element address
1442   071B 5E                  LD    E,(HL)
1443   071C 23                  INC   HL
1444   071D 56                  LD    D,(HL)
1445   071E EB                  EX    DE,HL          ;load register contents
1446   071F CD 07 04            CALL  DISADD
1447   0722             ;
1448   0722             ; display register name
1449   0722             ;
1450   0722 21 84 06            LD    HL,REGNAM
1451   0725 CD 08 05            CALL  INDEXW
1452   0728 7E                  LD    A,(HL)
1453   0729 32 31 3F            LD    (DISBUF+0),A
1454   072C 23                  INC   HL
1455   072D 7E                  LD    A,(HL)
1456   072E 32 32 3F            LD    (DISBUF+1),A
1457   0731 C9                  RET
1458   0732             ;------------------
1459   0732             ; function key menu
1460   0732             ;------------------
1461   0732             ; when the Fn key is pressed, Fn is displayed in the
1462   0732             ; data displays, the current address remains in the
1463   0732             ; address displays. The program then waits for a
1464   0732             ; keypress which will select 1 of 16 routines.
1465   0732             ;
1466   0732 CD 3C 03    FUNKEY  CALL  AUTRST
1467   0735 CD DF 05            CALL  BEEP
1468   0738 2A 3B 3F    FUNKY1  LD    HL,(ADRESS)
1469   073B CD 07 04            CALL  DISADD          ;disp addr to remove dp's
1470   073E 21 54 71            LD    HL,7154H        ;Fn
1471   0741 22 31 3F            LD    (DISBUF),HL     ;display Fn
1472   0744 CD AD 04            CALL  SKEYRL         ;wait for key release
1473   0747 CD A0 04    FUNKY2  CALL  SKEYIN
1474   074A 2A 15 3F            LD    HL,(FUNTBL)    ;use the menu handler
1475   074D CD CE 04            CALL  MENU           ;routine for each key
1476   0750             ;
1477   0750             ; return to main
1478   0750             ;
1479   0750 CD DF 05    CANCEL  CALL  BEEP
1480   0753 CD A3 03    CANCL1  CALL  UPDATE         ;update display buffer
1481   0756 CD AD 04            CALL  SKEYRL         ;wait for key release
1482   0759 C9                  RET
1483   075A             ;
1484   075A             ; function menu key table
1485   075A             ;
1486   075A 11          FUNLST  .DB 11H
1487   075B 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
1487   075F 04 05 06 07 
1488   0763 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
1488   0767 0C 0D 0E 0F 
1489   076B 10                  .DB 10H ;FN KEY
1490   076C 92 07 9C 07         .DW GOEXEC,INTELFN,ADDRA,ADDRB
1490   0770 86 08 98 08 
1491   0774 AA 08 00 09         .DW BLKMVE,BLKSUM,BRANCH,TRACE
1491   0778 3E 09 75 09 
1492   077C 96 09 A5 09         .DW PLAY1,PLAY2,PLAY3,SWBEEP
1492   0780 B4 09 C3 09 
1493   0784 5D 0A DE 0B         .DW SECRET,RELSQR,SCOPE,TIME
1493   0788 36 0C E5 0C 
1494   078C 8E 07               .DW FUNFUN
1495   078E             ;-----------------------
1496   078E             ; call function function
1497   078E             ;-----------------------
1498   078E 2A 2F 3F    FUNFUN  LD    HL,(FUNJMP)
1499   0791 E9                  JP    (HL)
1500   0792             ;------------------------------------------
1501   0792             ; function 0 - execute from current address
1502   0792             ;------------------------------------------
1503   0792 CD DF 05    GOEXEC  CALL  BEEP
1504   0795 CD C4 04            CALL  KEYREL
1505   0798             ;   POP HL  ;remove exec return
1506   0798 2A 3B 3F            LD    HL,(ADRESS)
1507   079B E9                  JP    (HL)           ;start execuction
1508   079C             ;------------------------------------
1509   079C             ; function 1 receive intel hex format
1510   079C             ;------------------------------------
1511   079C CD DF 05    INTELFN CALL  BEEP
1512   079F CD C4 04            CALL  KEYREL
1513   07A2 CD AB 07            CALL  INTELH
1514   07A5 C2 C9 08            JP    NZ,BLKMV1      ;show the error
1515   07A8 C3 50 07            JP    CANCEL         ;just return if all ok
1516   07AB             ;--------------------------
1517   07AB             ; INTEL hex file downloader
1518   07AB             ;--------------------------
1519   07AB AF          INTELH  XOR   A              ;clear
1520   07AC 4F                  LD    C,A            ;calculated checksum
1521   07AD             ;
1522   07AD             ; wait for the record mark ':'
1523   07AD             ;
1524   07AD CD 4C 08    WMARK   CALL  RXDATA         ;wait for the record mark
1525   07B0 FE 3A               CP    ':'            ;to be transmitted
1526   07B2 20 F9               JR    NZ,WMARK
1527   07B4             ;
1528   07B4             ; get the record length
1529   07B4             ;
1530   07B4 CD D9 07            CALL  GETBYT
1531   07B7 47                  LD    B,A            ;the number of data bytes
1532   07B8             ;
1533   07B8             ; get the address
1534   07B8             ;
1535   07B8 CD D9 07            CALL  GETBYT
1536   07BB 67                  LD    H,A            ;the address high byte
1537   07BC CD D9 07            CALL  GETBYT
1538   07BF 6F                  LD    L,A            ;the address low byte
1539   07C0             ;
1540   07C0             ; get the record type
1541   07C0             ;
1542   07C0 CD D9 07            CALL  GETBYT
1543   07C3 20 0D               JR    NZ,CKSUM       ;end of file record
1544   07C5             ;
1545   07C5             ; C=checksum
1546   07C5             ; B=number of data bytes
1547   07C5             ; HL=destination address
1548   07C5             ;
1549   07C5 CD D9 07    LBYTES  CALL  GETBYT         ;get the record bytes
1550   07C8 77                  LD    (HL),A         ;and save to RAM
1551   07C9 23                  INC   HL             ;until there are
1552   07CA 10 F9               DJNZ  LBYTES         ;no more
1553   07CC CD D2 07            CALL  CKSUM          ;checksum ok?
1554   07CF 28 DA               JR    Z,INTELH       ;checksum ok, get next record
1555   07D1 C9                  RET                  ;checksum error a>0
1556   07D2             ;
1557   07D2             ; the sum of all the bytes (except record mark )
1558   07D2             ; including the checksum equals zero
1559   07D2             ;
1560   07D2 CD D9 07    CKSUM   CALL  GETBYT
1561   07D5 79                  LD    A,C
1562   07D6 F6 00               OR    00H            ;checksum ok  a=0
1563   07D8 C9                  RET
1564   07D9             ;
1565   07D9             ; get and convert two characters to byte
1566   07D9             ;
1567   07D9 CD 4C 08    GETBYT  CALL  RXDATA         ;get the high nibble
1568   07DC CB 77               BIT   6,A            ;convert ASCII A-F
1569   07DE 28 02               JR    Z,GETBYT1      ;into lower
1570   07E0 C6 09               ADD   A,09H          ;nibble hex
1571   07E2 E6 0F       GETBYT1 AND   0FH
1572   07E4 CB 27               SLA   A
1573   07E6 CB 27               SLA   A
1574   07E8 CB 27               SLA   A
1575   07EA CB 27               SLA   A
1576   07EC 57                  LD    D,A
1577   07ED CD 4C 08            CALL  RXDATA         ;get the low nibble
1578   07F0 CB 77               BIT   6,A            ;convert ascii a-f
1579   07F2 28 02               JR    Z,GETBYT2      ;into lower
1580   07F4 C6 09               ADD   A,09H          ;nibble hex
1581   07F6 E6 0F       GETBYT2 AND   0FH
1582   07F8 B2                  OR    D              ;make a byte
1583   07F9 F5                  PUSH  AF
1584   07FA 81                  ADD   A,C            ;add to
1585   07FB 4F                  LD    C,A            ;the checksum
1586   07FC F1                  POP   AF             ;and return the received byte
1587   07FD C9                  RET
1588   07FE             ;-------------------------------
1589   07FE             ; CONVERT ASCII CHARACTER TO HEX
1590   07FE             ;-------------------------------
1591   07FE             ; converts ascii 0-9,a-f into hex lsn
1592   07FE             ;  entry : a= ascii 0-9,a-f
1593   07FE             ;  exit  : a= hex 0-f in lsn
1594   07FE             ;  a and f registers modified
1595   07FE             ;
1596   07FE CB 77       ASCHEX  BIT   6,A
1597   0800 28 02               JR    Z,ASCHX1
1598   0802 C6 09               ADD   A,09H
1599   0804 E6 0F       ASCHX1  AND   0FH
1600   0806 C9                  RET
1601   0807             ;------------------------------------
1602   0807             ; BIT BANG SERIAL PORT INITIALISATION
1603   0807             ;------------------------------------
1604   0807             ; set the serial transmit pin high so the 
1605   0807             ; host can see that we are preparing to transmit
1606   0807             ; 
1607   0807             ; entry : HL = baud rate
1608   0807             ;         HL = 0 use existing baud constant
1609   0807             ; exit  : HL preserved
1610   0807             ;       ; AF modified
1611   0807             ;
1612   0807 3E 40       SERINI  LD    A,40H
1613   0809 D3 85               OUT   (SCAN),A       ;turn off the display make serial tx high
1614   080B 06 32               LD    B,50
1615   080D CD 17 08            CALL  MSDELAY        ;wait so the host sees tx high
1616   0810 7C                  LD    A,H
1617   0811 B5                  OR    L
1618   0812 C8                  RET   Z              ;hl is zero don't update the baud rate
1619   0813 22 21 3F            LD   (BAUD),HL       ;update the baud rate
1620   0816 C9                  RET 
1621   0817             ;------------------
1622   0817             ; MILLISECOND DELAY
1623   0817             ;------------------
1624   0817             ; approx. 1 millisecond delay
1625   0817             ; 
1626   0817             ; entry : B = 1 to 255 milliseconds
1627   0817             ; exit  : B = 0
1628   0817             ;
1629   0817 C5          MSDELAY PUSH  BC             ;11T
1630   0818 06 E9               LD    B,233          ;7T
1631   081A 00          MSDEL1  NOP                  ;4T
1632   081B 10 FD               DJNZ  MSDEL1         ;NZ=13T,Z=8T
1633   081D C1                  POP   BC             ;10T
1634   081E 10 F7               DJNZ  MSDELAY        ;NZ=13T,Z=8T
1635   0820 C9                  RET                  ;10T
1636   0821             ;------------------------
1637   0821             ; SERIAL TRANSMIT ROUTINE
1638   0821             ;------------------------
1639   0821             ; transmit byte serially on DOUT
1640   0821             ;
1641   0821             ; entry : ACC = byte to transmit
1642   0821             ;  exit : no registers modified
1643   0821             ;
1644   0821 F5          TXDATA  PUSH  AF
1645   0822 C5                  PUSH  BC
1646   0823 E5                  PUSH  HL
1647   0824 2A 21 3F            LD    HL,(BAUD)
1648   0827 4F                  LD    C,A
1649   0828             ;
1650   0828             ; transmit start bit
1651   0828             ;
1652   0828 AF                  XOR   A
1653   0829 D3 85               OUT   (SCAN),A
1654   082B CD 79 08            CALL  BITIME
1655   082E             ;
1656   082E             ; transmit data
1657   082E             ;
1658   082E 06 08               LD    B,08H
1659   0830 CB 09               RRC   C
1660   0832 CB 09       NXTBIT  RRC   C              ;shift bits to D6,
1661   0834 79                  LD    A,C            ;lsb first and output
1662   0835 E6 40               AND   40H            ;them for one bit time.
1663   0837 D3 85               OUT   (SCAN),A
1664   0839 CD 79 08            CALL  BITIME
1665   083C 10 F4               DJNZ  NXTBIT
1666   083E             ;
1667   083E             ; send stop bits
1668   083E             ;
1669   083E 3E 40               LD    A,40H
1670   0840 D3 85               OUT   (SCAN),A       ;make D6 high
1671   0842 CD 79 08            CALL  BITIME         ;transmit
1672   0845 CD 79 08            CALL  BITIME         ;two stop bits
1673   0848 E1                  POP   HL
1674   0849 C1                  POP   BC
1675   084A F1                  POP   AF
1676   084B C9                  RET
1677   084C             ;-----------------------
1678   084C             ; SERIAL RECEIVE ROUTINE
1679   084C             ;-----------------------
1680   084C             ; receive serial byte from DIN
1681   084C             ;
1682   084C             ; entry : none
1683   084C             ;  exit : ACC= received byte if carry clear
1684   084C             ;
1685   084C             ; registers modified ACC and F
1686   084C             ;
1687   084C C5          RXDATA  PUSH  BC
1688   084D E5                  PUSH  HL
1689   084E             ;
1690   084E             ; wait for start bit
1691   084E             ;
1692   084E DB 86       RXDAT1  IN    A,(KEYBUF)
1693   0850 CB 7F               BIT   7,A
1694   0852 20 FA               JR    NZ,RXDAT1      ;no start bit
1695   0854             ;
1696   0854             ; detected start bit
1697   0854             ;
1698   0854 2A 21 3F            LD    HL,(BAUD)
1699   0857 CB 3C               SRL   H
1700   0859 CB 1D               RR    L              ;delay for half bit time
1701   085B CD 79 08            CALL  BITIME
1702   085E DB 86               IN    A,(KEYBUF)
1703   0860 CB 7F               BIT   7,A
1704   0862 20 EA               JR    NZ,RXDAT1      ;start bit not valid
1705   0864             ;
1706   0864             ; detected valid start bit,read in data
1707   0864             ;
1708   0864 06 08               LD    B,08H
1709   0866 2A 21 3F    RXDAT2  LD    HL,(BAUD)
1710   0869 CD 79 08            CALL  BITIME         ;delay one bit time
1711   086C DB 86               IN    A,(KEYBUF)
1712   086E CB 17               RL    A
1713   0870 CB 19               RR    C              ;shift bit into data reg
1714   0872 10 F2               DJNZ  RXDAT2
1715   0874 79                  LD    A,C
1716   0875 B7                  OR    A              ;clear carry flag
1717   0876 E1                  POP   HL
1718   0877 C1                  POP   BC
1719   0878 C9                  RET
1720   0879             ;---------------
1721   0879             ; BIT TIME DELAY
1722   0879             ;---------------
1723   0879             ; delay for one serial bit time
1724   0879             ;  entry : HL = delay time
1725   0879             ; no registers modified
1726   0879             ;
1727   0879 E5          BITIME  PUSH  HL
1728   087A D5                  PUSH  DE
1729   087B 11 01 00            LD    DE,0001H
1730   087E ED 52       BITIM1  SBC   HL,DE
1731   0880 D2 7E 08            JP    NC,BITIM1
1732   0883 D1                  POP   DE
1733   0884 E1                  POP   HL
1734   0885 C9                  RET
1735   0886             ;-----------------------------
1736   0886             ; FUNCTION 2 - ENTER ADDRESS 1
1737   0886             ;-----------------------------
1738   0886 CD DF 05    ADDRA   CALL  BEEP
1739   0889 2A 3B 3F            LD    HL,(ADRESS)    ;copy current
1740   088C 22 29 3F            LD    (BLKSRT),HL    ;address as start
1741   088F 21 00 39            LD    HL,3900H       ;address [
1742   0892 CD F2 08            CALL  SDELAY
1743   0895 C3 53 07            JP    CANCL1
1744   0898             ;-----------------------------
1745   0898             ; FUNCTION 3 - ENTER ADDRESS 2
1746   0898             ;-----------------------------
1747   0898 CD DF 05    ADDRB   CALL  BEEP
1748   089B 2A 3B 3F            LD    HL,(ADRESS)    ;copy current
1749   089E 22 2B 3F            LD    (BLKEND),HL    ;address as end
1750   08A1 21 0F 00            LD    HL,000FH       ;address ]
1751   08A4 CD F2 08            CALL  SDELAY
1752   08A7 C3 53 07            JP    CANCL1
1753   08AA             ;------------------------
1754   08AA             ; FUNCTION 4 - BLOCK MOVE
1755   08AA             ;------------------------
1756   08AA CD DF 05    BLKMVE  CALL  BEEP
1757   08AD 2A 3B 3F            LD    HL,(ADRESS)    ;COPY CURRENT
1758   08B0 22 2D 3F            LD    (BLKDST),HL    ;ADDRESS AS
1759   08B3 21 0F 39            LD    HL,390FH       ;DESTINATION
1760   08B6 CD F2 08            CALL  SDELAY
1761   08B9             ;
1762   08B9             ; calculate number of bytes to move
1763   08B9             ;
1764   08B9 2A 2B 3F            LD    HL,(BLKEND)
1765   08BC ED 5B 29 3F         LD    DE,(BLKSRT)
1766   08C0 A7                  AND   A
1767   08C1 ED 52               SBC   HL,DE
1768   08C3 23                  INC   HL             ;make move inclusive
1769   08C4 22 27 3F            LD    (COUNT),HL
1770   08C7 30 15               JR    NC,BLKMV3      ;if ok move block
1771   08C9             ;
1772   08C9             ; show error
1773   08C9             ;
1774   08C9 21 79 00    BLKMV1  LD    HL,0079H       ;show error e
1775   08CC CD DF 05    BLKMV2  CALL  BEEP
1776   08CF 22 31 3F            LD    (DISBUF),HL    ;and wait
1777   08D2 CD A0 04            CALL  SKEYIN         ;for keypress
1778   08D5 CD DF 05            CALL  BEEP
1779   08D8 CD AD 04            CALL  SKEYRL
1780   08DB C3 53 07            JP    CANCL1
1781   08DE             ;
1782   08DE             ; move block
1783   08DE             ;
1784   08DE CD E4 08    BLKMV3  CALL  MOVE
1785   08E1 C3 53 07            JP    CANCL1
1786   08E4             ;-----------
1787   08E4             ; BLOCK MOVE
1788   08E4             ;-----------
1789   08E4 ED 4B 27 3F MOVE    LD    BC,(COUNT)
1790   08E8 2A 29 3F            LD    HL,(BLKSRT)    ;start addr
1791   08EB ED 5B 2D 3F         LD    DE,(BLKDST)    ;destination addr
1792   08EF ED B0               LDIR
1793   08F1 C9                  RET
1794   08F2             ;-------------------------------
1795   08F2             ; SCAN DISPLAY UNTIL KEY RELEASE
1796   08F2             ;-------------------------------
1797   08F2 22 31 3F    SDELAY  LD    (DISBUF),HL    ;show HL
1798   08F5 06 FF               LD    B,255          ;in data displays
1799   08F7 CD 55 04    SDELY1  CALL  SCAND          ;until key
1800   08FA 10 FB               DJNZ  SDELY1         ;is released
1801   08FC CD AD 04            CALL  SKEYRL
1802   08FF C9                  RET
1803   0900             ;---------------------------
1804   0900             ;FUNCTION 5 - BLOCK CHECKSUM
1805   0900             ;---------------------------
1806   0900 CD DF 05    BLKSUM  CALL  BEEP
1807   0903 21 6D 39            LD    HL,396DH       ;cs
1808   0906 CD F2 08            CALL  SDELAY         ;show prompt
1809   0909 ED 5B 29 3F         LD    DE,(BLKSRT)
1810   090D 2A 2B 3F            LD    HL,(BLKEND)
1811   0910 A7                  AND   A
1812   0911 ED 52               SBC   HL,DE
1813   0913 23                  INC   HL             ;make checksum inclusive
1814   0914 22 27 3F            LD    (COUNT),HL
1815   0917 30 03               JR    NC,BLKSM1      ;if ok sum block
1816   0919             ;
1817   0919             ; show error
1818   0919             ;
1819   0919 C3 C9 08            JP    BLKMV1
1820   091C             ;
1821   091C             ; calculate checksum
1822   091C             ;
1823   091C 2A 29 3F    BLKSM1  LD    HL,(BLKSRT)
1824   091F ED 5B 2B 3F         LD    DE,(BLKEND)
1825   0923 CD F1 04            CALL  CHKSUM         ;do the checksum,
1826   0926 CD 1C 04            CALL  DISBYT         ;display
1827   0929 2A 27 3F            LD    HL,(COUNT)     ;number of bytes
1828   092C CD 07 04            CALL  DISADD         ;summed and
1829   092F CD DF 05            CALL  BEEP
1830   0932 CD A0 04            CALL  SKEYIN         ;checksum until
1831   0935 CD DF 05            CALL  BEEP           ;a key is pressed
1832   0938 CD AD 04            CALL  SKEYRL
1833   093B C3 53 07            JP    CANCL1
1834   093E             ;----------------------------------------
1835   093E             ; FUNCTION 6 - RELATIVE BRANCH CALCULATOR
1836   093E             ;----------------------------------------
1837   093E CD DF 05    BRANCH  CALL  BEEP
1838   0941 21 7C 50            LD    HL,507CH       ;'rb'
1839   0944 CD F2 08            CALL  SDELAY
1840   0947 2A 3B 3F            LD    HL,(ADRESS)    ;get current address
1841   094A ED 5B 29 3F         LD    DE,(BLKSRT)
1842   094E 13                  INC   DE             ;point to PC+2
1843   094F A7                  AND   A
1844   0950 ED 52               SBC   HL,DE          ;subtract
1845   0952             ;
1846   0952             ; test high byte of result to
1847   0952             ; determine if backward branch
1848   0952             ;
1849   0952 7C                  LD    A,H
1850   0953 FE FF               CP    255            ;backward branch?
1851   0955 C2 60 09            JP    NZ,BRNCH1      ;check if forward
1852   0958             ;
1853   0958             ; check if we have branched beyond -128
1854   0958             ;
1855   0958 7D                  LD    A,L
1856   0959 CB 7F               BIT   7,A
1857   095B 20 0E               JR    NZ,BRNCH2      ;branch is within limits
1858   095D C3 C9 08            JP    BLKMV1         ;too far back
1859   0960             ;
1860   0960             ; test high byte of result to
1861   0960             ; determine if forward branch
1862   0960             ;
1863   0960 FE 00       BRNCH1  CP    0              ;forward branch?
1864   0962 C2 C9 08            JP    NZ,BLKMV1      ;too far in any direction
1865   0965             ;
1866   0965             ; check if we have branched beyond +128
1867   0965             ;
1868   0965 7D                  LD    A,L
1869   0966 CB 7F               BIT   7,A
1870   0968 C2 C9 08            JP    NZ,BLKMV1      ;too far forward
1871   096B             ;
1872   096B             ; within limits, put in RAM
1873   096B             ; and show as current address
1874   096B             ;
1875   096B 2A 29 3F    BRNCH2  LD    HL,(BLKSRT)
1876   096E 22 3B 3F            LD    (ADRESS),HL
1877   0971 77                  LD    (HL),A
1878   0972 C3 53 07            JP    CANCL1
