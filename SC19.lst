2315   0C97 3E 05               LD    A,5
2316   0C99 86                  ADD   A,(HL)
2317   0C9A E6 0F               AND   0FH
2318   0C9C 77                  LD    (HL),A         ;add 5 to first LSN
2319   0C9D 23                  INC   HL
2320   0C9E 3E 03               LD    A,03H
2321   0CA0 86                  ADD   A,(HL)
2322   0CA1 E6 0F               AND   0FH
