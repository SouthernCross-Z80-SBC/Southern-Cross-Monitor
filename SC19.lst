2530   0DE0 ED 6F               RLD                   ;move the new key
2531   0DE2 23                  INC   HL              ;into the clock buffer
2532   0DE3 ED 6F               RLD
2533   0DE5 23                  INC   HL
2534   0DE6 ED 6F               RLD
