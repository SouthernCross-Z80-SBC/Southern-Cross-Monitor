0360++ 1935             ; STRUCTURAL CONCEPTS
0361++ 1935             ; DATA
0362++ 1935             ;
0363++ 1935             ;		Operand:	Standard Z80 assembler format.
0364++ 1935             ;					The operand mode is determined by an input
0365++ 1935             ;					index (1 - 15) and by point of entry:-
0366++ 1935             ;
0367++ 1935             ;		Index		OPRND1				OPRND2
0368++ 1935             ;		------------------------------------------------------
0369++ 1935             ;		1			RST address			Relative address
0370++ 1935             ;		2			Condition			Immediate byte
0371++ 1935             ;		3			Bit number			Immediate word
0372++ 1935             ;		4			Interrupt mode		AF,AF'
0373++ 1935             ;		5			(SP)				DE,HL
