2216   0C0D 10 FB               DJNZ  RELSR2         ;more seconds to go
2217   0C0F C3 F9 0B            JP    RELSR1
2218   0C12             ;
2219   0C12             ; repeat
2220   0C12             ;
2221   0C12 D1          RELSR3  POP   DE             ;get start address
2222   0C13 D5                  PUSH  DE             ;save for later
2223   0C14 C3 F9 0B            JP    RELSR1
2224   0C17             ;
2225   0C17             ; finished
2226   0C17             ;
2227   0C17 AF          RELSR4  XOR   A
2228   0C18 D3 81               OUT   (IO1),A        ;clear output reg
2229   0C1A E1                  POP   HL
2230   0C1B E1                  POP   HL
2231   0C1C D1                  POP   DE
2232   0C1D C1                  POP   BC
2233   0C1E F1                  POP   AF
2234   0C1F C9                  RET
