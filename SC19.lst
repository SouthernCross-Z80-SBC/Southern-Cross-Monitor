0695   0407             
0696   0407             ;-------------------------
0697   0407             ; ADDRESS > DISPLAY BUFFER
0698   0407             ;-------------------------
0699   0407             ; convert HL to seven segment code
0700   0407             ; and put in address display buffer.
0701   0407             ;
0702   0407             ; entry : HL = address to be displayed
0703   0407             ;
0704   0407             ; exit  : no registers modified
0705   0407             ;
0706   0407 F5          DISADD  PUSH  AF
0707   0408 E5                  PUSH  HL
0708   0409 E5                  PUSH  HL
0709   040A 7C                  LD    A,H
0710   040B CD 25 04            CALL  CONBYT
0711   040E 22 35 3F            LD    (DISBUF+4),HL
0712   0411 E1                  POP   HL
0713   0412 7D                  LD    A,L
0714   0413 CD 25 04            CALL  CONBYT
0715   0416 22 33 3F            LD    (DISBUF+2),HL
0716   0419 E1                  POP   HL
0717   041A F1                  POP   AF
0718   041B C9                  RET
0719   041C             ;---------------------------
0720   041C             ; DATA BYTE > DISPLAY BUFFER
0721   041C             ;---------------------------
0722   041C             ; convert the acc to seven segment code
0723   041C             ; and put in data display buffer.
0724   041C             ;
0725   041C             ; entry :  a = data display byte
0726   041C             ;
0727   041C             ; exit  : no registers modified
0728   041C             ;
0729   041C E5          DISBYT  PUSH  HL
0730   041D CD 25 04            CALL  CONBYT
0731   0420 22 31 3F            LD    (DISBUF),HL
0732   0423 E1                  POP   HL
0733   0424 C9                  RET
0734   0425             ;---------------------------------------
0735   0425             ; CONVERT BYTE TO 7 SEGMENT DISPLAY CODE
0736   0425             ;---------------------------------------
0737   0425             ; converts byte in acc to seven segment code
0738   0425             ; for display
0739   0425             ; entry : a = byte to be converted
0740   0425             ; exit  : h = hi nibble seven segment code
0741   0425             ;         l = lo nibble seven segment code
0742   0425             ;         a = not modified
0743   0425 F5          CONBYT  PUSH  AF
0744   0426 F5                  PUSH  AF
0745   0427 CD 32 04            CALL  CONVHI         ;convert hi nibble
0746   042A 67                  LD    H,A
0747   042B F1                  POP   AF
0748   042C CD 36 04            CALL  CONVLO         ;convert lo nibble
0749   042F 6F                  LD    L,A
0750   0430 F1                  POP   AF
0751   0431 C9                  RET
0752   0432             ;---------------------------------------------
0753   0432             ; HEXADECIMAL TO SEVEN SEGMENT CODE CONVERSION
0754   0432             ;---------------------------------------------
0755   0432             ; converts nibble in acc to seven segment code
0756   0432             ; for seven segment displays
0757   0432             ; convhi = converts high nibble
0758   0432             ; convlo = converts lo nibble
0759   0432             ;
0760   0432             ; entry : a = nibble to be converted
0761   0432             ; exit  : a = seven segment code
0762   0432             ;
0763   0432 07          CONVHI  RLCA
0764   0433 07                  RLCA
0765   0434 07                  RLCA                 ;move to lo nibble
0766   0435 07                  RLCA                 ;for conversion
0767   0436 C5          CONVLO  PUSH  BC
0768   0437 E5                  PUSH  HL
0769   0438 21 45 04            LD    HL,SEGMNT      ;use the hex value
0770   043B E6 0F               AND   0FH            ;to index to the
0771   043D 4F                  LD    C,A            ;the seven segment
0772   043E 06 00               LD    B,00H          ;code for that value
0773   0440 09                  ADD   HL,BC          ;and return with
0774   0441 7E                  LD    A,(HL)         ;code in a
0775   0442 E1                  POP   HL
0776   0443 C1                  POP   BC
0777   0444 C9                  RET
0778   0445             ;
0779   0445             ; hexadecimal to 7 segment display code table
0780   0445             ;
0781   0445 3F 06 5B 4F SEGMNT  .DB 3FH,06H,5BH,4FH ;0,1,2,3
0782   0449 66 6D 7D 07         .DB 66H,6DH,7DH,07H ;4,5,6,7
0783   044D 7F 6F 77 7C         .DB 7FH,6FH,77H,7CH ;8,9,A,B
0784   0451 39 5E 79 71         .DB 39H,5EH,79H,71H ;C,D,E,F
0785   0455             ;-------------
0786   0455             ; SCAN DISPLAY
0787   0455             ;-------------
0788   0455             ; as the displays are multiplexed, the data for each
0789   0455             ; display must be latched into the display segment
0790   0455             ; latch in turn and the corresponding bit in the display
0791   0455             ; scan latch turned on to display the data.
0792   0455             ; two short delays are used to adjust the duty
0793   0455             ; cycle and hence display brightness.
0794   0455             ;
0795   0455             ; the serial output is on D6 so it must be kept high! 
0796   0455             ;
0797   0455             ; entry : none
0798   0455             ; exit  : no registers modified
0799   0455             ;
0800   0455 F5          SCAND   PUSH  AF
0801   0456 C5                  PUSH  BC
0802   0457 E5                  PUSH  HL             ;save registers
0803   0458 21 36 3F            LD    HL,DISBUF+5
0804   045B 0E 20               LD    C,20H
0805   045D 7E          SCAND1  LD    A,(HL)
0806   045E D3 84               OUT   (DISPLY),A     ;output character
0807   0460 79                  LD    A,C
0808   0461 F6 40               OR    40H            ;keep D6 high
0809   0463 D3 85               OUT   (SCAN),A       ;turn on display
0810   0465 3A 37 3F            LD    A,(ONTIM)      ;do a short delay
0811   0468 47                  LD    B,A            ;to adjust on time
0812   0469 10 FE       SCAND2  DJNZ  SCAND2         ;of display
0813   046B 78                  LD    A,B            ;b is now clear,
0814   046C F6 40               OR    40H            ;keep D6 high
0815   046E D3 85               OUT   (SCAN),A       ;use it to turn off scan.
0816   0470 3A 38 3F            LD    A,(OFTIM)      ;do a short delay
0817   0473 47                  LD    B,A            ;to adjust off time
0818   0474 10 FE       SCAND3  DJNZ  SCAND3         ;of display
0819   0476 2B                  DEC   HL             ;point to next
0820   0477 CB 09               RRC   C              ;element in buffer
0821   0479 30 E2               JR    NC,SCAND1      ;display next element
0822   047B 78                  LD    A,B            ;b is now clear,
0823   047C D3 84               OUT   (DISPLY),A     ;and clear display latch
0824   047E F6 40               OR    40H            ;keep D6 high
0825   0480 D3 85               OUT   (SCAN),A       ;use it to turn off scan
0826   0482 E1                  POP   HL
0827   0483 C1                  POP   BC
0828   0484 F1                  POP   AF             ;restore registers
0829   0485 C9                  RET
0830   0486             ;---------------------
0831   0486             ; CLEAR DISPLAY BUFFER
0832   0486             ;---------------------
0833   0486 E5          CLRBUF  PUSH  HL
0834   0487 C5                  PUSH  BC
0835   0488 21 31 3F            LD    HL,DISBUF
0836   048B 06 06               LD    B,6
0837   048D 36 00       CLRBF1  LD    (HL),00H       ;put zero in 6
0838   048F 23                  INC   HL             ;locations pointed
0839   0490 10 FB               DJNZ  CLRBF1         ;to by HL
0840   0492 C1                  POP   BC
0841   0493 E1                  POP   HL
0842   0494 C9                  RET
0843   0495             ;--------------
0844   0495             ; SCAN KEYBOARD
0845   0495             ;--------------
0846   0495             ; use the hardware or software scanned keyboard
0847   0495             ;
0848   0495             ; software scanned keyboard
0849   0495             ; uses display scan drivers for columns
0850   0495             ; and keyboard buffer as rows.
0851   0495             ; make each data line high in turn and check
0852   0495             ; if each individual pushbutton is pressed.
0853   0495             ;
0854   0495             ; entry : none
0855   0495             ; exit  : a = 00h if no key detected
0856   0495             ;         a = detected key bits 0-4
0857   0495             ;             bit 5 = HIGH key available
0858   0495             ; 
0859   0495             ; Bit 6 of the keyboard buffer is the serial input
0860   0495             ;
0861   0495 C5          SCANKEY PUSH  BC
0862   0496 D5                  PUSH  DE             ;save registers
0863   0497 E5                  PUSH  HL
0864   0498             ;
0865   0498             #IFDEF 74C923
0866   0498             ;
0867   0498             ;74c923 keyboard encoder
0868   0498             ;
0869   0498 DB 86              IN  A,(KEYBUF)        ;read hardware encoder
0870   049A E6 3F              AND 3FH               ;strip unused bits
0871   049C E1                 POP HL
0872   049D D1                 POP DE
0873   049E C1                 POP BC
0874   049F C9                 RET
0875   04A0~            #ELSE
0876   04A0~            ;
0877   04A0~            ; software scan keyboard 
0878   04A0~            ;
0879   04A0~            SCANKY1 XOR   A
0880   04A0~                    OUT   (DISPLY),A     ;clear display latch
0881   04A0~                    LD    B,A            ;key
0882   04A0~                    LD    D,A            ;count
0883   04A0~                    LD    E,01H          ;mask
0884   04A0~            SCANKY2 LD    C,08H          ;scan
0885   04A0~            SCANKY3 LD    A,C
0886   04A0~                    OR    40H            ;keep serial output bit high
0887   04A0~                    OUT   (SCAN),A       ;output scan
0888   04A0~                    NOP
0889   04A0~                    NOP
0890   04A0~                    NOP
0891   04A0~                    IN    A,(KEYBUF)     ;read key buffer
0892   04A0~                    AND   E              ;mask 
0893   04A0~                    JR    Z,SCANKY4      ;key not detected
0894   04A0~                    INC   D
0895   04A0~                    LD    L,B            ;save key
0896   04A0~            ;
0897   04A0~            ; end of rows?
0898   04A0~            ;
0899   04A0~            SCANKY4 INC   B              ;next key
0900   04A0~                    SRA   C              ;shift scan right
0901   04A0~                    JR    NC,SCANKY3     ;next row
0902   04A0~            ;
0903   04A0~            ; end of columns?
0904   04A0~            ;
0905   04A0~                    SLA   E              ;shift mask left
0906   04A0~                    BIT   5,E            ;end of keyscan?
0907   04A0~                    JR    Z,SCANKY2      ;next column
0908   04A0~            ;
0909   04A0~            ; end of scan
0910   04A0~            ;
0911   04A0~                    LD    A,D
0912   04A0~                    CP    00H
0913   04A0~                    JR    Z,SCANKY6      ;no key pressed
0914   04A0~                    CP    01H
0915   04A0~                    JR    NZ,SCANKY1     ;more than one key pressed
0916   04A0~            ;
0917   04A0~            ; one key detected
0918   04A0~            ;
0919   04A0~                    LD    A,40H          ;keep serial data out bit high
0920   04A0~                    OUT   (SCAN),A       ;clear scan reg
0921   04A0~                    LD    A,L            ;return key in ACC
0922   04A0~                    SET   5,A            ;set data available flag
0923   04A0~                    JR    SCANKY7
0924   04A0~            ;
0925   04A0~            ; no key
0926   04A0~            ;
0927   04A0~            SCANKY6 LD    A,40H          ;keep serial data out bit high
0928   04A0~                    OUT   (SCAN),A       ;clear scan reg
0929   04A0~                    XOR   A              ;clear ACC
0930   04A0~            SCANKY7 POP   HL
0931   04A0~                    POP   DE
0932   04A0~                    POP   BC
0933   04A0~                    RET
0934   04A0             #ENDIF
0935   04A0             ;-----------------------------
0936   04A0             ; SCAN DISPLAY UNTIL KEY PRESS
0937   04A0             ;-----------------------------
0938   04A0             ; entry : none
0939   04A0             ; exit  : a = key value 00h to 1fh
0940   04A0             ;         flag register modified
0941   04A0             ;
0942   04A0 CD 55 04    SKEYIN  CALL  SCAND          ;scan display
0943   04A3 CD 95 04            CALL  SCANKEY
0944   04A6 CB 6F               BIT   5,A
0945   04A8 28 F6               JR    Z,SKEYIN       ;no key press
0946   04AA E6 1F               AND   1FH            ;strip unused bits
0947   04AC C9                  RET
0948   04AD             ;-------------------------------
0949   04AD             ; SCAN DISPLAY UNTIL KEY RELEASE
0950   04AD             ;-------------------------------
0951   04AD             ; entry : none
0952   04AD             ; exit  : none
0953   04AD             ;
0954   04AD F5          SKEYRL  PUSH  AF
0955   04AE CD 55 04    SKEYL1  CALL  SCAND          ;scan display
0956   04B1 CD 95 04            CALL  SCANKEY
0957   04B4 CB 6F               BIT   5,A
0958   04B6 20 F6               JR    NZ,SKEYL1      ;key not released
0959   04B8 F1                  POP   AF
0960   04B9 C9                  RET
0961   04BA             ;-------------------
0962   04BA             ; WAIT FOR KEY PRESS
0963   04BA             ;-------------------
0964   04BA             ; entry : none
0965   04BA             ; exit  : a = key value 00h to 1fh
0966   04BA             ;         flag register modified
0967   04BA             ;
0968   04BA CD 95 04    KEYIN   CALL  SCANKEY
0969   04BD CB 6F               BIT   5,A
0970   04BF 28 F9               JR    Z,KEYIN        ;no key press
0971   04C1 E6 1F               AND   1FH            ;strip unused bits
0972   04C3 C9                  RET
0973   04C4             ;---------------------
0974   04C4             ; WAIT FOR KEY RELEASE
0975   04C4             ;---------------------
0976   04C4             ; entry : none
0977   04C4             ; exit  : none
0978   04C4             ;
0979   04C4 F5          KEYREL  PUSH  AF
0980   04C5 CD 95 04    KEYRL1  CALL  SCANKEY
0981   04C8 CB 6F               BIT   5,A
0982   04CA 20 F9               JR    NZ,KEYRL1
0983   04CC F1                  POP   AF
0984   04CD C9                  RET
0985   04CE             ;-----------------
0986   04CE             ; KEY MENU HANDLER
0987   04CE             ;-----------------
0988   04CE             ; compares acc against table of elements,
0989   04CE             ; if found jump to address corresponding to
0990   04CE             ; that element, returns if element not found.
0991   04CE             ; entry :  ACC = element to look for
0992   04CE             ;           HL = points to table
0993   04CE             ; exit  : element not found
0994   04CE             ;           HL holds address of last element
0995   04CE             ;         element found
0996   04CE             ;           control passes to jump address with
0997   04CE             ;           return address of menu call on stack
0998   04CE             ;
0999   04CE F5          MENU    PUSH  AF
1000   04CF C5                  PUSH  BC
1001   04D0 D5                  PUSH  DE             ;save registers
1002   04D1 E5                  PUSH  HL             ;calculate address
1003   04D2 16 00               LD    D,00H          ;of the jump table by
1004   04D4 5E                  LD    E,(HL)         ;adding the index to
1005   04D5 23                  INC   HL             ;the elements
1006   04D6 19                  ADD   HL,DE          ;to the addr of the
1007   04D7 54                  LD    D,H            ;table
1008   04D8 5D                  LD    E,L
1009   04D9 E1                  POP   HL
1010   04DA 46                  LD    B,(HL)         ;get number of entries
1011   04DB 23                  INC   HL             ;point to list of entries
1012   04DC BE          MENU1   CP    (HL)           ;compare with entry
1013   04DD 28 09               JR    Z,MENU2        ;found value in table
1014   04DF 23                  INC   HL             ;next entry in list
1015   04E0 13                  INC   DE             ;next entry in
1016   04E1 13                  INC   DE             ;jump table
1017   04E2 10 F8               DJNZ  MENU1          ;check more entries
1018   04E4 D1                  POP   DE
1019   04E5 C1                  POP   BC
1020   04E6 F1                  POP   AF
1021   04E7 C9                  RET                  ;not in table
1022   04E8             ;
1023   04E8             ; found element in the table
1024   04E8             ; pass control to the jump handler
1025   04E8             ;
1026   04E8 1A          MENU2   LD    A,(DE)         ;get the jump addr
1027   04E9 6F                  LD    L,A            ;from the table
1028   04EA 13                  inc   de             ;and jump to
1029   04EB 1A                  LD    A,(DE)         ;the jump address
1030   04EC 67                  LD    H,A            ;for that entry
1031   04ED D1                  POP   DE
1032   04EE C1                  POP   BC
1033   04EF F1                  POP   AF             ;restore registers
1034   04F0 E9                  JP    (HL)
1035   04F1             ;-------------------
1036   04F1             ; CALCULATE CHECKSUM
1037   04F1             ;-------------------
1038   04F1             ; calculates checksum between start and end (inclusive)
1039   04F1             ;
1040   04F1             ; entry : HL = start of block to sum
1041   04F1             ;         DE = end of block to sum
1042   04F1             ; exit  : ACC =  checksum
1043   04F1             ;         flag register modified
1044   04F1             ;
1045   04F1 E5          CHKSUM  PUSH  HL
1046   04F2 D5                  PUSH  DE
1047   04F3 13                  INC   DE             ;end of block+1
1048   04F4 AF                  XOR   A              ;clear checksum
1049   04F5 86          CHKSM1  ADD   A,(HL)         ;compute checksum
1050   04F6 23                  INC   HL             ;point to next element
1051   04F7 A7                  AND   A              ;set carry
1052   04F8 E5                  PUSH  HL
1053   04F9 ED 52               SBC   HL,DE          ;subtract
1054   04FB E1                  POP   HL
1055   04FC 38 F7               JR    C,CHKSM1       ;more elements
1056   04FE D1                  POP   DE
1057   04FF E1                  POP   HL
1058   0500 C9                  RET
1059   0501             ;--------------------------
1060   0501             ; ACCESS BYTE LOOK UP TABLE
1061   0501             ;--------------------------
1062   0501             ; use 8 bit index to access byte look
1063   0501             ; up table
1064   0501             ; entry :  ACC = number of element in table
1065   0501             ;           HL = address of look up table
1066   0501             ; exit :    HL = address of element number in ACC
1067   0501             ;
1068   0501 D5          INDEXB  PUSH  DE
1069   0502 5F                  LD    E,A            ;use de as index
1070   0503 16 00               LD    D,0            ;to element in table
1071   0505 19                  ADD   HL,DE          ;by adding to hl
1072   0506 D1                  POP   DE
1073   0507 C9                  RET
1074   0508             ;--------------------------
1075   0508             ; ACCESS WORD LOOK UP TABLE
1076   0508             ;--------------------------
1077   0508             ; use 8 bit index to access word look
1078   0508             ; up table
1079   0508             ; entry :  ACC = number of element in table
1080   0508             ;           HL = address of look up table
1081   0508             ; exit :    HL = address of 2 byte element number in ACC
1082   0508             ;
1083   0508 D5          INDEXW  PUSH  DE
1084   0509 5F                  LD    E,A
1085   050A CB 23               SLA   E              ;multiply by two
1086   050C 16 00               ld    d,0
1087   050E 19                  ADD   HL,DE
1088   050F D1                  POP   DE
1089   0510 C9                  RET
1090   0511             ;-------------------------------
1091   0511             ; GENERATE A QUASI-RANDOM NUMBER
1092   0511             ;-------------------------------
1093   0511             ; generate an 16 bit random number
1094   0511             ; using linear congruential method.
1095   0511             ;
1096   0511             ;     Rn+1 = (aRn+c) MOD m
1097   0511             ;
1098   0511             ; refresh register used for Rn and c
1099   0511             ;   entry : none
1100   0511             ;   exit  : HL = random word
1101   0511             ;   no registers modified
1102   0511             ;
1103   0511 F5          RAND    PUSH  AF
1104   0512 C5                  PUSH  BC
1105   0513 D5                  PUSH  DE             ;save registers
1106   0514             ;
1107   0514             ; calculate aRn
1108   0514             ;
1109   0514 ED 5F               LD    A,R            ;get a random seed from the refresh register
1110   0516 5F                  LD    E,A            ;multiply random number
1111   0517 16 00               LD    D,0            ;(rn) by
1112   0519 21 48 05            LD    HL,0548H       ;constant (a)
1113   051C CD 29 05            CALL  MUL16
1114   051F             ;
1115   051F             ; calculate aRn+c
1116   051F             ;
1117   051F ED 5F               LD    A,R            ;add it to another
1118   0521 06 00               LD    B,0            ;read of the
1119   0523 4F                  LD    C,A            ;the refresh
1120   0524 09                  ADD   HL,BC          ;register (c)
1121   0525 D1                  POP   DE
1122   0526 C1                  POP   BC
1123   0527 F1                  POP   AF             ;restore registers
1124   0528 C9                  RET
1125   0529             ;----------------------
1126   0529             ; 16 BIT MULTIPLICATION
1127   0529             ;----------------------
1128   0529             ; 16 bit multiply
1129   0529             ;  entry : HL = multiplicand (mpd)
1130   0529             ;          DE = multiplier (mpr)
1131   0529             ;  exit  : HL = result
1132   0529             ; from Zaks 'Programming the Z80'
1133   0529             ;
1134   0529 F5          MUL16   PUSH  AF
1135   052A C5                  PUSH  BC
1136   052B 4C                  LD    C,H            ;mpr(H)
1137   052C 7D                  LD    A,L            ;mpr(L)
1138   052D 06 10               LD    B,16           ;bit counter
1139   052F 21 00 00            LD    HL,0           ;clear result
1140   0532 CB 39       MULT    SRL   C              ;mpr (H)
1141   0534 1F                  RRA                  ;mpr (L)
1142   0535 30 01               JR    NC,MULT1       ;test carry
1143   0537 19                  ADD   HL,DE          ;add mpd to result
1144   0538 EB          MULT1   EX    DE,HL
1145   0539 29                  ADD   HL,HL          ;double -shift mpd left
1146   053A EB                  EX    DE,HL
1147   053B 10 F5               DJNZ  MULT           ;done?
1148   053D C1                  POP   BC
1149   053E F1                  POP   AF
1150   053F C9                  RET
1151   0540             ; music routine
1152   0540             ; adapted from talking electronics TEC-1
1153   0540             ; monitor MON-1
1154   0540             ; by John Hardy and Ken Stone
1155   0540             ;
1156   0540             ;----------------
1157   0540             ; MUSIC SEQUENCER
1158   0540             ;----------------
1159   0540             ; sequences through a table of notes
1160   0540             ; 1EH = repeat tune until reset
1161   0540             ; 1FH = play once and return
1162   0540             ;  entry : HL = address of note table
1163   0540             ;  exit : no registers modified
1164   0540 F5          MUSIC   PUSH  AF
1165   0541 C5                  PUSH  BC
1166   0542 D5                  PUSH  DE
1167   0543 E5                  PUSH  HL             ;save registers
1168   0544 E5                  PUSH  HL
1169   0545 EB                  EX    DE,HL          ;get address of music
1170   0546             ;
1171   0546             ; play each note in turn
1172   0546             ;
1173   0546 1A          STEP    LD    A,(DE)         ;get element from table
1174   0547 E6 1F               AND   1FH            ;strip unused bits
1175   0549             ;
1176   0549             ; if element is 00h pause for a while
1177   0549             ;
1178   0549 FE 00               CP    00H
1179   054B C2 5B 05            JP    NZ,STEP1
1180   054E 01 00 10            LD    BC,1000H
1181   0551 0B          PAUSE   DEC   BC
1182   0552 78                  LD    A,B
1183   0553 B1                  OR    C
1184   0554 C2 51 05            JP    NZ,PAUSE       ;loop until DE = 0
1185   0557 13                  INC   DE             ;point to next element
1186   0558 C3 46 05            JP    STEP
1187   055B             ;
1188   055B             ; if element is 1EH repeat tune
1189   055B             ;
1190   055B FE 1E       STEP1   CP    1EH
1191   055D C2 65 05            JP    NZ,STEP2
1192   0560 D1                  POP   DE             ;get table address back
1193   0561 D5                  PUSH  DE             ;save it for later
1194   0562 C3 46 05            JP    STEP
1195   0565             ;
1196   0565             ; if element is 1FH return
1197   0565             ;
1198   0565 FE 1F       STEP2   CP    1FH            ;end of tune table?
1199   0567 C2 70 05            JP    NZ,STEP3
1200   056A E1                  POP   HL
1201   056B E1                  POP   HL
1202   056C D1                  POP   DE
1203   056D C1                  POP   BC
1204   056E F1                  POP   AF
1205   056F C9                  RET
1206   0570             ;
1207   0570             ; now play the note
1208   0570             ;
1209   0570 47          STEP3   LD    B,A            ;save element in B
1210   0571 21 8C 05            LD    HL,PERIOD      ;point to period/2 table
1211   0574 CD 01 05            CALL  INDEXB         ;get period/2
1212   0577 7E                  LD    A,(HL)         ;get element
1213   0578 F5                  PUSH  AF             ;save for later
1214   0579 78                  LD    A,B            ;get element back in a
1215   057A 21 A4 05            LD    HL,LENGTH      ;point to duration/2 table
1216   057D CD 01 05            CALL  INDEXB         ;get duration/2
1217   0580 7E                  LD    A,(HL)         ;get element
1218   0581 6F                  LD    L,A
1219   0582 26 00               LD    H,0            ;hl = duration/2
1220   0584 F1                  POP   AF
1221   0585 CD BD 05            CALL  TONE           ;do note routine
1222   0588 13                  INC   DE
1223   0589 C3 46 05            JP    STEP           ;step to next element
1224   058C             ;
1225   058C             ; period/2 of note
1226   058C             ;
1227   058C 8C 83 7C 75 PERIOD  .DB 8CH,83H,7CH,75H,70H,67H,62H,5CH
1227   0590 70 67 62 5C 
1228   0594 57 52 4E 48         .DB 57H,52H,4EH,48H,45H,41H,3CH,39H
1228   0598 45 41 3C 39 
1229   059C 36 32 2F 2C         .DB 36H,32H,2FH,2CH,2AH,27H,25H,23H
1229   05A0 2A 27 25 23 
1230   05A4             ;
1231   05A4             ; note duration/2
1232   05A4             ;
1233   05A4 19 1A 1C 1D LENGTH  .DB 19H,1AH,1CH,1DH,1EH,20H,23H,25H
1233   05A8 1E 20 23 25 
1234   05AC 27 29 2C 2E         .DB 27H,29H,2CH,2EH,31H,33H,37H,3AH
1234   05B0 31 33 37 3A 
1235   05B4 3D 41 45 49         .DB 3DH,41H,45H,49H,4DH,52H,57H,5CH
1235   05B8 4D 52 57 5C 
1236   05BC 10                  .DB 10H
1237   05BD             ;
1238   05BD             ; tone routine
1239   05BD             ; adapted from Talking Electronics TEC-1
1240   05BD             ; monitor MON-1
1241   05BD             ; by John Hardy and Ken Stone
1242   05BD             ;
1243   05BD             ;--------------
1244   05BD             ; OUTPUT A TONE
1245   05BD             ;--------------
1246   05BD             ;
1247   05BD             ; entry : ACC = period/2 of note
1248   05BD             ;         HL  = duration/2 of note
1249   05BD             ; exit  : no registers modified
1250   05BD F5          TONE    PUSH  AF
1251   05BE C5                  PUSH  BC
1252   05BF D5                  PUSH  DE
1253   05C0 E5                  PUSH  HL
1254   05C1 11 01 00            LD    DE,0001H
1255   05C4 4F                  LD    C,A
1256   05C5 29                  ADD   HL,HL          ;double duration
1257   05C6 AF                  XOR   A
1258   05C7 EE 80       TONE1   XOR   80H            ;toggle speaker bit
1259   05C9 F6 40               OR    40H            ;keep D6 high
1260   05CB D3 85               OUT   (SCAN),A       ;output speaker bit
1261   05CD 41                  LD    B,C
1262   05CE C5          TONE2   PUSH  BC
1263   05CF 06 02               LD    B,02H
1264   05D1 10 FE       TONE3   DJNZ  TONE3          ;delay for period/2
1265   05D3 C1                  POP   BC
1266   05D4 10 F8               DJNZ  TONE2          ;delay for period/2
1267   05D6 ED 52               SBC   HL,DE          ;end of note?
1268   05D8 20 ED               JR    NZ,TONE1       ;do again
1269   05DA E1                  POP   HL
1270   05DB D1                  POP   DE
1271   05DC C1                  POP   BC
1272   05DD F1                  POP   AF
1273   05DE C9                  RET
1274   05DF             ;---------------
1275   05DF             ; KEY ENTRY BEEP
1276   05DF             ;---------------
1277   05DF E5          BEEP    PUSH  HL
1278   05E0 F5                  PUSH  AF
1279   05E1 21 39 3F            LD    HL,MODE
1280   05E4 CB 76               BIT   6,(HL)         ;beep enabled?
1281   05E6 28 0E               JR    Z,BEEP2        ;beep is enabled
1282   05E8             ;
1283   05E8             ; do keypress delay
1284   05E8             ;
1285   05E8 D5                  PUSH  DE            ;do a short
1286   05E9 11 01 00            LD    DE,0001H      ;delay to prevent
1287   05EC 2A 23 3F            LD    HL,(KEYTIM)   ;recognition
1288   05EF ED 52       BEEP1   SBC   HL,DE         ;of double
1289   05F1 30 FC               JR    NC,BEEP1      ;key strokes
1290   05F3 D1                  POP   DE
1291   05F4 18 10               JR    BEEP3
1292   05F6             ;
1293   05F6             ; output keypress tones
1294   05F6             ;
1295   05F6 3E 24       BEEP2   LD    A,24H
1296   05F8 21 30 00            LD    HL,0030H
1297   05FB CD BD 05            CALL  TONE           ;do first tone
1298   05FE 3E 0E               LD    A,0EH
1299   0600 21 50 00            LD    HL,0050H
1300   0603 CD BD 05            CALL  TONE           ;do second tone
1301   0606 F1          BEEP3   POP   AF
1302   0607 E1                  POP   HL
1303   0608 C9                  RET
1304   0609             ;----------------------------------------
1305   0609             ; BREAKPOINT AND SINGLE STEPPING ROUTINES
1306   0609             ;----------------------------------------
1307   0609             ; displays and modifies registers after breakpoint
1308   0609             ; (RST 38H) or single step interrupt (if hardware
1309   0609             ; attached).
1310   0609             ; insert RST 38H (FFH) in program to examine
1311   0609             ; and modify registers.
1312   0609             ;
1313   0609 E1          SSTEP   POP   HL             ;get hl back
1314   060A F5                  PUSH  AF             ;save af for later
1315   060B 22 49 3F            LD    (TMPHL),HL
1316   060E ED 53 47 3F         LD    (TMPDE),DE
1317   0612 ED 43 45 3F         LD    (TMPBC),BC
1318   0616 DD 22 4B 3F         LD    (TMPIX),IX
1319   061A FD 22 4D 3F         LD    (TMPIY),IY     ;save registers
1320   061E E1                  POP   HL             ;get af back
1321   061F 22 43 3F            LD    (TMPAF),HL     ;save AF
1322   0622 E1                  POP   HL             ;get pc return address
1323   0623 22 41 3F            LD    (TMPPC),HL     ;save PC
1324   0626 ED 73 4F 3F         LD    (TMPSP),SP     ;save stack pointer
1325   062A             ;
1326   062A             ; step through,display and edit registers
1327   062A             ;
1328   062A CD DF 05            CALL  BEEP
1329   062D 3A 3F 3F            LD    A,(REGPNT)     ;get current reg
1330   0630 E6 07               AND   7              ;make sure in limits
1331   0632 32 3F 3F            LD    (REGPNT),A     ;save it
1332   0635 CD 12 07    SSTEP1  CALL  SETREG         ;set up display buffer
1333   0638 CD AD 04            CALL  SKEYRL         ;wait for a key
1334   063B CD A0 04            CALL  SKEYIN         ;wait for key release
1335   063E 21 47 06            LD    HL,REGTBL      ;handle the key
1336   0641 CD CE 04            CALL  MENU           ;and update display
1337   0644 C3 35 06            JP    SSTEP1         ;before returning to loop
1338   0647             ;
1339   0647             ; register display key table
1340   0647             ;
1341   0647 14          REGTBL  .DB 14H
1342   0648 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
1342   064C 04 05 06 07 
1343   0650 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
1343   0654 0C 0D 0E 0F 
1344   0658 10 11 12 13         .DB 10H,11H,12H,13H
1345   065C 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1345   0660 94 06 94 06 
1346   0664 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1346   0668 94 06 94 06 
1347   066C 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1347   0670 94 06 94 06 
1348   0674 94 06 94 06         .DW REGKEY,REGKEY,REGKEY,REGKEY
1348   0678 94 06 94 06 
1349   067C BB 06 C5 06         .DW RETMON,RETPGM,INCSTP,DECSTP
1349   0680 E7 06 FC 06 
1350   0684             ;
1351   0684             ; register name characters
1352   0684             ;
1353   0684 39 73       REGNAM  .DW 7339H
1354   0686 71 77 39 7C         .DW 7771H,7C39H,5E79H
1354   068A 79 5E 
1355   068C 38 74 76 06         .DW 7438H,0676H,066EH
1355   0690 6E 06 
1356   0692 73 6D               .DW 6D73H
1357   0694             ;--------------
1358   0694             ; EDIT REGISTER
1359   0694             ;--------------
1360   0694 CD DF 05    REGKEY  CALL  BEEP
1361   0697 F5                  PUSH  AF             ;save key for later
1362   0698 3A 3F 3F            LD    A,(REGPNT)
1363   069B             ;
1364   069B             ; edit register
1365   069B             ;
1366   069B 21 41 3F            LD    HL,TMPPC
1367   069E CD 08 05            CALL  INDEXW
1368   06A1 4E                  LD    C,(HL)
1369   06A2 23                  INC   HL
1370   06A3 46                  LD    B,(HL)         ;get reg contents
1371   06A4 CB 21               SLA   C
1372   06A6 CB 10               RL    B
1373   06A8 CB 21               SLA   C
1374   06AA CB 10               RL    B
1375   06AC CB 21               SLA   C
1376   06AE CB 10               RL    B              ;shift register
1377   06B0 CB 21               SLA   C              ;four bits
1378   06B2 CB 10               RL    B              ;left and
1379   06B4 F1                  POP   AF             ;put the key
1380   06B5 B1                  OR    C              ;into the lsn
1381   06B6 4F                  LD    C,A            ;and put the
1382   06B7 70                  LD    (HL),B         ;register back
1383   06B8 2B                  DEC   HL             ;where it belongs
1384   06B9 71                  LD   (HL),C
1385   06BA C9                  RET
1386   06BB             ;------------------
1387   06BB             ; RETURN TO MONITOR
1388   06BB             ;------------------
1389   06BB CD DF 05    RETMON  CALL  BEEP
1390   06BE CD AD 04            CALL  SKEYRL
1391   06C1 FB                  EI                   ;enable interrupts again
1392   06C2 C3 85 02            JP    MAIN
1393   06C5             ;------------------
1394   06C5             ; RETURN TO PROGRAM
1395   06C5             ;------------------
1396   06C5 ED 7B 4F 3F RETPGM  LD    SP,(TMPSP)     ;put stack pointer back
1397   06C9 2A 41 3F            LD    HL,(TMPPC)     ;put return
1398   06CC E5                  PUSH  HL             ;address back on stack
1399   06CD 2A 43 3F            LD    HL,(TMPAF)
1400   06D0 E5                  PUSH  HL             ;save af reg for later
1401   06D1 FD 2A 4D 3F         LD    IY,(TMPIY)
1402   06D5 DD 2A 4B 3F         LD    IX,(TMPIX)
1403   06D9 ED 4B 45 3F         LD    BC,(TMPBC)
1404   06DD ED 5B 47 3F         LD    DE,(TMPDE)     ;restore registers
1405   06E1 F1                  POP   AF             ;restore AF
1406   06E2 2A 49 3F            LD    HL,(TMPHL)     ;restore HL
1407   06E5 FB                  EI                   ;enable interrupts
1408   06E6 C9                  RET                  ;and return to program
1409   06E7             ;----------------------
1410   06E7             ; display next register
1411   06E7             ;----------------------
1412   06E7 CD DF 05    INCSTP  CALL  BEEP
1413   06EA 3A 3F 3F            LD    A,(REGPNT)
1414   06ED FE 07               CP    7              ;end of reg table?
1415   06EF CA F7 06            jp    z,INCSP1
1416   06F2 3C                  INC   A
1417   06F3 32 3F 3F            LD    (REGPNT),A
1418   06F6 C9                  RET
1419   06F7 AF          INCSP1  XOR   A
1420   06F8 32 3F 3F            LD   (REGPNT),A
1421   06FB C9                  RET
1422   06FC             ;--------------------------
1423   06FC             ; display previous register
1424   06FC             ;--------------------------
1425   06FC CD DF 05    DECSTP  CALL  BEEP
1426   06FF 3A 3F 3F            LD    A,(REGPNT)
1427   0702 FE 00               CP    0              ;start of reg table?
1428   0704 CA 0C 07            JP    Z,DECSP1
1429   0707 3D                  DEC   A
1430   0708 32 3F 3F            LD    (REGPNT),A
1431   070B C9                  RET
1432   070C 3E 07       DECSP1  LD    A,7
1433   070E 32 3F 3F            LD    (REGPNT),A
1434   0711 C9                  RET
1435   0712             ;-----------------
1436   0712             ; display register
1437   0712             ;-----------------
1438   0712 3A 3F 3F    SETREG  LD    A,(REGPNT)
1439   0715 21 41 3F            LD    HL,TMPPC       ;start of table
1440   0718 CD 08 05            CALL  INDEXW         ;get element address
1441   071B 5E                  LD    E,(HL)
1442   071C 23                  INC   HL
1443   071D 56                  LD    D,(HL)
1444   071E EB                  EX    DE,HL          ;load register contents
1445   071F CD 07 04            CALL  DISADD
1446   0722             ;
1447   0722             ; display register name
1448   0722             ;
1449   0722 21 84 06            LD    HL,REGNAM
1450   0725 CD 08 05            CALL  INDEXW
1451   0728 7E                  LD    A,(HL)
1452   0729 32 31 3F            LD    (DISBUF+0),A
1453   072C 23                  INC   HL
1454   072D 7E                  LD    A,(HL)
1455   072E 32 32 3F            LD    (DISBUF+1),A
1456   0731 C9                  RET
1457   0732             ;------------------
1458   0732             ; function key menu
1459   0732             ;------------------
1460   0732             ; when the Fn key is pressed, Fn is displayed in the
1461   0732             ; data displays, the current address remains in the
1462   0732             ; address displays. The program then waits for a
1463   0732             ; keypress which will select 1 of 16 routines.
1464   0732             ;
1465   0732 CD 3C 03    FUNKEY  CALL  AUTRST
1466   0735 CD DF 05            CALL  BEEP
1467   0738 2A 3B 3F    FUNKY1  LD    HL,(ADRESS)
1468   073B CD 07 04            CALL  DISADD          ;disp addr to remove dp's
1469   073E 21 54 71            LD    HL,7154H        ;Fn
1470   0741 22 31 3F            LD    (DISBUF),HL     ;display Fn
1471   0744 CD AD 04            CALL  SKEYRL         ;wait for key release
1472   0747 CD A0 04    FUNKY2  CALL  SKEYIN
1473   074A 2A 15 3F            LD    HL,(FUNTBL)    ;use the menu handler
1474   074D CD CE 04            CALL  MENU           ;routine for each key
1475   0750             ;
1476   0750             ; return to main
1477   0750             ;
1478   0750 CD DF 05    CANCEL  CALL  BEEP
1479   0753 CD A3 03    CANCL1  CALL  UPDATE         ;update display buffer
1480   0756 CD AD 04            CALL  SKEYRL         ;wait for key release
1481   0759 C9                  RET
1482   075A             ;
1483   075A             ; function menu key table
1484   075A             ;
1485   075A 11          FUNLST  .DB 11H
1486   075B 00 01 02 03         .DB 00H,01H,02H,03H,04H,05H,06H,07H
1486   075F 04 05 06 07 
1487   0763 08 09 0A 0B         .DB 08H,09H,0AH,0BH,0CH,0DH,0EH,0FH
1487   0767 0C 0D 0E 0F 
1488   076B 10                  .DB 10H ;FN KEY
1489   076C 92 07 9C 07         .DW GOEXEC,INTELFN,ADDRA,ADDRB
1489   0770 86 08 98 08 
1490   0774 AA 08 00 09         .DW BLKMVE,BLKSUM,BRANCH,TRACE
1490   0778 3E 09 75 09 
1491   077C 96 09 A5 09         .DW PLAY1,PLAY2,PLAY3,SWBEEP
1491   0780 B4 09 C3 09 
1492   0784 5D 0A DE 0B         .DW SECRET,RELSQR,SCOPE,TIME
1492   0788 36 0C E5 0C 
1493   078C 8E 07               .DW FUNFUN
1494   078E             ;-----------------------
1495   078E             ; call function function
1496   078E             ;-----------------------
1497   078E 2A 2F 3F    FUNFUN  LD    HL,(FUNJMP)
1498   0791 E9                  JP    (HL)
1499   0792             ;------------------------------------------
1500   0792             ; function 0 - execute from current address
1501   0792             ;------------------------------------------
1502   0792 CD DF 05    GOEXEC  CALL  BEEP
1503   0795 CD C4 04            CALL  KEYREL
1504   0798             ;   POP HL  ;remove exec return
1505   0798 2A 3B 3F            LD    HL,(ADRESS)
1506   079B E9                  JP    (HL)           ;start execuction
1507   079C             ;------------------------------------
1508   079C             ; function 1 receive intel hex format
1509   079C             ;------------------------------------
1510   079C CD DF 05    INTELFN CALL  BEEP
1511   079F CD C4 04            CALL  KEYREL
1512   07A2 CD AB 07            CALL  INTELH
1513   07A5 C2 C9 08            JP    NZ,BLKMV1      ;show the error
1514   07A8 C3 50 07            JP    CANCEL         ;just return if all ok
1515   07AB             ;--------------------------
1516   07AB             ; INTEL hex file downloader
1517   07AB             ;--------------------------
1518   07AB AF          INTELH  XOR   A              ;clear
1519   07AC 4F                  LD    C,A            ;calculated checksum
1520   07AD             ;
1521   07AD             ; wait for the record mark ':'
1522   07AD             ;
1523   07AD CD 4C 08    WMARK   CALL  RXDATA         ;wait for the record mark
1524   07B0 FE 3A               CP    ':'            ;to be transmitted
1525   07B2 20 F9               JR    NZ,WMARK
1526   07B4             ;
1527   07B4             ; get the record length
1528   07B4             ;
1529   07B4 CD D9 07            CALL  GETBYT
1530   07B7 47                  LD    B,A            ;the number of data bytes
1531   07B8             ;
1532   07B8             ; get the address
1533   07B8             ;
1534   07B8 CD D9 07            CALL  GETBYT
1535   07BB 67                  LD    H,A            ;the address high byte
1536   07BC CD D9 07            CALL  GETBYT
1537   07BF 6F                  LD    L,A            ;the address low byte
1538   07C0             ;
1539   07C0             ; get the record type
1540   07C0             ;
1541   07C0 CD D9 07            CALL  GETBYT
1542   07C3 20 0D               JR    NZ,CKSUM       ;end of file record
1543   07C5             ;
1544   07C5             ; C=checksum
1545   07C5             ; B=number of data bytes
1546   07C5             ; HL=destination address
1547   07C5             ;
1548   07C5 CD D9 07    LBYTES  CALL  GETBYT         ;get the record bytes
1549   07C8 77                  LD    (HL),A         ;and save to RAM
1550   07C9 23                  INC   HL             ;until there are
1551   07CA 10 F9               DJNZ  LBYTES         ;no more
1552   07CC CD D2 07            CALL  CKSUM          ;checksum ok?
1553   07CF 28 DA               JR    Z,INTELH       ;checksum ok, get next record
1554   07D1 C9                  RET                  ;checksum error a>0
1555   07D2             ;
1556   07D2             ; the sum of all the bytes (except record mark )
1557   07D2             ; including the checksum equals zero
1558   07D2             ;
1559   07D2 CD D9 07    CKSUM   CALL  GETBYT
1560   07D5 79                  LD    A,C
1561   07D6 F6 00               OR    00H            ;checksum ok  a=0
1562   07D8 C9                  RET
1563   07D9             ;
1564   07D9             ; get and convert two characters to byte
1565   07D9             ;
1566   07D9 CD 4C 08    GETBYT  CALL  RXDATA         ;get the high nibble
1567   07DC CB 77               BIT   6,A            ;convert ASCII A-F
1568   07DE 28 02               JR    Z,GETBYT1      ;into lower
1569   07E0 C6 09               ADD   A,09H          ;nibble hex
1570   07E2 E6 0F       GETBYT1 AND   0FH
1571   07E4 CB 27               SLA   A
1572   07E6 CB 27               SLA   A
1573   07E8 CB 27               SLA   A
1574   07EA CB 27               SLA   A
1575   07EC 57                  LD    D,A
1576   07ED CD 4C 08            CALL  RXDATA         ;get the low nibble
1577   07F0 CB 77               BIT   6,A            ;convert ascii a-f
1578   07F2 28 02               JR    Z,GETBYT2      ;into lower
1579   07F4 C6 09               ADD   A,09H          ;nibble hex
1580   07F6 E6 0F       GETBYT2 AND   0FH
1581   07F8 B2                  OR    D              ;make a byte
1582   07F9 F5                  PUSH  AF
1583   07FA 81                  ADD   A,C            ;add to
1584   07FB 4F                  LD    C,A            ;the checksum
1585   07FC F1                  POP   AF             ;and return the received byte
1586   07FD C9                  RET
1587   07FE             ;-------------------------------
1588   07FE             ; CONVERT ASCII CHARACTER TO HEX
1589   07FE             ;-------------------------------
1590   07FE             ; converts ascii 0-9,a-f into hex lsn
1591   07FE             ;  entry : a= ascii 0-9,a-f
1592   07FE             ;  exit  : a= hex 0-f in lsn
1593   07FE             ;  a and f registers modified
1594   07FE             ;
1595   07FE CB 77       ASCHEX  BIT   6,A
1596   0800 28 02               JR    Z,ASCHX1
1597   0802 C6 09               ADD   A,09H
1598   0804 E6 0F       ASCHX1  AND   0FH
1599   0806 C9                  RET
1600   0807             ;------------------------------------
1601   0807             ; BIT BANG SERIAL PORT INITIALISATION
1602   0807             ;------------------------------------
1603   0807             ; set the serial transmit pin high so the 
1604   0807             ; host can see that we are preparing to transmit
1605   0807             ; 
1606   0807             ; entry : HL = baud rate
1607   0807             ;         HL = 0 use existing baud constant
1608   0807             ; exit  : HL preserved
1609   0807             ;       ; AF modified
1610   0807             ;
1611   0807 3E 40       SERINI  LD    A,40H
1612   0809 D3 85               OUT   (SCAN),A       ;turn off the display make serial tx high
1613   080B 06 32               LD    B,50
1614   080D CD 17 08            CALL  MSDELAY        ;wait so the host sees tx high
1615   0810 7C                  LD    A,H
1616   0811 B5                  OR    L
1617   0812 C8                  RET   Z              ;hl is zero don't update the baud rate
1618   0813 22 21 3F            LD   (BAUD),HL       ;update the baud rate
1619   0816 C9                  RET 
1620   0817             ;------------------
1621   0817             ; MILLISECOND DELAY
1622   0817             ;------------------
1623   0817             ; approx. 1 millisecond delay
1624   0817             ; 
1625   0817             ; entry : B = 1 to 255 milliseconds
1626   0817             ; exit  : B = 0
1627   0817             ;
1628   0817 C5          MSDELAY PUSH  BC             ;11T
1629   0818 06 E9               LD    B,233          ;7T
1630   081A 00          MSDEL1  NOP                  ;4T
1631   081B 10 FD               DJNZ  MSDEL1         ;NZ=13T,Z=8T
1632   081D C1                  POP   BC             ;10T
1633   081E 10 F7               DJNZ  MSDELAY        ;NZ=13T,Z=8T
1634   0820 C9                  RET                  ;10T
1635   0821             ;------------------------
1636   0821             ; SERIAL TRANSMIT ROUTINE
1637   0821             ;------------------------
1638   0821             ; transmit byte serially on DOUT
1639   0821             ;
1640   0821             ; entry : ACC = byte to transmit
1641   0821             ;  exit : no registers modified
1642   0821             ;
1643   0821 F5          TXDATA  PUSH  AF
1644   0822 C5                  PUSH  BC
1645   0823 E5                  PUSH  HL
1646   0824 2A 21 3F            LD    HL,(BAUD)
1647   0827 4F                  LD    C,A
1648   0828             ;
1649   0828             ; transmit start bit
1650   0828             ;
1651   0828 AF                  XOR   A
1652   0829 D3 85               OUT   (SCAN),A
1653   082B CD 79 08            CALL  BITIME
1654   082E             ;
1655   082E             ; transmit data
1656   082E             ;
1657   082E 06 08               LD    B,08H
1658   0830 CB 09               RRC   C
1659   0832 CB 09       NXTBIT  RRC   C              ;shift bits to D6,
1660   0834 79                  LD    A,C            ;lsb first and output
1661   0835 E6 40               AND   40H            ;them for one bit time.
1662   0837 D3 85               OUT   (SCAN),A
1663   0839 CD 79 08            CALL  BITIME
1664   083C 10 F4               DJNZ  NXTBIT
1665   083E             ;
1666   083E             ; send stop bits
1667   083E             ;
1668   083E 3E 40               LD    A,40H
1669   0840 D3 85               OUT   (SCAN),A       ;make D6 high
1670   0842 CD 79 08            CALL  BITIME         ;transmit
1671   0845 CD 79 08            CALL  BITIME         ;two stop bits
1672   0848 E1                  POP   HL
1673   0849 C1                  POP   BC
1674   084A F1                  POP   AF
1675   084B C9                  RET
1676   084C             ;-----------------------
1677   084C             ; SERIAL RECEIVE ROUTINE
1678   084C             ;-----------------------
1679   084C             ; receive serial byte from DIN
1680   084C             ;
1681   084C             ; entry : none
1682   084C             ;  exit : ACC= received byte if carry clear
1683   084C             ;
1684   084C             ; registers modified ACC and F
1685   084C             ;
1686   084C C5          RXDATA  PUSH  BC
1687   084D E5                  PUSH  HL
1688   084E             ;
1689   084E             ; wait for start bit
1690   084E             ;
1691   084E DB 86       RXDAT1  IN    A,(KEYBUF)
1692   0850 CB 7F               BIT   7,A
1693   0852 20 FA               JR    NZ,RXDAT1      ;no start bit
1694   0854             ;
1695   0854             ; detected start bit
1696   0854             ;
1697   0854 2A 21 3F            LD    HL,(BAUD)
1698   0857 CB 3C               SRL   H
1699   0859 CB 1D               RR    L              ;delay for half bit time
1700   085B CD 79 08            CALL  BITIME
1701   085E DB 86               IN    A,(KEYBUF)
1702   0860 CB 7F               BIT   7,A
1703   0862 20 EA               JR    NZ,RXDAT1      ;start bit not valid
1704   0864             ;
1705   0864             ; detected valid start bit,read in data
1706   0864             ;
1707   0864 06 08               LD    B,08H
1708   0866 2A 21 3F    RXDAT2  LD    HL,(BAUD)
1709   0869 CD 79 08            CALL  BITIME         ;delay one bit time
1710   086C DB 86               IN    A,(KEYBUF)
1711   086E CB 17               RL    A
1712   0870 CB 19               RR    C              ;shift bit into data reg
1713   0872 10 F2               DJNZ  RXDAT2
1714   0874 79                  LD    A,C
1715   0875 B7                  OR    A              ;clear carry flag
1716   0876 E1                  POP   HL
1717   0877 C1                  POP   BC
1718   0878 C9                  RET
1719   0879             ;---------------
1720   0879             ; BIT TIME DELAY
1721   0879             ;---------------
1722   0879             ; delay for one serial bit time
1723   0879             ;  entry : HL = delay time
1724   0879             ; no registers modified
1725   0879             ;
1726   0879 E5          BITIME  PUSH  HL
1727   087A D5                  PUSH  DE
1728   087B 11 01 00            LD    DE,0001H
1729   087E ED 52       BITIM1  SBC   HL,DE
1730   0880 D2 7E 08            JP    NC,BITIM1
1731   0883 D1                  POP   DE
1732   0884 E1                  POP   HL
1733   0885 C9                  RET
1734   0886             ;-----------------------------
1735   0886             ; FUNCTION 2 - ENTER ADDRESS 1
1736   0886             ;-----------------------------
1737   0886 CD DF 05    ADDRA   CALL  BEEP
1738   0889 2A 3B 3F            LD    HL,(ADRESS)    ;copy current
1739   088C 22 29 3F            LD    (BLKSRT),HL    ;address as start
1740   088F 21 00 39            LD    HL,3900H       ;address [
1741   0892 CD F2 08            CALL  SDELAY
1742   0895 C3 53 07            JP    CANCL1
1743   0898             ;-----------------------------
1744   0898             ; FUNCTION 3 - ENTER ADDRESS 2
1745   0898             ;-----------------------------
1746   0898 CD DF 05    ADDRB   CALL  BEEP
1747   089B 2A 3B 3F            LD    HL,(ADRESS)    ;copy current
1748   089E 22 2B 3F            LD    (BLKEND),HL    ;address as end
1749   08A1 21 0F 00            LD    HL,000FH       ;address ]
1750   08A4 CD F2 08            CALL  SDELAY
1751   08A7 C3 53 07            JP    CANCL1
1752   08AA             ;------------------------
1753   08AA             ; FUNCTION 4 - BLOCK MOVE
1754   08AA             ;------------------------
1755   08AA CD DF 05    BLKMVE  CALL  BEEP
1756   08AD 2A 3B 3F            LD    HL,(ADRESS)    ;COPY CURRENT
1757   08B0 22 2D 3F            LD    (BLKDST),HL    ;ADDRESS AS
1758   08B3 21 0F 39            LD    HL,390FH       ;DESTINATION
1759   08B6 CD F2 08            CALL  SDELAY
1760   08B9             ;
1761   08B9             ; calculate number of bytes to move
1762   08B9             ;
1763   08B9 2A 2B 3F            LD    HL,(BLKEND)
1764   08BC ED 5B 29 3F         LD    DE,(BLKSRT)
1765   08C0 A7                  AND   A
1766   08C1 ED 52               SBC   HL,DE
1767   08C3 23                  INC   HL             ;make move inclusive
1768   08C4 22 27 3F            LD    (COUNT),HL
1769   08C7 30 15               JR    NC,BLKMV3      ;if ok move block
1770   08C9             ;
1771   08C9             ; show error
1772   08C9             ;
1773   08C9 21 79 00    BLKMV1  LD    HL,0079H       ;show error e
1774   08CC CD DF 05    BLKMV2  CALL  BEEP
1775   08CF 22 31 3F            LD    (DISBUF),HL    ;and wait
1776   08D2 CD A0 04            CALL  SKEYIN         ;for keypress
1777   08D5 CD DF 05            CALL  BEEP
1778   08D8 CD AD 04            CALL  SKEYRL
1779   08DB C3 53 07            JP    CANCL1
1780   08DE             ;
1781   08DE             ; move block
1782   08DE             ;
1783   08DE CD E4 08    BLKMV3  CALL  MOVE
1784   08E1 C3 53 07            JP    CANCL1
1785   08E4             ;-----------
1786   08E4             ; BLOCK MOVE
1787   08E4             ;-----------
1788   08E4 ED 4B 27 3F MOVE    LD    BC,(COUNT)
1789   08E8 2A 29 3F            LD    HL,(BLKSRT)    ;start addr
1790   08EB ED 5B 2D 3F         LD    DE,(BLKDST)    ;destination addr
1791   08EF ED B0               LDIR
1792   08F1 C9                  RET
1793   08F2             ;-------------------------------
1794   08F2             ; SCAN DISPLAY UNTIL KEY RELEASE
1795   08F2             ;-------------------------------
1796   08F2 22 31 3F    SDELAY  LD    (DISBUF),HL    ;show HL
1797   08F5 06 FF               LD    B,255          ;in data displays
1798   08F7 CD 55 04    SDELY1  CALL  SCAND          ;until key
1799   08FA 10 FB               DJNZ  SDELY1         ;is released
1800   08FC CD AD 04            CALL  SKEYRL
1801   08FF C9                  RET
1802   0900             ;---------------------------
1803   0900             ;FUNCTION 5 - BLOCK CHECKSUM
1804   0900             ;---------------------------
1805   0900 CD DF 05    BLKSUM  CALL  BEEP
1806   0903 21 6D 39            LD    HL,396DH       ;cs
1807   0906 CD F2 08            CALL  SDELAY         ;show prompt
1808   0909 ED 5B 29 3F         LD    DE,(BLKSRT)
1809   090D 2A 2B 3F            LD    HL,(BLKEND)
1810   0910 A7                  AND   A
1811   0911 ED 52               SBC   HL,DE
1812   0913 23                  INC   HL             ;make checksum inclusive
1813   0914 22 27 3F            LD    (COUNT),HL
1814   0917 30 03               JR    NC,BLKSM1      ;if ok sum block
1815   0919             ;
1816   0919             ; show error
1817   0919             ;
1818   0919 C3 C9 08            JP    BLKMV1
1819   091C             ;
1820   091C             ; calculate checksum
1821   091C             ;
1822   091C 2A 29 3F    BLKSM1  LD    HL,(BLKSRT)
1823   091F ED 5B 2B 3F         LD    DE,(BLKEND)
1824   0923 CD F1 04            CALL  CHKSUM         ;do the checksum,
1825   0926 CD 1C 04            CALL  DISBYT         ;display
1826   0929 2A 27 3F            LD    HL,(COUNT)     ;number of bytes
1827   092C CD 07 04            CALL  DISADD         ;summed and
1828   092F CD DF 05            CALL  BEEP
1829   0932 CD A0 04            CALL  SKEYIN         ;checksum until
1830   0935 CD DF 05            CALL  BEEP           ;a key is pressed
1831   0938 CD AD 04            CALL  SKEYRL
1832   093B C3 53 07            JP    CANCL1
1833   093E             ;----------------------------------------
1834   093E             ; FUNCTION 6 - RELATIVE BRANCH CALCULATOR
1835   093E             ;----------------------------------------
1836   093E CD DF 05    BRANCH  CALL  BEEP
1837   0941 21 7C 50            LD    HL,507CH       ;'rb'
1838   0944 CD F2 08            CALL  SDELAY
1839   0947 2A 3B 3F            LD    HL,(ADRESS)    ;get current address
1840   094A ED 5B 29 3F         LD    DE,(BLKSRT)
1841   094E 13                  INC   DE             ;point to PC+2
1842   094F A7                  AND   A
1843   0950 ED 52               SBC   HL,DE          ;subtract
1844   0952             ;
1845   0952             ; test high byte of result to
1846   0952             ; determine if backward branch
1847   0952             ;
1848   0952 7C                  LD    A,H
1849   0953 FE FF               CP    255            ;backward branch?
1850   0955 C2 60 09            JP    NZ,BRNCH1      ;check if forward
1851   0958             ;
1852   0958             ; check if we have branched beyond -128
1853   0958             ;
1854   0958 7D                  LD    A,L
1855   0959 CB 7F               BIT   7,A
1856   095B 20 0E               JR    NZ,BRNCH2      ;branch is within limits
1857   095D C3 C9 08            JP    BLKMV1         ;too far back
1858   0960             ;
1859   0960             ; test high byte of result to
1860   0960             ; determine if forward branch
1861   0960             ;
1862   0960 FE 00       BRNCH1  CP    0              ;forward branch?
1863   0962 C2 C9 08            JP    NZ,BLKMV1      ;too far in any direction
1864   0965             ;
1865   0965             ; check if we have branched beyond +128
1866   0965             ;
1867   0965 7D                  LD    A,L
1868   0966 CB 7F               BIT   7,A
1869   0968 C2 C9 08            JP    NZ,BLKMV1      ;too far forward
1870   096B             ;
1871   096B             ; within limits, put in RAM
1872   096B             ; and show as current address
1873   096B             ;
1874   096B 2A 29 3F    BRNCH2  LD    HL,(BLKSRT)
1875   096E 22 3B 3F            LD    (ADRESS),HL
1876   0971 77                  LD    (HL),A
1877   0972 C3 53 07            JP    CANCL1
1878   0975             ;-----------------------------------------
1879   0975             ; FUNCTION 7 - TOGGLE HARDWARE SINGLE STEP
1880   0975             ;-----------------------------------------
1881   0975 CD DF 05    TRACE   CALL  BEEP
