2579   0E25 CA BB 0D            JP    Z,SETCK1
2580   0E28 3A 1D 3F            LD    A,(SWREG4)
2581   0E2B FE 01               CP    01H            ;is the day monday?
2582   0E2D 20 02               JR    NZ,SETCK7
2583   0E2F 3E 08               LD    A,08H          ;set sunday
