2454   0D65 3A 20 3F    UPDBF2  LD    A,(SWREG7)
2455   0D68 CD 25 04            CALL  CONBYT
2456   0D6B 22 31 3F            LD    (DISBUF),HL    ;show year (0-99)
2457   0D6E             ;
2458   0D6E             ; check mode for dd/mm/yy or mm/dd/yy
2459   0D6E             ;
2460   0D6E 21 17 3F            LD    HL,CALMDE
2461   0D71 CB 7E               BIT   7,(HL)
2462   0D73 20 14               JR    NZ,UPDBF3      ;mm/dd/yy mode
2463   0D75             ;
2464   0D75             ; dd/mm/yy mode
2465   0D75             ;
