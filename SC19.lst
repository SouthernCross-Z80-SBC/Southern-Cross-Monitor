2590   0E3B CD C4 04            CALL  KEYREL
2591   0E3E 3A 1C 3F            LD    A,(SWREG3)
2592   0E41 E6 3F               AND   3FH            ;24 hour mode
2593   0E43 32 1C 3F            LD    (SWREG3),A
2594   0E46 3A 1D 3F            LD    A,(SWREG4)
2595   0E49 E6 07               AND   07H            ;osc on,rst enabled
2596   0E4B 32 1D 3F            LD    (SWREG4),A
