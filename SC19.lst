2146   0BCB             ; SEPARATE BYTE INTO TWO NIBBLES
2147   0BCB             ;-------------------------------
2148   0BCB             ; separates a byte into two
2149   0BCB             ; right justified nibbles
2150   0BCB             ; entry : ACC = byte to be separated
2151   0BCB             ; exit  : H = MSN
2152   0BCB             ;         L = LSN
2153   0BCB             ;
2154   0BCB F5          SPLIT   PUSH  AF
2155   0BCC C5                  PUSH  BC
2156   0BCD 47                  LD    B,A            ;save byte
