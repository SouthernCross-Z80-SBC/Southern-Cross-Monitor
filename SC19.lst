2591   0E3B CD C4 04            CALL  KEYREL
2592   0E3E 3A 1C 3F            LD    A,(SWREG3)
2593   0E41 E6 3F               AND   3FH            ;24 hour mode
2594   0E43 32 1C 3F            LD    (SWREG3),A
2595   0E46 3A 1D 3F            LD    A,(SWREG4)
2596   0E49 E6 07               AND   07H            ;osc on,rst enabled
2597   0E4B 32 1D 3F            LD    (SWREG4),A
2598   0E4E CD DC 0E            CALL  WWATCH         ;write changes
2599   0E51 C9                  RET
2600   0E52             ;---------------------
2601   0E52             ; READ FROM SMARTWATCH
2602   0E52             ;---------------------
2603   0E52             ; reads data from smartwatch, uses lookup table to
2604   0E52             ; write 64 bit access code to enable the smartwatch.
2605   0E52             ; reads all data into registers as ram cannot be read
2606   0E52             ; or written to while watch is enabled.
2607   0E52             ;
2608   0E52             ;  entry : none
2609   0E52             ;  exit  : no working registers modified
2610   0E52             ;          (alternate set modified)
2611   0E52             ;  contents of smartwatch written to swreg0 - swreg7
2612   0E52             ;
2613   0E52             ;
2614   0E52             ; enable smartwatch
2615   0E52             ;
2616   0E52 F5          RWATCH  PUSH  AF
2617   0E53 C5                  PUSH  BC
2618   0E54 D5                  PUSH  DE
2619   0E55 E5                  PUSH  HL
2620   0E56 3A 60 3F            LD    A,(SWATCH)     ;initiate pattern
2621   0E59 21 9C 0E            LD    HL,PATERN      ;write d0 of all the bytes
2622   0E5C 06 40               LD    B,64           ;in the table to the ram to
2623   0E5E 7E          RWACH1  LD    A,(HL)         ;enable the smartwatch
2624   0E5F 32 60 3F            LD    (SWATCH),A
2625   0E62 23                  INC   HL
2626   0E63 10 F9               DJNZ  RWACH1
2627   0E65             ;
2628   0E65             ; read data from watch
2629   0E65             ;
2630   0E65 06 20               LD    B,32
2631   0E67 3A 60 3F    RWACH2  LD    A,(SWATCH)     ;shift the first 32 bits
2632   0E6A CB 3F               SRL   A              ;into the 16 bit registers
2633   0E6C CB 1A               RR    D              ;de and hl
2634   0E6E CB 1B               RR    E              ;then exchange them with
2635   0E70 CB 1C               RR    H              ;the alternate pair
2636   0E72 CB 1D               RR    L
2637   0E74 10 F1               DJNZ  RWACH2
2638   0E76 D9                  EXX
2639   0E77 06 20               LD    B,32
2640   0E79 3A 60 3F    RWACH3  LD    A,(SWATCH)     ;now shift the last 32 bits
2641   0E7C CB 3F               SRL   A              ;into the same 16 bit registers
2642   0E7E CB 1A               RR    D
2643   0E80 CB 1B               RR    E
2644   0E82 CB 1C               RR    H
2645   0E84 CB 1D               RR    L
2646   0E86 10 F1               DJNZ  RWACH3
2647   0E88             ;
2648   0E88             ; save in watch registers
2649   0E88             ;
