0363   0200             ;------------------------------
0364   0200             ; POWER UP RESET / MANUAL RESET
0365   0200             ;------------------------------
0366   0200                     .ORG    0200H
0367   0200             ;
0368   0200             ; wait for smart socket
0369   0200             ; to recover from power down
0370   0200             ;
0371   0200 3E 55       RESET   LD    A,55H
0372   0202 32 60 3F            LD    (SWATCH),A     ;write to RAM
0373   0205 AF                  XOR   A
0374   0206 D3 84               OUT   (DISPLY),A     ;write nothing to
0375   0208 D3 85               OUT   (SCAN),A       ;on board IO
0376   020A DB 86               IN    A,(KEYBUF)     ;to help debugging
0377   020C 3A 60 3F            LD    A,(SWATCH)     ;read from RAM
0378   020F FE 55               CP    55H            ;is it ready?
0379   0211 C2 00 02            JP    NZ,RESET       ;keep trying
0380   0214             ;
0381   0214             ; load stack pointer
0382   0214             ;
0383   0214 31 00 3E    RESET1  LD    SP,ISTACK      ;initialise monitor stack pointer
0384   0217 ED 56               IM    1              ;set interrupt mode 1 - use the automated interrupt
0385   0219             ;
0386   0219             ; set up restart vectors
0387   0219             ;
0388   0219 21 21 08            LD    HL,TXDATA      ;bit-banged serial transmit
0389   021C 22 51 3F            LD    (RST08),HL
0390   021F 21 4C 08            LD    HL,RXDATA      ;bit-banged serial receive (blocking)
0391   0222 22 53 3F            LD    (RST10),HL
0392   0225 21 74 00            LD    HL,RETURN
0393   0228 22 55 3F            LD    (RST18),HL
0394   022B 22 57 3F            LD    (RST20),HL
0395   022E 22 59 3F            LD    (RST28),HL
0396   0231 21 6B 00            LD    HL,NMIRET
0397   0234 22 5D 3F            LD    (RST66),HL     ;NMI vector
0398   0237 21 09 06            LD    HL,SSTEP       ;single stepper interrupt
0399   023A 22 5B 3F            LD    (RST38),HL     ;INT vector
0400   023D 21 F3 00            LD    HL,STOP
0401   0240 22 61 3F            LD    (SYSERR),HL    ;invalid system call error
0402   0243             ;
0403   0243             ; perform checksum on user RAM
0404   0243             ;
0405   0243 21 00 20            LD    HL,RAMSRT      ;start of user RAM
0406   0246 11 00 3D            LD    DE,RAMEND      ;end of user RAM
0407   0249 CD F1 04            CALL  CHKSUM
0408   024C 32 5F 3F            LD    (RAMSUM),A     ;RAM checksum
0409   024F             ;
0410   024F             ; set up default variables
0411   024F             ;
0412   024F 21 5A 07            LD    HL,FUNLST
0413   0252 22 15 3F            LD    (FUNTBL),HL    ;function key table
0414   0255 2A A0 00            LD    HL,(FN2VEC)    ;Fn Fn default vector
0415   0258 22 2F 3F            LD    (FUNJMP),HL    ;fn fn jump
0416   025B AF                  XOR   A
0417   025C 32 3F 3F            LD    (REGPNT),A     ;init single stepper
0418   025F 32 39 3F            LD    (MODE),A       ;start with speaker on
0419   0262             ;
0420   0262 21 0B 00            LD    HL,B9600       ;default baud rate
0421   0265 CD 07 08            CALL  SERINI         ;initialise the serial port
0422   0268             ;
0423   0268             ; initialise display scan variables
0424   0268             ;
0425   0268 21 00 01            LD    HL,0100H
0426   026B 22 3D 3F            LD    (KEYDEL),HL    ;auto-inc/dec delay
0427   026E 21 00 10            LD    HL,1000H
0428   0271 22 23 3F            LD    (KEYTIM),HL    ;delay time instead of a beep
0429   0274             #IFDEF 74C923
0430   0274 3E 20               LD    A,20H
0431   0276~            #ELSE
0432   0276~                    LD    A,08H
0433   0276             #ENDIF
0434   0276 32 38 3F            LD    (OFTIM),A      ;display off time
0435   0279             
0436   0279 CD DF 05            CALL  BEEP
0437   027C CD DF 05            CALL  BEEP
0438   027F             
0439   027F             ; initialise the 'display on' time
0440   027F             #IFDEF 74C923
0441   027F 3E 08               LD    A,08H
0442   0281~            #ELSE
0443   0281~                    LD    A,10H
0444   0281             #ENDIF
0445   0281 32 37 3F            LD    (ONTIM),A      ;display on time
0446   0284                 
0447   0284 FB                  EI                   ;enable interrupts
