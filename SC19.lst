2496   0DB1 09                  ADD   HL,BC          ;and setting the
2497   0DB2 CB FE               SET   7,(HL)         ;decimal point
2498   0DB4 C9          UPDBF5  RET                  ;in that display
2499   0DB5             ;--------------
2500   0DB5             ; SET TIME/DATE
2501   0DB5             ;--------------
2502   0DB5 CD DF 05    SETCLK  CALL  BEEP
2503   0DB8 CD C4 04            CALL  KEYREL
2504   0DBB             ;
2505   0DBB             ; edit the display buffer
2506   0DBB             ;
2507   0DBB CD 3D 0D    SETCK1  CALL  UPDBUF         ;update display buffer
2508   0DBE CD A0 04            CALL  SKEYIN
2509   0DC1 CD C4 04            CALL  KEYREL
2510   0DC4 FE 10               CP    10H            ;Fn key exits (no change)
2511   0DC6 C8                  RET Z
2512   0DC7 FE 11               CP    11H            ;Ad key sets clock/calendar
2513   0DC9 28 6D               JR    Z,SETCK8
2514   0DCB FE 12               CP    12H
2515   0DCD 28 3D               JR    Z,SETCK4       ;plus key
2516   0DCF FE 13               CP    13H
2517   0DD1 28 4E               JR    Z,SETCK6       ;minus key
2518   0DD3 FE 0A               CP    0AH            ;no A-F keys
2519   0DD5 30 E4               JR    NC,SETCK1
2520   0DD7             ;
2521   0DD7             ; is it set clock or set calendar?
2522   0DD7             ;
2523   0DD7 DD CB 01 7E         BIT   7,(IX+1)
2524   0DDB 20 0D               JR    NZ,SETCK2
2525   0DDD             ;
2526   0DDD             ; set clock display
2527   0DDD             ;
2528   0DDD 21 1A 3F            LD    HL,SWREG1
2529   0DE0 ED 6F               RLD                   ;move the new key
2530   0DE2 23                  INC   HL              ;into the clock buffer
2531   0DE3 ED 6F               RLD
2532   0DE5 23                  INC   HL
2533   0DE6 ED 6F               RLD
2534   0DE8 18 D1               JR    SETCK1
2535   0DEA             ;
2536   0DEA             ; set calendar display
2537   0DEA             ;
