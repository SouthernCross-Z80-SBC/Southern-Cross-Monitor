0713+  1663             ;
0714+  1663             ;        entry:  HL = character buffer address
0715+  1663             ;        exit :  HL = points to last character+1, a zero terminator
0716+  1663             ;
0717+  1663             ;
0718+  1663 C5          BITASC  PUSH  BC
0719+  1664 06 08               LD    B,08H          ;look at all 8 bits
0720+  1666 CB 7F       BTASC1  BIT   7,A            ;a 1 or a 0?
0721+  1668 20 05               JR    NZ,BTASC3
0722+  166A 0E 30               LD    C,30H          ;it's a zero
0723+  166C 71          BTASC2  LD    (HL),C
0724+  166D 18 03               JR    BTASC4
0725+  166F 0E 31       BTASC3  LD    C,31H          ;it's a one
0726+  1671 71                  LD    (HL),C
0727+  1672 23          BTASC4  INC   HL
0728+  1673 17                  RLA
0729+  1674 10 F0               DJNZ  BTASC1         ;next bit
0730+  1676 C1                  POP   BC
0731+  1677 C9                  RET
0732+  1678             ;-----------------------------------------
0733+  1678             ; print an-inline, zero terminated string
0734+  1678             ;-----------------------------------------
0735+  1678             ; put the string in the code like the example below
0736+  1678             ; the routine sends the string from the subroutine return address,to the zero terminator,
0737+  1678             ; then jumps to the next instruction address to resume the program. 
0738+  1678             ;
0739+  1678             ;      CALL ILPSZ
0740+  1678             ;      .DB  "STRING TO PRINT",0
0741+  1678             ;      NEXT INSTRUCTION
0742+  1678             ;
0743+  1678 E1          ILPSZ   POP   HL             ;return address is start of string
0744+  1679 7E          ILPSZ1  LD    A,(HL)         ;get character
0745+  167A 23                  INC   HL             ;point to next character
0746+  167B B7                  OR    A
0747+  167C CA 84 16            JP    Z,ILPSZ2       ;return if char = 0
0748+  167F CD 21 08            CALL  TXDATA         ;send it
0749+  1682 18 F5               JR    ILPSZ1         ;and do it again
0750+  1684 E9          ILPSZ2  JP    (HL)           ;return to address after zero terminator
0751+  1685             ;
0752+  1685             ;DISASSEMBLER
0753+  1685             ;
0754+  1685             #include "DIS-Z80.asm"
0001++ 1685             ; ====================
0002++ 1685             ; DIS-Z80 was published in the SUBSET column of Personal Computer World 1987.
0003++ 1685             ; The routine disassembles a single Z80 instruction at address DE. 
0004++ 1685             ; It is required to be followed by a routine called CHROP that outputs a 
0005++ 1685             ; single ASCII character.
0006++ 1685             ; It was originally developed for CP/M on an Amstrad CPC128.
0007++ 1685             
0008++ 1685             ; The original ORG was $0100. I have added $5000 to all addresses.
0009++ 1685             ; The stated aim was to write a Z80 disassembly routine in as short a space
0010++ 1685             ; as possible and, at just over 1K (1090 bytes), it is a rather incredible 
0011++ 1685             ; program. 
0012++ 1685             
0013++ 1685             ; The SUBSET editor David Barrow was able to trim only one byte from John 
0014++ 1685             ; Kerr's compact code. I've forgotten where so there's a challenge.
0015++ 1685             ; ====================
0016++ 1685             
0017++ 1685             ; STRUCTURAL CONCEPTS
0018++ 1685             ; DATA
0019++ 1685             ;
0020++ 1685             ; Disassembled line:
0021++ 1685             ;		field 1: instruction 1st byte location (5 cols).
0022++ 1685             ;		field 2: instruction bytes (12 cols).
0023++ 1685             ;		field 3: mnemonic (5 cols).
0024++ 1685             ;		field 4: operand(s) (13 cols).
0025++ 1685             ;
0026++ 1685             ; Location address	: ASCII hex (4 digits).
0027++ 1685             ; Instruction bytes	: ASCII hex (2 digits sequence).
0028++ 1685             ; Operand data &	: ASCII hex with appended "H" if >9,
0029++ 1685             ;	addresses		:	and preceeding "0" if 1st digit >9.
0030++ 1685             ; Operand offsets	: signed decimal, linked "+" or "-".
0031++ 1685             
0032++ 1685             ; PROGRAM DETAILS
0033++ 1685             ;
0034++ 1685             ; INPUT				DE addresses 1st byte of instruction to disassemble.
0035++ 1685             ; OUTPUT			35 character disassembled line to output device.
0036++ 1685             ; STATE CHANGES		DE updated to address 1st byte of next instruction.
0037++ 1685             ;					AF BC HL changed.
0038++ 1685             ; I/O ERRORS		None.
0039++ 1685             ; OPTIMISATION		Not given.
0040++ 1685             ; INTERRUPT EFFECT	May be interrupted and re-entered.
0041++ 1685             ; LOCATION NEEDS	Not specific. Not relocatable. PROMable.
0042++ 1685             ;					(Listing in this datasheet is assembled at 0100H)
0043++ 1685             ; PROGRAM BYTES		695: code 206 + referenced tables:-
0044++ 1685             ;						GROUP2 (27), GROUP1 (168), GROUP3 (86),
0045++ 1685             ;						MONICS (208).
0046++ 1685             ; STACK BYTES		46 maximum.
0047++ 1685             ; CLOCK CYCLES		Not given.
0048++ 1685             
0049++ 1685             
0050++ 1685 CD AC 1A    DISASM	CALL 	ADRSP		; Output the source pointer.
0051++ 1688             
0052++ 1688 01 00 09           	LD 	BC,$0900		; Create an 18-byte output
0053++ 168B 21 20 20           	LD 	HL,$2020	; buffer in the stack area.
0054++ 168E             FILBUF
0055++ 168E E5                  PUSH    HL			; Buffer initially contains
0056++ 168F 10 FD               DJNZ    FILBUF		; 18 ASCII spaces (20H).
0057++ 1691             
0058++ 1691 60                 	LD 	H,B				; Copy SP into HL, so the
0059++ 1692 69                 	LD 	L,C				; first byte of the output
0060++ 1693 39                 	ADD 	HL,SP		; buffer is addressed by HL.
0061++ 1694             
0062++ 1694 C5                 	PUSH 	BC			; Save original IX and
0063++ 1695 DD E3              	EX 	(SP),IX			; initialize to zero.
0064++ 1697 C5                 	PUSH 	BC			; Initialize temp storage
0065++ 1698 C5                 	PUSH 	BC			; (workspace) to all zeros.
0066++ 1699 DD 39              	ADD 	IX,SP		; Point IX to workspace.
0067++ 169B             
0068++ 169B E5                 	PUSH 	HL			; Save buffer pointer; point
0069++ 169C 21 16 18           	LD 	HL,GROUP3		; to "ED" instruction group.
0070++ 169F             
0071++ 169F CD A1 1A    TRYNDX	CALL 	FETCH		; Fetch a byte of code.
0072++ 16A2             
0073++ 16A2 41                 	LD 	B,C				; First check whether this
0074++ 16A3 FE ED              	CP 	$ED				; is an "ED" instruction.
0075++ 16A5 28 0A              	JR 	Z,CONFLG		; Yes; clear the index flag.
0076++ 16A7             
0077++ 16A7 04                 	INC 	B			; Ready to set flag to "1"
0078++ 16A8 FE DD              	CP 	$DD				; if the byte is 0DDH (an
0079++ 16AA 28 05              	JR 	Z,CONFLG		; instruction using IX).
0080++ 16AC             
0081++ 16AC 04                 	INC 	B			; Ready to set flag to "2"
0082++ 16AD FE FD              	CP 	$FD				; if the byte is 0FDH (an
0083++ 16AF 20 08              	JR 	NZ,NOTNDX		; instruction using IY).
0084++ 16B1             
0085++ 16B1 DD 70 01    CONFLG	LD 	(IX+1),B		; Condition the index flag.
0086++ 16B4 04                 	INC 	B			; Repeat index tests if the
0087++ 16B5 10 E8              	DJNZ 	TRYNDX		; pre-byte was 0DDH or 0FDH.
0088++ 16B7 18 2A              	JR 	NXBYTE			; Otherwise continue.
0089++ 16B9             
0090++ 16B9 4F          NOTNDX	LD 	C,A				; Save byte; check if index
0091++ 16BA DD 7E 01           	LD 	A,(IX+1)		; flag was set (Allows any
0092++ 16BD B7                 	OR 	A				; series of 0DDH and/or OFDH
0093++ 16BE 28 18              	JR 	Z,NODISP		; bytes, as per Zilog spec).
0094++ 16C0             
0095++ 16C0 79                 	LD 	A,C				; If so, check for presence
0096++ 16C1 FE CB              	CP 	$CB				; of any displacement.
0097++ 16C3 28 0D              	JR 	Z,GETDIS		; 0CBH needs a displacement.
0098++ 16C5             
0099++ 16C5 E6 44              	AND 	$44			; A displacement is required
0100++ 16C7 FE 04              	CP 	4				; if opcode has bit 2 set
0101++ 16C9 28 07              	JR 	Z,GETDIS		; and bit 6 reset.
0102++ 16CB             
0103++ 16CB 79                 	LD 	A,C				; A displacemnet is required
0104++ 16CC E6 C0              	AND 	$C0			; if opcode has bit 6 set
0105++ 16CE FE 40              	CP 	$40				; and bit 7 reset.
0106++ 16D0 20 06              	JR 	NZ,NODISP
0107++ 16D2             
0108++ 16D2 CD A1 1A    GETDIS	CALL 	FETCH		; Get displacement if needed
0109++ 16D5 DD 77 02           	LD 	(IX+2),A		; and save it in workspace.
0110++ 16D8             
0111++ 16D8 21 6E 17    NODISP	LD 	HL,GROUP1		; "Main" instruction gorup.
0112++ 16DB 79                 	LD 	A,C				; Recover opcode & check
0113++ 16DC FE CB              	CP 	$CB				; for OCBH ("bit" group).
0114++ 16DE 20 07              	JR 	NZ,NEWMSK		; No; start the search.
0115++ 16E0             
0116++ 16E0 21 53 17           	LD 	HL,GROUP2		; Yes; point to "CB" group.
0117++ 16E3             
0118++ 16E3 CD A1 1A    NXBYTE	CALL 	FETCH		; Fetch the last non-data
0119++ 16E6 4F                 	LD 	C,A				; byte and store it in C.
0120++ 16E7             
0121++ 16E7 7E          NEWMSK	LD 	A,(HL)			; Fetch a mask from table.
0122++ 16E8 B7                 	OR 	A				; Mask value of 0 indicates
0123++ 16E9 28 16              	JR 	Z,TABEND		; end of table; quit search.
0124++ 16EB             
0125++ 16EB A1                 	AND 	C			; Otherwise mask the opcode
0126++ 16EC 23                 	INC 	HL			; and address the mode byte.
0127++ 16ED             
0128++ 16ED 46          NEWMOD	LD 	B,(HL)			; Fetch the mode byte in B.
0129++ 16EE 23                 	INC 	HL			; Point to the match byte.
0130++ 16EF 04                 	INC 	B			; Test if the mode is 0FFH
0131++ 16F0 28 F5              	JR 	Z,NEWMSK		; and if so, get a new mak.
0132++ 16F2             
0133++ 16F2 BE          TRYMAT	CP 	(HL)			; Is the masked opcode
0134++ 16F3 23                 	INC 	HL			; equal to the match byte?
0135++ 16F4 28 07              	JR 	Z,GETNDX		; Stop searching if it is.
0136++ 16F6             
0137++ 16F6 CB 7E              	BIT 	7,(HL)		; index byte bit 7 is set if
0138++ 16F8 23                 	INC 	HL			; address mode changes.
0139++ 16F9 28 F7              	JR 	Z,TRYMAT		; No change; try next match.
0140++ 16FB             
0141++ 16FB 18 F0              	JR 	NEWMOD			; Change; get a new mode.
0142++ 16FD             
0143++ 16FD 7E          GETNDX	LD 	A,(HL)			; Matched: fetch mnemonic
0144++ 16FE E6 7F              	AND 	$7F			; index, mask bit 7, and
0145++ 1700 05                 	DEC 	B			; restore the mode byte.
0146++ 1701             
0147++ 1701 E1          TABEND	POP 	HL			; Save the source pointer
0148++ 1702 D5                 	PUSH 	DE			; below the output buffer
0149++ 1703 E5                 	PUSH 	HL			; pointer on stack.
0150++ 1704             
0151++ 1704 EB                 	EX 	DE,HL			; Point HL to start of the
0152++ 1705 21 6C 18           	LD 	HL,MONICS		; mnemonics table.
0153++ 1708 CD 8C 1A           	CALL 	XTRACT		; Copy mnemonic to buffer.
0154++ 170B             
0155++ 170B E1                 	POP 	HL			; Restore output pointer
0156++ 170C 11 05 00           	LD 	DE,5			; and adjust to align
0157++ 170F 19                 	ADD 	HL,DE		; any operands present.
0158++ 1710 D1                 	POP 	DE			; Restore source pointer.
0159++ 1711             
0160++ 1711 78                 	LD 	A,B				; Test high-order B to see
0161++ 1712 E6 F0              	AND 	$F0			; if any "first" operand
0162++ 1714 28 13              	JR 	Z,SECOND		; is present.
0163++ 1716             
0164++ 1716 1F                 	RRA					; Yes; move the operand
0165++ 1717 1F                 	RRA					; index into the lower
0166++ 1718 1F                 	RRA					; half of A.
0167++ 1719 1F                 	RRA					; Then save
0168++ 171A C5                 	PUSH 	BC			; operand and opcode.
0169++ 171B             
0170++ 171B 47                 	LD 	B,A				; Operand index in B.
0171++ 171C 79                 	LD 	A,C				; Restore opcode to A.
0172++ 171D CD 3C 19           	CALL 	OPRND1		; Process the operand.
0173++ 1720             
0174++ 1720 C1                 	POP 	BC			; Restore the operand byte
0175++ 1721 78                 	LD 	A,B				; and opcode; test
0176++ 1722 E6 0F              	AND 	$0F			; low-order B for any
0177++ 1724 28 0B              	JR 	Z,OPDONE		; "second" operand.
0178++ 1726             
0179++ 1726 36 2C              	LD 	(HL),44  		; Opearnd index in B.
0180++ 1728 23                 	INC 	HL			; Restore opcode to A.
0181++ 1729             
0182++ 1729 78          SECOND	LD 	A,B				; Check for the presence
0183++ 172A E6 0F              	AND 	$0F			; of a "second" operand.
0184++ 172C             
0185++ 172C 47                 	LD 	B,A				; Operand index in B.
0186++ 172D 79                 	LD 	A,C				; Restore opcode to A.
0187++ 172E C4 42 19           	CALL 	NZ,OPRND2	; Process any operand.
0188++ 1731             
0189++ 1731 3E 03       OPDONE	LD 	A,3				; Check how many bytes
0190++ 1733 DD 96 00           	SUB 	(IX+0)		; have been fetched.
0191++ 1736             
0192++ 1736 E1                 	POP 	HL			; Discard workspace.
0193++ 1737 E1                 	POP 	HL
0194++ 1738 DD E1              	POP 	IX			; Restore index register.
0195++ 173A             
0196++ 173A 38 0C              	JR 	C,OUTEXT		; 4 or more bytes fetched.
0197++ 173C             
0198++ 173C 3C                 	INC 	A			; Less than four bytes
0199++ 173D 47                 	LD 	B,A				; fetched; so output
0200++ 173E 80                 	ADD 	A,B			; enough spaces to
0201++ 173F 80                 	ADD 	A,B			; align the mnemonics.
0202++ 1740 47                 	LD 	B,A
0203++ 1741             
0204++ 1741 3E 20       SPACES	LD 	A,$20			; Output spaces
0205++ 1743 CD C8 1A           	CALL 	CHROP		; to start of
0206++ 1746 10 F9              	DJNZ 	SPACES		; mnemonic field.
0207++ 1748                    	
0208++ 1748 06 12       OUTEXT	LD 	B,18			; Set buffer byte count.
0209++ 174A             
0210++ 174A 3B          PUTOUT	DEC 	SP			; Copy stored text, byte
0211++ 174B E1                 	POP 	HL			; at a time, from output
0212++ 174C 7C                 	LD 	A,H				; buffer on stack to
0213++ 174D CD C8 1A           	CALL 	CHROP		; the output channel.
0214++ 1750 10 F8              	DJNZ 	PUTOUT
