2115   0B8B CD 86 04            CALL  CLRBUF         ;display
2116   0B8E DD 6E 0B            LD    L,(IX+11)
2117   0B91 DD 66 0C            LD    H,(IX+12)      ;the random number
2118   0B94 CD 07 04            CALL  DISADD         ;and play
2119   0B97 21 C4 0B            LD    HL,LOSE        ;the lose
2120   0B9A C3 AB 0B            JP    CHKKYA         ;music
