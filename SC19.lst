0017   0000             ;
0018   0000             ; 16 bit multiply from Zaks 'Programming the Z80'
0019   0000             ; Music and sound code from
0020   0000             ; Talking Electronics TEC-1 monitor, MON-1
0021   0000             ; by John Hardy and Ken Stone
0022   0000             ;
0023   0000             ; if defined use the 74C923 keyboard encoder else use software scanning
0024   0000             #DEFINE 74C923
0025   0000             ;
0026   0000             ;---------------
0027   0000             ; RAM MEMORY MAP
0028   0000             ;---------------
0029   0000             BOTRAM  .EQU  2000H          ;bottom of SRAM
0030   0000             TOPRAM  .EQU  3FFFH          ;top of SRAM
0031   0000             ;
0032   0000             VARBLS  .EQU  TOPRAM-0FFH    ;monitor variables
0033   0000             BUFFER  .EQU  VARBLS-0100H   ;general purpose buffer area
0034   0000             ISTACK  .EQU  BUFFER         ;allow 256 byte stack
0035   0000             ;
0036   0000             RAMEND  .EQU  ISTACK-0100H   ;end of user RAM
0037   0000             RAMSRT  .EQU  BOTRAM         ;start of user RAM
0038   0000             ;
0039   0000             ; I/O port addresses
0040   0000             ;
0041   0000             IO0     .EQU  80H            ;IO port 0
0042   0000             IO1     .EQU  81H            ;IO port 1
0043   0000             IO2     .EQU  82H            ;IO port 2
0044   0000             IO3     .EQU  83H            ;IO port 3
0045   0000             DISPLY  .EQU  84H            ;display latch
0046   0000             SCAN    .EQU  85H            ;display scan latch
0047   0000             KEYBUF  .EQU  86H            ;keyboard buffer
0048   0000             IO7     .EQU  87H            ;spare IO address
0049   0000             ;
0050   0000             ; Bit-Bang Baud rate constants
0051   0000             ;
0052   0000             B300    .EQU  0220H          ;300 baud
0053   0000             B1200   .EQU  0080H          ;1200 baud
0054   0000             B2400   .EQU  003FH          ;2400 baud
0055   0000             B4800   .EQU  001BH          ;4800 baud
0056   0000             B9600   .EQU  000BH          ;9600 baud
0057   0000             ;
0058   0000             ; key codes
0059   0000             ;
0060   0000             KEYFN   .EQU  10H            ;Fn or Go key
0061   0000             KEYAD   .EQU  11H            ;Address key
0062   0000             KEYINC  .EQU  12H            ;Plus key
0063   0000             KEYDEC  .EQU  13H            ;Minus key
0064   0000             
0065   0000             ;-------------------------
0066   0000             ; MONITOR GLOBAL VARIABLES
0067   0000             ;-------------------------
0068   0000             ;
0069   3F00                 .ORG    VARBLS
0070   3F00             ;
0071   3F00             VARIDX  .DS   16             ;reserve some space for indexed variables
0072   3F10             SPSAVE  .DS   2              ;save the stack pointer
0073   3F12             ADDR    .DS   2              ;temp address
0074   3F14             DATA    .DS   1              ;temp data @ address
0075   3F15             ;
0076   3F15             FUNTBL  .DS   2              ;Fn table address
0077   3F17             ;
0078   3F17             ; DALLAS SMARTWATCH REGISTERS
0079   3F17             ;
0080   3F17             CALMDE  .DS   2              ;calendar mode
0081   3F19             SWREG0  .DS   1              ;10ths, 100ths
0082   3F1A             SWREG1  .DS   1              ;seconds
0083   3F1B             SWREG2  .DS   1              ;minutes
0084   3F1C             SWREG3  .DS   1              ;hours
0085   3F1D             SWREG4  .DS   1              ;day
0086   3F1E             SWREG5  .DS   1              ;date
0087   3F1F             SWREG6  .DS   1              ;month
0088   3F20             SWREG7  .DS   1              ;year
0089   3F21             ;
0090   3F21             BAUD    .DS   2              ;bit bang baud rate
0091   3F23             KEYTIM  .DS   2              ;beep delay
0092   3F25             SPTEMP  .DS   2              ;temp system call SP
0093   3F27             ;
0094   3F27             ; BLOCK FUNCTIONS
0095   3F27             ;
0096   3F27             COUNT   .DS   2              ;number of bytes to move
0097   3F29             BLKSRT  .DS   2              ;block start address
0098   3F2B             BLKEND  .DS   2              ;block end address
0099   3F2D             BLKDST  .DS   2              ;destination address
0100   3F2F             ;
0101   3F2F             FUNJMP  .DS   2              ;Fn Fn key jump address
0102   3F31             ;
0103   3F31             ; DISPLAY SCAN REGISTERS
0104   3F31             ;
0105   3F31             DISBUF  .DS   6              ;display buffer
0106   3F37             ONTIM   .DS   1              ;display scan on time
0107   3F38             OFTIM   .DS   1              ;display scan off time
0108   3F39             ;
0109   3F39             ; MONITOR VARIABLES
0110   3F39             ;
0111   3F39             ;
0112   3F39             ;MODE
0113   3F39             ; B7 = Address= 0 / Data= 1
0114   3F39             ; B6 = Beep enabled= 1
0115   3F39             ; B5 = Auto-increment data entry state
0116   3F39             ;
0117   3F39             MODE    .DS   2              ;display mode
0118   3F3B             ADRESS  .DS   2              ;user address
0119   3F3D             KEYDEL  .DS   2              ;auto increment delay
0120   3F3F             ;
0121   3F3F             ; SINGLE STEPPER TEMPORARY REGISTER STORAGE
0122   3F3F             ;
0123   3F3F             REGPNT  .DS   2   ;register pointer
0124   3F41             TMPPC   .DS   2   ;program counter PC
0125   3F43             TMPAF   .DS   2   ;AF accumulator,flag
0126   3F45             TMPBC   .DS   2   ;BC register pair
0127   3F47             TMPDE   .DS   2   ;DE register pair
0128   3F49             TMPHL   .DS   2   ;HL register pair
0129   3F4B             TMPIX   .DS   2   ;index register X
0130   3F4D             TMPIY   .DS   2   ;index register Y
0131   3F4F             TMPSP   .DS   2   ;stack pointer SP
0132   3F51             ;
0133   3F51             ; RESTART JUMP TABLE AND HARWARE TEST
0134   3F51             ;
0135   3F51             RST08   .DS   2   ;restart 08h jump
0136   3F53             RST10   .DS   2   ;restart 10h jump
0137   3F55             RST18   .DS   2   ;restart 18h jump
0138   3F57             RST20   .DS   2   ;restart 20h jump
0139   3F59             RST28   .DS   2   ;restart 28h jump
0140   3F5B             RST38   .DS   2   ;int interrupt jump
0141   3F5D             RST66   .DS   2   ;nmi interrupt jump
0142   3F5F             RAMSUM  .DS   1   ;user ram checksum
0143   3F60             SWATCH  .DS   1   ;smartwatch access and ram test location
0144   3F61             SYSERR  .DS   2   ;system call error jump
0145   3F63             BRKADD  .DS   2   ;break address
0146   3F65             ;----------------
0147   3F65             ; RESTART VECTORS
0148   3F65             ;----------------
0149   3F65             ;
0150   3F65             ; Restart 00H - RST 0
0151   3F65             ; when power is applied to the Southern Cross
0152   3F65             ; the Z80 starts executing instructions from here
0153   3F65             ;
0154   0000                     .ORG  0000H
0155   0000 C3 00 02    RSTVEC  JP    RESET
0156   0003             ;
0157   0003             ; Restart 08H - RST 1
0158   0003             ;
0159   0008                     .ORG  0008H
0160   0008 E5                  PUSH  HL             ;save HL to restore later
0161   0009 2A 51 3F            LD    HL,(RST08)     ;load the vector from RAM
0162   000C E5                  PUSH  HL             ;and save this jump address
0163   000D 18 5F               JR    CALLJMP
0164   000F             ;
0165   000F             ; Restart 10H - RST 2
0166   000F             ;
0167   0010                     .ORG  0010H
0168   0010 E5                  PUSH  HL
0169   0011 2A 53 3F            LD    HL,(RST10)
0170   0014 E5                  PUSH  HL
0171   0015 18 57               JR    CALLJMP
0172   0017             ;
0173   0017             ; Restart 18H - RST 3
0174   0017             ;
0175   0018                     .ORG  0018H
0176   0018 E5                  PUSH  HL
0177   0019 2A 55 3F            LD    HL,(RST18)
0178   001C E5                  PUSH  HL
0179   001D 18 4F               JR    CALLJMP
0180   001F             ;
0181   001F             ; Restart 20H - RST 4
0182   001F             ;
0183   0020                     .ORG  0020H
0184   0020 E5                  PUSH  HL
0185   0021 2A 57 3F            LD    HL,(RST20)
0186   0024 E5                  PUSH  HL
0187   0025 18 47               JR    CALLJMP
0188   0027             ;
0189   0027             ; Restart 28H - RST 5
0190   0027             ;
0191   0028                     .ORG  0028H
0192   0028 E5                  PUSH  HL
0193   0029 2A 59 3F            LD    HL,(RST28)
0194   002C E5                  PUSH  HL
0195   002D 18 3F               JR    CALLJMP
0196   002F             ;
0197   002F             ; Restart 30H - RST 6 - Monitor routines entry point
0198   002F             ;
0199   0030                     .ORG  0030H
0200   0030 C3 D0 00    RST30   JP    SYSCALL
0201   0033             ;
0202   0033             ; Restart 38H - RST 7
0203   0033             ; if interrupts are enabled,and an int occurs- 
0204   0033             ; further interrupts are disabled, 
0205   0033             ; the program counter is pushed onto the stack, 
0206   0033             ; and execution starts here
0207   0033             ;
0208   0038                     .ORG  0038H
0209   0038 E5                  PUSH  HL
0210   0039 2A 5B 3F            LD    HL,(RST38)
0211   003C E9                  JP    (HL)
0212   003D             ;
0213   003D             INTRET
0214   003D E1                  POP     HL
0215   003E ED 4D               RETI                 ;return from int
0216   0040             ;
0217   0040             ; Restart 66H NMI vector
0218   0040             ; same as above but NMI cannot be disabled.
0219   0040             ;
0220   0066                     .ORG    0066H
0221   0066 E5                  PUSH    HL
0222   0067 2A 5D 3F            LD      HL,(RST66)
0223   006A E9                  JP      (HL)
0224   006B             ;
0225   006B             NMIRET
0226   006B E1                  POP     HL
0227   006C ED 45               RETN                ;return from NMI
0228   006E             ;
0229   006E             ; jump to the address on the stack and set the RETurn address
0230   006E             CALLJMP
0231   006E 21 73 00            LD    HL,RSTRET     ;get the return address
0232   0071 E3                  EX    (SP),HL       ;exchange the jump and return address
0233   0072 E9                  JP    (HL)          ;jump to the subroutine
0234   0073             ;
0235   0073             ; return from restart
0236   0073             ; restart calls return here
0237   0073             RSTRET
0238   0073 E1                  POP   HL            ;get HL back and return
0239   0074 C9          RETURN  RET
0240   0075             ;
0241   0075             ; Fn Fn default vector
0242   0075             ;
0243   00A0                     .ORG  00A0H
0244   00A0 00 00       FN2VEC  .DW   0000H
0245   00A2             ;--------------------
0246   00A2             ; SYSTEM CALL HANDLER
0247   00A2             ;--------------------
0248   00A2             ; calls to basic IO and other routines
0249   00A2             ; within the monitor have been assigned
0250   00A2             ; system call numbers to avoid re-writing
0251   00A2             ; user software if monitor absolute addresses
0252   00A2             ; change in subsequent monitors
0253   00A2             ;
0254   00A2             ; Entry : c = call number
0255   00A2             ; see routines for entry and exit parameters
0256   00A2             ;
0257   00D0                     .ORG  00D0H
0258   00D0 3B          SYSCALL DEC   SP
0259   00D1 3B                  DEC   SP            ;leave space for syscall
0260   00D2 ED 73 25 3F         LD    (SPTEMP),SP   ;points to syscall lo
0261   00D6 F5                  PUSH  AF
0262   00D7 D5                  PUSH  DE
0263   00D8 E5                  PUSH  HL            ;save registers
0264   00D9 79                  LD    A,C           ;get call number
0265   00DA E6 7F               AND   127           ;ensure in limits
0266   00DC CB 27               SLA   A             ;multiply by two
0267   00DE 26 01               LD    H,1           ;load jump table high byte
0268   00E0 6F                  LD    L,A           ;load index
0269   00E1 7E                  LD    A,(HL)
0270   00E2 23                  INC   HL
0271   00E3 56                  LD    D,(HL)        ;get jump address
0272   00E4 2A 25 3F            LD    HL,(SPTEMP)   ;point to syscall lo
0273   00E7 77                  LD    (HL),A        ;put syscall lo on stack
0274   00E8 23                  INC   HL
0275   00E9 7A                  LD    A,D
0276   00EA 77                  LD    (HL),A        ;put syscall hi on stack
0277   00EB E1                  POP   HL
0278   00EC D1                  POP   DE
0279   00ED F1                  POP   AF            ;restore registers
0280   00EE C9                  RET                 ;jumps to system call
0281   00EF             ;
0282   00EF             ; Error trap
0283   00EF             ; halt the machine until Reset or Interrupt
0284   00EF             ;
0285   00EF 2A 61 3F    TRAP    LD    HL,(SYSERR)
0286   00F2 E9                  JP    (HL)
0287   00F3             ;
0288   00F3 76          STOP    HALT
0289   00F4             ;-----------------------
0290   00F4             ; SYSTEM CALL JUMP TABLE
0291   00F4             ;-----------------------
0292   0100                     .ORG    0100H
0293   0100             SYSJMP
0294   0100 85 02               .DW   MAIN           ;0 restart monitor
0295   0102 E4 03               .DW   VERS           ;1 return software version number
0296   0104 07 04               .DW   DISADD         ;2 covert address to seven segment code in display buffer
0297   0106 1C 04               .DW   DISBYT         ;3 convert data to seven segment code in display buffer
0298   0108 86 04               .DW   CLRBUF         ;4 clear the seven segment display buffer
0299   010A 55 04               .DW   SCAND          ;5 scan the seven segment displays
0300   010C 25 04               .DW   CONBYT         ;6 convert a byte into seven segment code
0301   010E 32 04               .DW   CONVHI         ;7 convert the high nibble into seven segment code
0302   0110             ;
0303   0110 36 04               .DW   CONVLO         ;8 convert the low nibble into seven segment code
0304   0112 A0 04               .DW   SKEYIN         ;9 scan the display until key press
0305   0114 AD 04               .DW   SKEYRL         ;10 scan the display until key release
0306   0116 BA 04               .DW   KEYIN          ;11 wait for a key press
0307   0118 C4 04               .DW   KEYREL         ;12 wait for key release
0308   011A CE 04               .DW   MENU           ;13 menu handler
0309   011C F1 04               .DW   CHKSUM         ;14 calculate 8 bit checksum
0310   011E 29 05               .DW   MUL16          ;15 16 bit multiply
0311   0120             ;
0312   0120 11 05               .DW   RAND           ;16 random number generator
0313   0122 01 05               .DW   INDEXB         ;17 8 bit index look up table to an 8 bit byte
0314   0124 08 05               .DW   INDEXW         ;18 8 bit index look up table to a 16 bit word
0315   0126 40 05               .DW   MUSIC          ;19 music sequencer
0316   0128 BD 05               .DW   TONE           ;20 output a tone
0317   012A DF 05               .DW   BEEP           ;21 key entry beep
0318   012C C4 0C               .DW   SKATE          ;22 scan 8x8 display
0319   012E 21 08               .DW   TXDATA         ;23 serial bit bang transmit
0320   0130             ;
0321   0130 4C 08               .DW   RXDATA         ;24 serial bit bang receive
0322   0132 FE 07               .DW   ASCHEX         ;25 convert ASCII character to hexadecimal
0323   0134 DC 0E               .DW   WWATCH         ;26 write to smartwatch
0324   0136 52 0E               .DW   RWATCH         ;27 read from smartwatch
0325   0138 3C 0F               .DW   ONESEC         ;28 smartwatch one second delay 40
0326   013A F3 0B               .DW   RLSTEP         ;29 relay board sequencer
0327   013C 20 0C               .DW   DELONE         ;30 one second delay
0328   013E 95 04               .DW   SCANKEY        ;31 scan the keyboard for a key press
0329   0140             ;
0330   0140 AB 07               .DW   INTELH         ;32 receive INTEL hex file
0331   0142 CB 0B               .DW   SPLIT          ;33 separate a byte into two right justidied nibbles
0332   0144 EF 00               .DW   TRAP           ;34
0333   0146 EF 00               .DW   TRAP           ;35
0334   0148 EF 00               .DW   TRAP           ;36
0335   014A EF 00               .DW   TRAP           ;37
0336   014C EF 00               .DW   TRAP           ;38
0337   014E DD 03               .DW   PCBTYP         ;39 return PCB type SC
0338   0150             ;
0339   0150 EF 00               .DW   TRAP           ;40
0340   0152 EB 03               .DW   KBDTYP         ;41 return keyboard type 74c923 or software scanned
0341   0154 A3 03               .DW   UPDATE         ;42 update the display buffer
0342   0156 D9 03               .DW   VARRAM         ;43 return variable base address
0343   0158 07 08               .DW   SERINI         ;44 initialise bit bang serial
0344   015A EF 00               .DW   TRAP           ;45
0345   015C 17 08               .DW   MSDELAY        ;46 millisecond delay
0346   015E EF 00               .DW   TRAP           ;47
0347   0160             ;
