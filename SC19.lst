2335   0CB5             ;
2336   0CB5             ; seed the first quadrant with random bits
2337   0CB5             ;
2338   0CB5 47          SEED    LD    B,A            ;put the
2339   0CB6 E6 0F               AND   0FH            ;random number
2340   0CB8 77                  LD    (HL),A         ;into the
2341   0CB9 23                  INC   HL             ;first quadrant
2342   0CBA 78                  LD    A,B            ;of the
2343   0CBB E6 F0               AND   240            ;display
2344   0CBD 1F                  RRA
2345   0CBE 1F                  RRA
2346   0CBF 1F                  RRA
2347   0CC0 1F                  RRA
