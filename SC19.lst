2651   0E8B ED 53 1F 3F         LD    (SWREG6),DE    ;get the data
2652   0E8F D9                  EXX
2653   0E90 22 19 3F            LD    (SWREG0),HL
2654   0E93 ED 53 1B 3F         LD    (SWREG2),DE
2655   0E97 E1                  POP HL
2656   0E98 D1                  POP DE
2657   0E99 C1                  POP BC
2658   0E9A F1                  POP AF
2659   0E9B C9                  RET
2660   0E9C             ;
2661   0E9C             ; smartwatch access pattern
2662   0E9C             ;
2663   0E9C C5 E2 71 B8 PATERN  .DB 0C5H,0E2H,71H,0B8H,5CH,2EH,17H,8BH
2663   0EA0 5C 2E 17 8B 
2664   0EA4 3A 1D 8E 47         .DB 3AH,1DH,8EH,47H,0A3H,0D1H,0E8H,74H
2664   0EA8 A3 D1 E8 74 
2665   0EAC A3 D1 E8 74         .DB 0A3H,0D1H,0E8H,74H,3AH,1DH,8EH,47H
2665   0EB0 3A 1D 8E 47 
2666   0EB4 5C 2E 17 8B         .DB 5CH,2EH,17H,8BH,0C5H,0E2H,71H,0B8H
2666   0EB8 C5 E2 71 B8 
2667   0EBC C5 E2 71 B8         .DB 0C5H,0E2H,71H,0B8H,5CH,2EH,17H,8BH
2667   0EC0 5C 2E 17 8B 
2668   0EC4 3A 1D 8E 47         .DB 3AH,1DH,8EH,47H,0A3H,0D1H,0E8H,74H
2668   0EC8 A3 D1 E8 74 
2669   0ECC A3 D1 E8 74         .DB 0A3H,0D1H,0E8H,74H,3AH,1DH,8EH,47H
2669   0ED0 3A 1D 8E 47 
2670   0ED4 5C 2E 17 8B         .DB 5CH,2EH,17H,8BH,0C5H,0E2H,71H,0B8H
2670   0ED8 C5 E2 71 B8 
2671   0EDC             ;--------------------
2672   0EDC             ; WRITE TO SMARTWATCH
2673   0EDC             ;--------------------
2674   0EDC             ;
2675   0EDC             ; write data to smartwatch by first accessing
2676   0EDC             ; it using bit manipulation.
2677   0EDC             ; data is written by firstly putting all 64 bits
2678   0EDC             ; into registers as ram cannot be accessed once the
2679   0EDC             ; smartwatch is enabled.
2680   0EDC             ;
2681   0EDC             ; entry : none
2682   0EDC             ; the data to write to the smartwatch
2683   0EDC             ; must be in swreg0 - swreg7
2684   0EDC             ;  exit : no working registers modified
2685   0EDC             ; (alternate set modified)
2686   0EDC             ; get data to write to watch
2687   0EDC             ;
2688   0EDC F5          WWATCH  PUSH  AF
2689   0EDD C5                  PUSH  BC
2690   0EDE D5                  PUSH  DE
2691   0EDF E5                  PUSH  HL
2692   0EE0 2A 1D 3F            LD    HL,(SWREG4)    ;set up the
2693   0EE3 ED 5B 1F 3F         LD    DE,(SWREG6)    ;16 bit registers
2694   0EE7 D9                  EXX
2695   0EE8 2A 19 3F            LD    HL,(SWREG0)    ;with the data to be
2696   0EEB ED 5B 1B 3F         LD    DE,(SWREG2)    ;written to the smartwatch
2697   0EEF             ;
2698   0EEF             ; write 64 bit access code to enable smartwatch
2699   0EEF             ;
2700   0EEF 3A 60 3F            LD    A,(SWATCH)     ;initiate pattern
2701   0EF2 3E C5               LD    A,0C5H
2702   0EF4 0E 80               LD    C,80H          ;number of bytes
2703   0EF6 06 80       WWACH1  LD    B,80H          ;number of bits
2704   0EF8 32 60 3F    WWACH2  LD    (SWATCH),A     ;write to ram
2705   0EFB CB 0F               RRC   A
2706   0EFD CB 38               SRL   B
2707   0EFF 30 F7               JR    NC,WWACH2      ;more bits
2708   0F01 CB 39               SRL   C
2709   0F03 38 11               JR    C,WWACH4       ;no more bytes
2710   0F05 CB 47               BIT   0,A
2711   0F07 20 0A               JR    NZ,WWACH3
2712   0F09 CB 0F               RRC   A
2713   0F0B CB 0F               RRC   A
2714   0F0D CB 0F               RRC   A
2715   0F0F CB 0F               RRC   A
2716   0F11 18 E3               JR    WWACH1
2717   0F13 2F          WWACH3  CPL
2718   0F14 18 E0               JR    WWACH1
