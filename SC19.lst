2170   0BDE             ;-----------------------------------
2171   0BDE CD DF 05    RELSQR  CALL  BEEP
2172   0BE1 CD C4 04            CALL  KEYREL
2173   0BE4 21 ED 0B            LD    HL,RLTEST      ;point to test sequence
2174   0BE7 CD F3 0B            CALL  RLSTEP
