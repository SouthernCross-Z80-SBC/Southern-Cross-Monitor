0210++ 1743 3B          PUTOUT	DEC 	SP			; Copy stored text, byte
0211++ 1744 E1                 	POP 	HL			; at a time, from output
0212++ 1745 7C                 	LD 	A,H				; buffer on stack to
0213++ 1746 CD C1 1A           	CALL 	CHROP		; the output channel.
