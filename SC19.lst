2181   0BF3             ;----------------
2182   0BF3             ; RELAY SEQUENCER
2183   0BF3             ;----------------
2184   0BF3             ; sequences relays on relay board
2185   0BF3             ; uses two bytes to specify output data and delay time
2186   0BF3             ; delay time byte also determines if sequence is to stop
2187   0BF3             ; or repeat.
2188   0BF3             ;  table:
2189   0BF3             ;  <byte1>,<byte2>
2190   0BF3             ;  byte1 = data to go to output latch (uses port IO1)
2191   0BF3             ;  byte2 = FF - repeat
2192   0BF3             ;          00 - finished
2193   0BF3             ;  entry : HL points to table of output data
2194   0BF3             ;  exit : none modified
2195   0BF3             ;
2196   0BF3 F5          RLSTEP  PUSH  AF
2197   0BF4 C5                  PUSH  BC
2198   0BF5 D5                  PUSH  DE
2199   0BF6 E5                  PUSH  HL             ;save registers
2200   0BF7 E5                  PUSH  HL
2201   0BF8 EB                  EX    DE,HL          ;get address of data
2202   0BF9             ;
2203   0BF9 1A          RELSR1  LD    A,(DE)
2204   0BFA 4F                  LD    C,A            ;get output data
2205   0BFB 13                  INC   DE
2206   0BFC 1A                  LD    A,(DE)         ;get time delay
2207   0BFD FE 00               CP    0
2208   0BFF 28 16               JR    Z,RELSR4       ;end of sequence
2209   0C01 FE FF               CP    255
2210   0C03 28 0D               JR    Z,RELSR3       ;repeat sequence
2211   0C05 47                  LD    B,A
2212   0C06 79                  LD    A,C
2213   0C07 D3 81               OUT   (IO1),A
2214   0C09 13                  INC   DE
