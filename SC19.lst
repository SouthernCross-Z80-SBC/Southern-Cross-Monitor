0382++ 193C             ;		D					16-bit register
0383++ 193C             ;		E					Address in 16-bit register
0384++ 193C             ;		F					Index register
0385++ 193C             ;
0386++ 193C             ; PROGRAM DETAILS
0387++ 193C             ; INPUT
0388++ 193C             ;					A = opcode.
0389++ 193C             ;					B = operand index.
0390++ 193C             ;					DE addresses next instruction byte.
0391++ 193C             ;					HL addresses next free byte in output buffer.
0392++ 193C             ;					(IX+0) = no. of instruction bytes fetched.
0393++ 193C             ;					(IX+1) = index register flag (1=IX, 2=IY, else 0).
0394++ 193C             ;					(IX+2) = displacement for any indexed instruction.
0395++ 193C             ;
0396++ 193C             ; OUTPUT			Operand is in output buffer.
0397++ 193C             ;					DE and HL are updated.
0398++ 193C             ; STATE CHANGES		AF BC are changed.
