2056   0B26 CD CB 0B            CALL  SPLIT          ;number into
2057   0B29 DD 75 00            LD    (IX+0),L       ;four nibbles
2058   0B2C DD 74 01            LD    (IX+1),H       ;to make checking
2059   0B2F DD 7E 09            LD    A,(IX+9)       ;against the
2060   0B32 CD CB 0B            CALL  SPLIT          ;guess easier
2061   0B35 DD 75 02            LD    (IX+2),L
2062   0B38 DD 74 03            LD    (IX+3),H
2063   0B3B             ;
2064   0B3B             ; check for correct number,correct spot
2065   0B3B             ;
2066   0B3B AF                  XOR   A
2067   0B3C DD 77 0A            LD    (IX+10),A      ;clear result
2068   0B3F 21 04 3F            LD    HL,VARIDX+4    ;point to random
2069   0B42 11 00 3F            LD    DE,VARIDX      ;point to guess
2070   0B45 06 04               LD    B,4            ;number of digits
2071   0B47 7E          CHKKY2  LD    A,(HL)         ;get random
2072   0B48 EB                  EX    DE,HL
2073   0B49 BE                  CP    (HL)           ;same as guess?
2074   0B4A 20 10               JR    NZ,CHKKY4      ;not same
2075   0B4C DD 7E 0A            LD    A,(IX+10)
