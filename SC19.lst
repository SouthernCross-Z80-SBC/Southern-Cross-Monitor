2284   0C61 77                  LD    (HL),A         ;into the second
2285   0C62 CB 46       SCOPE4  BIT   0,(HL)         ;and third quadrants.
2286   0C64 CA 69 0C            JP    Z,SCOPE5       ;checking if the
2287   0C67 CB FE               SET   7,(HL)         ;bits in the LSN are
2288   0C69 CB 4E       SCOPE5  BIT   1,(HL)         ;set, and setting the
