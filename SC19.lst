2545   0DF4 ED 6F               RLD                  ;move the new key
2546   0DF6 2B                  DEC HL               ;into the cal buffer
2547   0DF7 ED 6F               RLD
2548   0DF9 2B                  DEC HL
2549   0DFA ED 6F               RLD
2550   0DFC 18 BD               JR  SETCK1
2551   0DFE             ;
2552   0DFE             ; set calendar as mm/dd/yy
2553   0DFE             ;
