0381++ 1935             ;		C					I or R
0382++ 1935             ;		D					16-bit register
0383++ 1935             ;		E					Address in 16-bit register
0384++ 1935             ;		F					Index register
0385++ 1935             ;
0386++ 1935             ; PROGRAM DETAILS
0387++ 1935             ; INPUT
0388++ 1935             ;					A = opcode.
0389++ 1935             ;					B = operand index.
0390++ 1935             ;					DE addresses next instruction byte.
0391++ 1935             ;					HL addresses next free byte in output buffer.
0392++ 1935             ;					(IX+0) = no. of instruction bytes fetched.
0393++ 1935             ;					(IX+1) = index register flag (1=IX, 2=IY, else 0).
0394++ 1935             ;					(IX+2) = displacement for any indexed instruction.
0395++ 1935             ;
0396++ 1935             ; OUTPUT			Operand is in output buffer.
0397++ 1935             ;					DE and HL are updated.
0398++ 1935             ; STATE CHANGES		AF BC are changed.
0399++ 1935             ;					IX IY (IX+0,1,2) are unchanged.
