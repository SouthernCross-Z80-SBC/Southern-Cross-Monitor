2386   0CE5             ; FUNCTION F - CLOCK CALENDAR
2387   0CE5             ;----------------------------
2388   0CE5 CD DF 05    TIME    CALL  BEEP
2389   0CE8 CD C4 04            CALL  KEYREL         ;wait for key release
2390   0CEB DD 21 00 3F         LD    IX,VARIDX      ;use IX for temp variables
2391   0CEF 3A 37 3F            LD    A,(ONTIM)
