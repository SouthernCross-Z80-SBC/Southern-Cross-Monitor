2177   0BED             ; test sequence
2178   0BED             ;
2179   0BED 55 01 AA 01 RLTEST  .DB 55H,01H,0AAH,01H,00H,0FFH
2179   0BF1 00 FF 
2180   0BF3             ;----------------
2181   0BF3             ; RELAY SEQUENCER
2182   0BF3             ;----------------
2183   0BF3             ; sequences relays on relay board
2184   0BF3             ; uses two bytes to specify output data and delay time
2185   0BF3             ; delay time byte also determines if sequence is to stop
2186   0BF3             ; or repeat.
2187   0BF3             ;  table:
2188   0BF3             ;  <byte1>,<byte2>
2189   0BF3             ;  byte1 = data to go to output latch (uses port IO1)
2190   0BF3             ;  byte2 = FF - repeat
2191   0BF3             ;          00 - finished
2192   0BF3             ;  entry : HL points to table of output data
2193   0BF3             ;  exit : none modified
2194   0BF3             ;
2195   0BF3 F5          RLSTEP  PUSH  AF
2196   0BF4 C5                  PUSH  BC
2197   0BF5 D5                  PUSH  DE
2198   0BF6 E5                  PUSH  HL             ;save registers
2199   0BF7 E5                  PUSH  HL
2200   0BF8 EB                  EX    DE,HL          ;get address of data
2201   0BF9             ;
2202   0BF9 1A          RELSR1  LD    A,(DE)
2203   0BFA 4F                  LD    C,A            ;get output data
2204   0BFB 13                  INC   DE
2205   0BFC 1A                  LD    A,(DE)         ;get time delay
2206   0BFD FE 00               CP    0
2207   0BFF 28 16               JR    Z,RELSR4       ;end of sequence
2208   0C01 FE FF               CP    255
2209   0C03 28 0D               JR    Z,RELSR3       ;repeat sequence
2210   0C05 47                  LD    B,A
2211   0C06 79                  LD    A,C
2212   0C07 D3 81               OUT   (IO1),A
2213   0C09 13                  INC   DE
2214   0C0A CD 20 0C    RELSR2  CALL  DELONE         ;1 sec delay
2215   0C0D 10 FB               DJNZ  RELSR2         ;more seconds to go
2216   0C0F C3 F9 0B            JP    RELSR1
2217   0C12             ;
2218   0C12             ; repeat
2219   0C12             ;
2220   0C12 D1          RELSR3  POP   DE             ;get start address
2221   0C13 D5                  PUSH  DE             ;save for later
2222   0C14 C3 F9 0B            JP    RELSR1
2223   0C17             ;
2224   0C17             ; finished
2225   0C17             ;
2226   0C17 AF          RELSR4  XOR   A
2227   0C18 D3 81               OUT   (IO1),A        ;clear output reg
2228   0C1A E1                  POP   HL
2229   0C1B E1                  POP   HL
2230   0C1C D1                  POP   DE
2231   0C1D C1                  POP   BC
2232   0C1E F1                  POP   AF
2233   0C1F C9                  RET
2234   0C20             ;-----------------
2235   0C20             ; ONE SECOND DELAY
2236   0C20             ;-----------------
2237   0C20             ;
2238   0C20             ; entry : none
2239   0C20             ; exit : flag register modified
2240   0C20             ;
2241   0C20 C5          DELONE  PUSH  BC
2242   0C21 D5                  PUSH  DE
2243   0C22 E5                  PUSH  HL
2244   0C23 11 01 00            LD    DE,0001H
2245   0C26 21 70 08            LD    HL,0870H
2246   0C29 06 92       DELON1  LD    B,92H
2247   0C2B 10 FE       DELON2  DJNZ  DELON2         ;inner loop
2248   0C2D ED 52               SBC   HL,DE
2249   0C2F D2 29 0C            JP    NC,DELON1      ;outer loop
2250   0C32 E1                  POP   HL
2251   0C33 D1                  POP   DE
2252   0C34 C1                  POP   BC
2253   0C35 C9                  RET
2254   0C36             ;--------------------------
2255   0C36             ; FUNCTION E - KALEIDOSCOPE
2256   0C36             ;--------------------------
2257   0C36 CD DF 05    SCOPE   CALL  BEEP
2258   0C39 CD C4 04            CALL  KEYREL
2259   0C3C CD 11 05            CALL  RAND           ;generate random
2260   0C3F EB                  EX    DE,HL
2261   0C40 21 00 3E            LD    HL,BUFFER      ;number and set up
2262   0C43 7B                  LD    A,E            ;the first quadrant
2263   0C44 CD B5 0C            CALL  SEED           ;with a random bit
2264   0C47 7A                  LD    A,D            ;pattern
2265   0C48 CD B5 0C            CALL  SEED
2266   0C4B             ;
2267   0C4B             ; generate mirror images
2268   0C4B             ;
2269   0C4B 06 04       SCOPE2  LD    B,04H
2270   0C4D 21 00 3E            LD    HL,BUFFER
2271   0C50 11 07 3E            LD    DE,BUFFER+7
