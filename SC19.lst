2147   0BCB             ; SEPARATE BYTE INTO TWO NIBBLES
2148   0BCB             ;-------------------------------
2149   0BCB             ; separates a byte into two
2150   0BCB             ; right justified nibbles
2151   0BCB             ; entry : ACC = byte to be separated
2152   0BCB             ; exit  : H = MSN
