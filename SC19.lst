2598   0E51 C9                  RET
2599   0E52             ;---------------------
2600   0E52             ; READ FROM SMARTWATCH
2601   0E52             ;---------------------
2602   0E52             ; reads data from smartwatch, uses lookup table to
2603   0E52             ; write 64 bit access code to enable the smartwatch.
2604   0E52             ; reads all data into registers as ram cannot be read
2605   0E52             ; or written to while watch is enabled.
2606   0E52             ;
2607   0E52             ;  entry : none
2608   0E52             ;  exit  : no working registers modified
2609   0E52             ;          (alternate set modified)
2610   0E52             ;  contents of smartwatch written to swreg0 - swreg7
2611   0E52             ;
2612   0E52             ;
2613   0E52             ; enable smartwatch
2614   0E52             ;
2615   0E52 F5          RWATCH  PUSH  AF
2616   0E53 C5                  PUSH  BC
2617   0E54 D5                  PUSH  DE
2618   0E55 E5                  PUSH  HL
2619   0E56 3A 60 3F            LD    A,(SWATCH)     ;initiate pattern
2620   0E59 21 9C 0E            LD    HL,PATERN      ;write d0 of all the bytes
2621   0E5C 06 40               LD    B,64           ;in the table to the ram to
2622   0E5E 7E          RWACH1  LD    A,(HL)         ;enable the smartwatch
2623   0E5F 32 60 3F            LD    (SWATCH),A
2624   0E62 23                  INC   HL
2625   0E63 10 F9               DJNZ  RWACH1
2626   0E65             ;
2627   0E65             ; read data from watch
2628   0E65             ;
2629   0E65 06 20               LD    B,32
2630   0E67 3A 60 3F    RWACH2  LD    A,(SWATCH)     ;shift the first 32 bits
2631   0E6A CB 3F               SRL   A              ;into the 16 bit registers
2632   0E6C CB 1A               RR    D              ;de and hl
2633   0E6E CB 1B               RR    E              ;then exchange them with
2634   0E70 CB 1C               RR    H              ;the alternate pair
2635   0E72 CB 1D               RR    L
2636   0E74 10 F1               DJNZ  RWACH2
2637   0E76 D9                  EXX
2638   0E77 06 20               LD    B,32
2639   0E79 3A 60 3F    RWACH3  LD    A,(SWATCH)     ;now shift the last 32 bits
2640   0E7C CB 3F               SRL   A              ;into the same 16 bit registers
2641   0E7E CB 1A               RR    D
2642   0E80 CB 1B               RR    E
2643   0E82 CB 1C               RR    H
2644   0E84 CB 1D               RR    L
2645   0E86 10 F1               DJNZ  RWACH3
2646   0E88             ;
2647   0E88             ; save in watch registers
2648   0E88             ;
2649   0E88 22 1D 3F            LD    (SWREG4),HL    ;smartwatch read is complete
2650   0E8B ED 53 1F 3F         LD    (SWREG6),DE    ;get the data
2651   0E8F D9                  EXX
2652   0E90 22 19 3F            LD    (SWREG0),HL
2653   0E93 ED 53 1B 3F         LD    (SWREG2),DE
2654   0E97 E1                  POP HL
2655   0E98 D1                  POP DE
2656   0E99 C1                  POP BC
2657   0E9A F1                  POP AF
2658   0E9B C9                  RET
2659   0E9C             ;
2660   0E9C             ; smartwatch access pattern
2661   0E9C             ;
2662   0E9C C5 E2 71 B8 PATERN  .DB 0C5H,0E2H,71H,0B8H,5CH,2EH,17H,8BH
2662   0EA0 5C 2E 17 8B 
2663   0EA4 3A 1D 8E 47         .DB 3AH,1DH,8EH,47H,0A3H,0D1H,0E8H,74H
2663   0EA8 A3 D1 E8 74 
2664   0EAC A3 D1 E8 74         .DB 0A3H,0D1H,0E8H,74H,3AH,1DH,8EH,47H
2664   0EB0 3A 1D 8E 47 
2665   0EB4 5C 2E 17 8B         .DB 5CH,2EH,17H,8BH,0C5H,0E2H,71H,0B8H
2665   0EB8 C5 E2 71 B8 
2666   0EBC C5 E2 71 B8         .DB 0C5H,0E2H,71H,0B8H,5CH,2EH,17H,8BH
2666   0EC0 5C 2E 17 8B 
2667   0EC4 3A 1D 8E 47         .DB 3AH,1DH,8EH,47H,0A3H,0D1H,0E8H,74H
2667   0EC8 A3 D1 E8 74 
2668   0ECC A3 D1 E8 74         .DB 0A3H,0D1H,0E8H,74H,3AH,1DH,8EH,47H
2668   0ED0 3A 1D 8E 47 
2669   0ED4 5C 2E 17 8B         .DB 5CH,2EH,17H,8BH,0C5H,0E2H,71H,0B8H
2669   0ED8 C5 E2 71 B8 
2670   0EDC             ;--------------------
2671   0EDC             ; WRITE TO SMARTWATCH
2672   0EDC             ;--------------------
2673   0EDC             ;
2674   0EDC             ; write data to smartwatch by first accessing
2675   0EDC             ; it using bit manipulation.
2676   0EDC             ; data is written by firstly putting all 64 bits
2677   0EDC             ; into registers as ram cannot be accessed once the
2678   0EDC             ; smartwatch is enabled.
2679   0EDC             ;
2680   0EDC             ; entry : none
2681   0EDC             ; the data to write to the smartwatch
2682   0EDC             ; must be in swreg0 - swreg7
2683   0EDC             ;  exit : no working registers modified
2684   0EDC             ; (alternate set modified)
2685   0EDC             ; get data to write to watch
2686   0EDC             ;
2687   0EDC F5          WWATCH  PUSH  AF
2688   0EDD C5                  PUSH  BC
2689   0EDE D5                  PUSH  DE
2690   0EDF E5                  PUSH  HL
2691   0EE0 2A 1D 3F            LD    HL,(SWREG4)    ;set up the
2692   0EE3 ED 5B 1F 3F         LD    DE,(SWREG6)    ;16 bit registers
2693   0EE7 D9                  EXX
2694   0EE8 2A 19 3F            LD    HL,(SWREG0)    ;with the data to be
2695   0EEB ED 5B 1B 3F         LD    DE,(SWREG2)    ;written to the smartwatch
2696   0EEF             ;
2697   0EEF             ; write 64 bit access code to enable smartwatch
2698   0EEF             ;
2699   0EEF 3A 60 3F            LD    A,(SWATCH)     ;initiate pattern
2700   0EF2 3E C5               LD    A,0C5H
2701   0EF4 0E 80               LD    C,80H          ;number of bytes
2702   0EF6 06 80       WWACH1  LD    B,80H          ;number of bits
2703   0EF8 32 60 3F    WWACH2  LD    (SWATCH),A     ;write to ram
2704   0EFB CB 0F               RRC   A
2705   0EFD CB 38               SRL   B
2706   0EFF 30 F7               JR    NC,WWACH2      ;more bits
2707   0F01 CB 39               SRL   C
2708   0F03 38 11               JR    C,WWACH4       ;no more bytes
2709   0F05 CB 47               BIT   0,A
2710   0F07 20 0A               JR    NZ,WWACH3
2711   0F09 CB 0F               RRC   A
2712   0F0B CB 0F               RRC   A
2713   0F0D CB 0F               RRC   A
2714   0F0F CB 0F               RRC   A
2715   0F11 18 E3               JR    WWACH1
2716   0F13 2F          WWACH3  CPL
2717   0F14 18 E0               JR    WWACH1
2718   0F16             ;
2719   0F16             ; write data to watch
2720   0F16             ;
2721   0F16 06 20       WWACH4  LD    B,32           ;shift the first 32 bits
2722   0F18 CB 3A       WWACH5  SRL   D              ;out of the 16 bit registers
2723   0F1A CB 1B               RR    E              ;onto D0 and into
2724   0F1C CB 1C               RR    H              ;the smartwatch
2725   0F1E CB 1D               RR    L
2726   0F20 17                  RLA
2727   0F21 32 60 3F            LD    (SWATCH),A
2728   0F24 10 F2               DJNZ  WWACH5
2729   0F26 D9                  EXX                  ;restore registers
2730   0F27 06 20               LD    B,32           ;get the other 32 bits from
2731   0F29 CB 3A       WWACH6  SRL   D              ;the alternate register set
2732   0F2B CB 1B               RR    E              ;and shift them onto D0
2733   0F2D CB 1C               RR    H              ;and into the smartwatch
2734   0F2F CB 1D               RR    L
2735   0F31 17                  RLA
2736   0F32 32 60 3F            LD    (SWATCH),A
2737   0F35 10 F2               DJNZ  WWACH6
2738   0F37 E1                  POP HL
2739   0F38 D1                  POP DE
2740   0F39 C1                  POP BC
2741   0F3A F1                  POP AF
2742   0F3B C9                  RET
2743   0F3C             ;-----------------
2744   0F3C             ; ONE SECOND DELAY
2745   0F3C             ;-----------------
2746   0F3C             ; uses smartwatch to delay for 1 second
2747   0F3C             ; by waiting for seconds register to rollover
2748   0F3C             ;
2749   0F3C             ; first read gets a reference, subsequent reads
2750   0F3C             ; wait until the seconds counter no longer
2751   0F3C             ; reads the same as the reference value,
2752   0F3C             ; then the routine returns
2753   0F3C             ;
2754   0F3C             ; entry : none
2755   0F3C             ; exit : none modified
2756   0F3C             ;
2757   0F3C F5          ONESEC  PUSH  AF
2758   0F3D C5                  PUSH  BC
2759   0F3E CD 52 0E            CALL  RWATCH         ;read watch
2760   0F41 3A 1A 3F            LD    A,(SWREG1)
2761   0F44 47                  LD    B,A            ;save ref count
2762   0F45 CD 52 0E    ONESC1  CALL  RWATCH
2763   0F48 3A 1A 3F            LD    A,(SWREG1)
2764   0F4B B8                  CP    B              ;same as ref?
2765   0F4C CA 45 0F            JP    Z,ONESC1       ;yes, so wait again
2766   0F4F C1                  POP   BC
2767   0F50 F1                  POP   AF
2768   0F51 C9                  RET
