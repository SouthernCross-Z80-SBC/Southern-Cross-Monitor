2298   0C7E 23          SCOPE8  INC   HL
2299   0C7F 10 E1               DJNZ  SCOPE4         ;more rows to do
2300   0C81             ;
2301   0C81             ; display the pattern
2302   0C81             ;
2303   0C81 11 01 00            LD    DE,0001H       ;show the pattern
2304   0C84 21 00 02            LD    HL,0200H       ;for a period of time
2305   0C87 E5          SCOPE9  PUSH  HL
