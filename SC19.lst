0655   03E0 3A F7 03            LD    A,(TYPEBF)
0656   03E3 C9                  RET
0657   03E4             ;---------------
0658   03E4             ; VERSION NUMBER
0659   03E4             ;---------------
0660   03E4             ;returns the software version number
0661   03E4             ;
0662   03E4             ;   entry : none
0663   03E4             ; exit : hl -> version number string
0664   03E4             ;        acc = bcd version number d7-d4 = major, d3-d0 minor
0665   03E4             ;
0666   03E4 21 F8 03    VERS    LD    HL,VERSZ
0667   03E7 3A FC 03            LD    A,(VERBCD)
0668   03EA C9                  RET
0669   03EB             ;--------------
0670   03EB             ; KEYBOARD TYPE
0671   03EB             ;--------------
0672   03EB             ; returns the type of keyboard used
0673   03EB             ; entry = none
0674   03EB             ; exit: hl -> keyboard type string
0675   03EB             ;       acc = 01h mm74c923 hardware encoder
0676   03EB             ;       acc = 02h software scanned
0677   03EB             ;
0678   03EB 21 FD 03    KBDTYP  LD    HL,KYBSZ
0679   03EE 3A 06 04            LD    A,(KYBDBF)
0680   03F1 C9                  RET
0681   03F2             
0682   03F2 53 43 2D 31 TYPESZ  .DB   "SC-1",0
0682   03F6 00 
0683   03F7 01          TYPEBF  .DB   01H
0684   03F8             
0685   03F8 31 2E 39 00 VERSZ   .DB   "1.9",0
0686   03FC 19          VERBCD  .DB   19H
0687   03FD             
0688   03FD             #IFDEF 74C923
0689   03FD 48 61 72 64 KYBSZ   .DB   "Hardware",0
0689   0401 77 61 72 65 
0689   0405 00 
0690   0406 01          KYBDBF  .DB   01H 
