2158   0BD0 6F                  LD    L,A            ;return LSN in L
2159   0BD1 78                  LD    A,B
2160   0BD2 CB 3F               SRL   A
2161   0BD4 CB 3F               SRL   A
2162   0BD6 CB 3F               SRL   A              ;move MSN
2163   0BD8 CB 3F               SRL   A              ;into LSN
2164   0BDA 67                  LD    H,A            ;return MSN in H
2165   0BDB C1                  POP   BC
2166   0BDC F1                  POP   AF
2167   0BDD C9                  RET
