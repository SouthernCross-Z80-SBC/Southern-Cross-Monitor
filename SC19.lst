2720   0F16             ; write data to watch
2721   0F16             ;
2722   0F16 06 20       WWACH4  LD    B,32           ;shift the first 32 bits
2723   0F18 CB 3A       WWACH5  SRL   D              ;out of the 16 bit registers
2724   0F1A CB 1B               RR    E              ;onto D0 and into
2725   0F1C CB 1C               RR    H              ;the smartwatch
2726   0F1E CB 1D               RR    L
2727   0F20 17                  RLA
2728   0F21 32 60 3F            LD    (SWATCH),A
2729   0F24 10 F2               DJNZ  WWACH5
2730   0F26 D9                  EXX                  ;restore registers
2731   0F27 06 20               LD    B,32           ;get the other 32 bits from
2732   0F29 CB 3A       WWACH6  SRL   D              ;the alternate register set
2733   0F2B CB 1B               RR    E              ;and shift them onto D0
2734   0F2D CB 1C               RR    H              ;and into the smartwatch
2735   0F2F CB 1D               RR    L
2736   0F31 17                  RLA
2737   0F32 32 60 3F            LD    (SWATCH),A
2738   0F35 10 F2               DJNZ  WWACH6
2739   0F37 E1                  POP HL
2740   0F38 D1                  POP DE
2741   0F39 C1                  POP BC
2742   0F3A F1                  POP AF
