2497   0DB1 09                  ADD   HL,BC          ;and setting the
2498   0DB2 CB FE               SET   7,(HL)         ;decimal point
2499   0DB4 C9          UPDBF5  RET                  ;in that display
2500   0DB5             ;--------------
2501   0DB5             ; SET TIME/DATE
2502   0DB5             ;--------------
2503   0DB5 CD DF 05    SETCLK  CALL  BEEP
2504   0DB8 CD C4 04            CALL  KEYREL
2505   0DBB             ;
2506   0DBB             ; edit the display buffer
2507   0DBB             ;
